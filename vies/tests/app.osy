// The producer's test project for Osysharp.Shop.Vies — every call to VIES is stubbed.
app ViesKitTests {
  tests "**/*.test.osy";
  use Osysharp.Shop.Vies@0 { egress "ec.europa.eu"; }
  use Osysharp.Shop@0 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Seo@0;
  use Osysharp.Http;
}
