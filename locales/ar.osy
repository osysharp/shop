  /// __BlockSpec_ProductRow · text on the page
  text "Product row" => "صف منتجات";
  /// __BlockSpec_ProductRow · text on the page
  text "See them all" => "عرض الكل";

  // ── __BlockSpec_ShopMailOrderLines ──
  /// __BlockSpec_ShopMailOrderLines · text on the page
  text "The order" => "الطلب";
  /// __BlockSpec_ShopMailOrderLines · text on the page
  text "What was ordered, what it costs and how it was paid — every confirmation carries it." => "ما طُلب، وتكلفته، وطريقة دفعه: يظهر في كل تأكيد.";

  // ── __BlockSpec_SignUp ──
  /// __BlockSpec_SignUp · text on the page
