// The store: it wears the Kiosk look, and serves the bag page the look takes a customer to (`appPage "/bag"`).
using Osysharp.UserAccounts;
using Osysharp.Shop;
using Osysharp.Shop.Looks;
using Osysharp.Payments;
using Osysharp.Shipping;

app.Look = Kiosk;

// Who signs in — customers and staff — is Osysharp.UserAccounts', as the shop's own kind of account (`ShopAccounts`).
app.Accounts = ShopAccounts("Kiosk Look Tests");

app.Shop = new ShopSetup {
  Payments = [ new ManualPayment { Key = "banktransfer", Label = "Bank transfer", Instructions = "IBAN SE00" } ],
  Delivery = [ new CollectInStore { Address = "the workshop" } ],
};

/// Every page in the look's frame.
[Layout]
[AllowAnonymous]
component Store() {
  render { ShopFrame { Outlet; } }
}

[Route("/")]
[Layout(Store)]
[AllowAnonymous]
component Home() {
  render { Text("Magazines and papers"); }
}

/// The customer's account — the shop kit's panel, on the store's own page (Osysharp.UserAccounts' `/account`, taken over by its name).
[Route("/account")]
[Layout(Store)]
component AccountPage() {
  render { ShopAccountPanel(); }
}

/// The store's own bag page — the look sends a customer here, and the store decides what it is.
[Route("/bag")]
[Layout(Store)]
[AllowAnonymous]
component BagPage() {
  render { Text("Your bag — magazines and papers"); }
}
