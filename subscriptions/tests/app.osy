// The producer's test project for Osysharp.Shop.Subscriptions — a shop selling software plans.
app SubscriptionsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Shop.Subscriptions@0 { egress "hooks.example.test"; }
  use Osysharp.Shop@0 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Payments@0;
  use Osysharp.Delivery@0;
  use Osysharp.Seo@0;
  use Osysharp.Workflow;
  use Osysharp.Http;
  use Osysharp.Ui;
  use Osysharp.EmailTemplates@0;
}
