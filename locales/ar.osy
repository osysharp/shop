  text "{p.Status.Label} · {Money} · {Sum} in stock" => { zero: "{p.Status.Label} · {Money} · المتوفر: {Sum}", one: "{p.Status.Label} · {Money} · المتوفر: {Sum}", two: "{p.Status.Label} · {Money} · المتوفر: {Sum}", few: "{p.Status.Label} · {Money} · المتوفر: {Sum}", many: "{p.Status.Label} · {Money} · المتوفر: {Sum}", other: "{p.Status.Label} · {Money} · المتوفر: {Sum}" };
  /// DeskProducts · text on the page
  /// placeholders: {report.NewProducts} = report.NewProducts (int), {report.NewSizes} = report.NewSizes (int), {report.Changed} = report.Changed (int), {report.Unchanged} = report.Unchanged (int) — {report.NewProducts} is a count: give one text per plural form
  text "{report.NewProducts} new products · {report.NewSizes} new sizes · {report.Changed} changed · {report.Unchanged} unchanged" => { zero: "منتجات جديدة: {report.NewProducts} · مقاسات جديدة: {report.NewSizes} · معدّلة: {report.Changed} · دون تغيير: {report.Unchanged}", one: "منتجات جديدة: {report.NewProducts} · مقاسات جديدة: {report.NewSizes} · معدّلة: {report.Changed} · دون تغيير: {report.Unchanged}", two: "منتجات جديدة: {report.NewProducts} · مقاسات جديدة: {report.NewSizes} · معدّلة: {report.Changed} · دون تغيير: {report.Unchanged}", few: "منتجات جديدة: {report.NewProducts} · مقاسات جديدة: {report.NewSizes} · معدّلة: {report.Changed} · دون تغيير: {report.Unchanged}", many: "منتجات جديدة: {report.NewProducts} · مقاسات جديدة: {report.NewSizes} · معدّلة: {report.Changed} · دون تغيير: {report.Unchanged}", other: "منتجات جديدة: {report.NewProducts} · مقاسات جديدة: {report.NewSizes} · معدّلة: {report.Changed} · دون تغيير: {report.Unchanged}" };
