// The catalogue — categories in a tree, products in them, several photographs per product, and the variants a
// customer actually buys: a size, a colour, or both, each with its own stock.
//
// ⚑ A PRODUCT IS BOUGHT THROUGH A VARIANT, ALWAYS. A product with no options has exactly one variant (no size, no
//   colour). That keeps one road through the bag, the order and the stock, whatever the shop sells. A thrift shop is
//   the same catalogue with every variant's stock at 1.
//
// ⚑ WHAT IS PARTICULAR TO YOUR GOODS IS DATA: a product's `Specs` are its spec sheet — "Frame size: 56 cm",
//   "Material: 100% merino", "Era: 1970s" — so the desk adds a line without a developer and without a recompile.
//   A subtype of your own — `entity Bike : Product { … }` — adds the fields that are the same for every product
//   you sell, and may state its own `security { }`.
//
// ⚑ THE WORDS A CUSTOMER READS ARE [Translatable]: a shelf's name and blurb, a product's name, brand, summary and story, a
//   photograph's alt text, a spec line. Written in the app's source language; a translation per language sits beside
//   each (a `"language": "sv"` data file, the Translations desk, or a write made in that language), and every read,
//   search and sort in a language sees its words — code is written exactly as for any string. Slugs, SKUs, sizes and
//   colours are NOT: they are how the shop finds things, and a slug that changed with the language would be a link
//   that breaks when a Swedish reader shares it.

namespace Osysharp.Shop;

/// A shelf — "Women", "Women › Shoes", "Women › Shoes › Boots". `Parent` makes the tree; a top-level category has none.
public entity Category {
  [Required, MaxLength(80), Translatable] string Name;
  /// What the address says — `/shop/womens-shoes`. Unique across the whole tree.
  [Required, Unique, MaxLength(80)] string Slug;
  Category? Parent;
  [MaxLength(600), Translatable] string? Blurb;
  /// A picture for the shelf — a path in the app's public file store, like a product photo's.
  [MaxLength(300)] string? Picture;
  /// Where the shelf sits in Google's product taxonomy — its number ("187") or its path ("Apparel & Accessories >
  /// Shoes"). The product feeds send it as `google_product_category`; a shelf without one takes its parent's.
  [MaxLength(250)] string? GoogleCategory;
  int Rank = 0;
  [ForeignKey(Parent)] Category[] Children;
  [ForeignKey(Category)] Product[] Products;
  security {
    allow read when IsAnonymous || IsAuthenticated;
    allow create, update, delete when IsShopStaff;
  }
}

/// Where a product is in its life. A DRAFT is the desk's and nobody else's; ARCHIVED is off the shop floor but kept,
/// because orders name it.
public enum ProductStatus {
  [Label("Draft")] Draft,
  [Label("Listed")] Listed,
  [Label("Archived")] Archived,
}

/// A thing the shop sells. Customers buy one of its `Variants`; its `Images` are shown in `Rank` order, the first as
/// the cover.
/// Which VAT rate a product's price includes — the rates themselves are the shop's (`ShopSettings`).
// ⚠ Appended, never inserted: an enum is stored by position.
public enum VatClass {
  [Label("Standard rate")] Standard,
  [Label("Reduced rate")] Reduced,
  [Label("Lower rate")] Lower,
  [Label("No VAT")] Exempt,
}

public entity Product {
  [Required, MaxLength(120), Translatable] string Name;
  [Required, Unique, MaxLength(120)] string Slug;
  /// Who made it — or, for a shop that sells by origin, where it is from; [Translatable] for that shop's sake (a brand
  /// that reads the same in every language simply has no translation).
  [MaxLength(80), Translatable] string? Brand;
  /// For customs, when a parcel leaves the EU: the Harmonized System tariff number ("640399" — leather shoes), what
  /// customs calls the goods in plain words ("Leather shoes"), and where they were made (ISO 3166 alpha-2).
  [MaxLength(12)] string? HsCode;
  [MaxLength(80)] string? CustomsDescription;
  [MaxLength(2)] string? OriginCountry;
  /// The age a buyer must be — 18 for wine in most of Europe, 20 at Swedish retail. 0: anyone may buy it. The checkout
  /// asks for a date of birth when the bag holds anything with an age, and the parcel is handed over against ID.
  int MinimumAge = 0;
  Category? Category;
  /// One line for a card.
  [MaxLength(300), Translatable] string? Summary;
  /// The full story, for the product's own page.
  [MaxLength(4000), Translatable] string? Description;
  decimal Price;
  /// What it cost before — shown struck through when it is higher than `Price`.
  decimal? WasPrice;
  ProductStatus Status = ProductStatus.Listed;
  /// The VAT rate its price includes.
  VatClass Vat = VatClass.Standard;
  bool Featured = false;
  int Rank = 0;
  /// A GIFT CARD (GiftCards.osy): each variant is an amount — "250 kr", "500 kr" — or, with `AnyAmount`, the amount the
  /// buyer chooses. Paying for one issues a code; it carries no VAT and is not a sale of goods (a voucher).
  bool IsGiftCard = false;
  [ForeignKey(Product)] ProductImage[] Images;
  [ForeignKey(Product)] Variant[] Variants;
  [ForeignKey(Product)] ProductSpec[] Specs;

  // ⚠ What a page shows about a product — its cover, whether it is sold, reserved or available — is read off its
  //   loaded `Images` and `Variants` (`bike.Variants.All(v => v.Stock == 0)`), not off computed properties: a computed
  //   member over a child COLLECTION compiles and then cannot be read yet. The server-side
  //   answers are the functions at the foot of this file.

  security {
    // Anyone sees a listed or archived product; a draft is the desk's alone — staff by a rule of their own, so a
    // shopper's read never asks about staff and a staff member's never asks about the product's status.
    allow read when IsAnonymous || IsAuthenticated where Status != ProductStatus.Draft;
    allow read when IsShopStaff;
    allow create, update, delete when IsShopStaff;
  }
}

/// One photograph of a product. `Colour`, when set, ties it to the variants of that colour, so choosing "Black" can
/// show the black one.
///
/// ⚑ THE PHOTO IS A PATH in the app's public file store (`public/products/loafer-1.jpg`), shown with
///   `Image(src: File.Url(image.Path))`. One representation for both ways a photo arrives: `osy import` carries the
///   bytes of a data file's `"files": { "Path": "public/products" }` column, and a desk upload writes the file and
///   stores its path. A public path is what an `<img>` can fetch — it sends no sign-in.
public entity ProductImage {
  [Required] Product Product;
  [Required, MaxLength(300)] string Path;
  /// What the photograph shows — read aloud to anyone who cannot see it.
  [MaxLength(200), Translatable] string? Alt;
  [MaxLength(40)] string? Colour;
  int Rank = 0;
  security {
    allow read when IsAnonymous || IsAuthenticated;
    allow create, update, delete when IsShopStaff;
  }
}

/// One line of a product's spec sheet, shown in `Rank` order.
public entity ProductSpec {
  [Required] Product Product;
  [Required, MaxLength(60), Translatable] string Name;
  [Required, MaxLength(300), Translatable] string Value;
  int Rank = 0;
  security {
    allow read when IsAnonymous || IsAuthenticated;
    allow create, update, delete when IsShopStaff;
  }
}


/// What a customer actually buys: a product in one size and/or one colour, with its own stock.
///
/// ⚑ STOCK IS ONLY EVER TAKEN BY AN ORDER'S WORKFLOW (see Orders.osy), which writes as the system. A visitor cannot
///   write it, and `[ConcurrencyCheck]` makes two orders racing for the last one meet: one wins, the other is retried
///   and sees it gone.
public entity Variant {
  [Required] Product Product;
  [MaxLength(40)] string? Size;
  [MaxLength(40)] string? Colour;
  [MaxLength(60)] string? Sku;
  /// The barcode on the goods — a GTIN: an EAN-13 (most of Europe), a UPC-A (12), an EAN-8 or a GTIN-14. What a
  /// scanner reads at the counter and what Google Shopping matches a product on. Its last digit is a check digit, so
  /// a mistyped number is refused rather than stored.
  [MaxLength(14)] string? Barcode;
  /// What one unit costs the shop to buy in, without VAT — the figures' margin is the price without VAT, less this.
  /// The desk's alone: a customer never sees it.
  decimal? CostPrice;
  /// A service or a digital good — a plan, a licence: never out of stock, nothing held or counted.
  bool Unlimited = false;
  [ConcurrencyCheck] int Stock = 0;
  /// Units held by orders that are not paid yet — taken from `Stock`, and back in it if the order lapses. Written by
  /// the order's workflow alone, like `Stock`.
  int Reserved = 0;
  /// Overrides the product's price for this variant — a larger size that costs more.
  decimal? Price;
  /// Its own prices in the currencies the shop SELLS in (Currencies.osy) — the price list. Without one in a currency,
  /// its price is converted at the day's rate and rounded by that currency's rule.
  [ForeignKey(Variant)] VariantPrice[] Prices;
  int Rank = 0;
  /// Packed weight in grams — what a carrier or a weight-priced delivery (`ZoneRateDelivery`) prices a parcel by.
  int WeightGrams = 0;
  /// For a gift card: the buyer writes the amount (between the shop's `GiftCardMin` and `GiftCardMax`) instead of
  /// paying the variant's price.
  bool AnyAmount = false;
  /// A FILE the customer downloads once the order is paid — a PDF, an audio file, a zip (Downloads.osy). Nothing is
  /// packed, sent or counted: it is never out of stock. Set by `SetDownloadFile`, never by hand.
  bool IsDownload = false;
  /// Where the file is — uploaded PRIVATELY (`Upload(privately: true)`), outside public/, reachable only through a
  /// signed link made for a buyer. The desk's to read.
  [MaxLength(300)] string? DownloadPath;
  /// The file's name as the customer sees it — "brewing-guide.pdf".
  [MaxLength(160)] string? DownloadName;

  /// What this variant costs.
  decimal EffectivePrice => Price ?? Product.Price;
  // The SHAPE on every write; the check digit (`IsGtin`) where staff enter one — an invariant cannot call a function.
  invariant Barcode == null || Barcode.Length == 8 || Barcode.Length == 12 || Barcode.Length == 13 || Barcode.Length == 14
    message "A barcode is 8, 12, 13 or 14 digits (an EAN or UPC).";
  security {
    allow read when IsAnonymous || IsAuthenticated;
    allow create, update, delete when IsShopStaff;
    // SECURITY-INVARIANT(a-cost-is-the-desks-alone): every visitor reads a variant, so its cost must be masked — a
    // shop's buying prices are its most private numbers. Guarded by products-csv.test.osy
    // the_margin_is_net_of_vat_and_a_cost_is_the_desks_alone.
    deny read CostPrice when !IsShopStaff;
    // Where a file for sale is kept is the desk's — a buyer reaches it through the download made for their order.
    deny read DownloadPath when !IsShopStaff;
  }
}

/// What a line of the bag or an order is: goods that are packed and sent, a gift card, or a file to download.
// ⚠ Appended, never inserted: an enum is stored by position.
public enum LineKind {
  [Label("Goods")] Goods,
  [Label("Gift card")] GiftCard,
  [Label("Download")] Download,
}

/// What buying `variant` is — goods, a gift card, or a download.
public LineKind KindOf(Variant variant) {
  if (variant.Product.IsGiftCard) { return LineKind.GiftCard; }
  return variant.IsDownload ? LineKind.Download : LineKind.Goods;
}

/// Whether `code` is a GTIN — 8, 12, 13 or 14 digits whose last is the check digit (weights 3 and 1 alternating from
/// the right, over the others).
public bool IsGtin(string code) {
  var c = code.Trim();
  if (c.Length != 8 && c.Length != 12 && c.Length != 13 && c.Length != 14) { return false; }
  var sum = 0;
  for (var i = 0; i < c.Length - 1; i++) {
    var d = "0123456789".IndexOf(c.Substring(i, 1));
    if (d < 0) { return false; }
    // Counted from the right of the digits BEFORE the check digit: the nearest one weighs 3.
    sum = sum + d * ((c.Length - 1 - i) % 2 == 1 ? 3 : 1);
  }
  var check = "0123456789".IndexOf(c.Substring(c.Length - 1, 1));
  return check >= 0 && (10 - sum % 10) % 10 == check;
}

/// What this variant costs — `variant.EffectivePrice`, as a function for server code that prefers one.
public decimal PriceOf(Variant variant) {
  return variant.Price ?? variant.Product.Price;
}

/// The category and every category under it, three levels deep — what "Women" should list.
public bool IsUnder(Category? category, Category shelf) {
  if (category == null) { return false; }
  if (category == shelf) { return true; }
  if (category.Parent == null) { return false; }
  if (category.Parent == shelf) { return true; }
  return category.Parent.Parent != null && category.Parent.Parent == shelf;
}

/// The value of one line of a product's spec sheet — `Spec(bike.Specs, "Frame size")` — or "" when it has none. A spec
/// line is [Translatable], so in a language the app speaks the name is matched in THAT language ("Ramstorlek").
///
/// ⚑ THE READ HELPERS TAKE THE LOADED ROWS, NOT THE PRODUCT, so any page — the kit's, a look's or your app's — calls
///   them while it renders, and they run in the browser with no round trip: a function that only reads what it is
///   handed is sent to the browser with the page. Load the product with `.Include(p => p.Specs)` (and `Images`,
///   `Variants`) and hand those in. (An entity cannot carry a method yet — `bike.Spec("Year")` is the shape this wants
///   to become.)
public string Spec(ProductSpec[] specs, string name) {
  return specs.Where(s => s.Name == name).Select(s => s.Value).FirstOrDefault() ?? "";
}

/// "M", "Black", "Black / M" — or "" for a product with no options.
public string VariantLabel(Variant variant) {
  var size = variant.Size ?? "";
  var colour = variant.Colour ?? "";
  if (size != "" && colour != "") { return $"{colour} / {size}"; }
  return size != "" ? size : colour;
}

/// The cover photograph — the first by `Rank` — as a path in the file store, or "" when it has none.
public string CoverPhoto(ProductImage[] images) {
  return images.OrderBy(i => i.Rank).Select(i => i.Path).FirstOrDefault() ?? "";
}

/// Whether an unpaid order is holding some of this product — "reserved" rather than "sold"; it comes back if the
/// order lapses.
public bool OnHold(Variant[] variants) {
  return variants.Any(v => v.Reserved > 0);
}

/// Gone for good: nothing to buy and nothing merely reserved. A variant with no stock to run out of (a gift card, a
/// file — `Unlimited`) is never sold.
public bool Sold(Variant[] variants) {
  return variants.All(v => !v.Unlimited && v.Stock == 0 && v.Reserved == 0);
}

/// Nothing left to buy right now, though some may only be held by an unpaid order — what a shelf of many of each
/// ("Sold out") says, where `Sold` is a one-off piece gone for good. A gift card or a file never runs out.
public bool SoldOut(Variant[] variants) {
  return variants.All(v => !v.Unlimited && v.Stock == 0);
}

/// The lowest price among a product's variants — what a card says it starts at ("from 129 kr") — or `price`, the
/// product's own, when it has none. A variant with no price of its own costs the product's.
public decimal FromPrice(Variant[] variants, decimal price) {
  return variants.Count() == 0 ? price : variants.Min(v => v.Price ?? price);
}

/// The cover photograph of `product` among photographs read on their own — `ProductImage.Where(i => …)` for a bag or a
/// checkout, whose lines reach their product through two references — or "".
public string CoverPhotoFor(List<ProductImage> photos, Guid product) {
  return photos.Where(c => c.Product.Id == product).OrderBy(c => c.Rank).Select(c => c.Path).FirstOrDefault() ?? "";
}

/// One spec line of `product` among spec lines read on their own, or "" — `SpecFor(specs, line.ProductId, "Year")`.
public string SpecFor(List<ProductSpec> specs, Guid product, string name) {
  return specs.Where(s => s.Product.Id == product && s.Name == name).Select(s => s.Value).FirstOrDefault() ?? "";
}

/// How a list of products is ordered on the search and sale pages.
public enum ProductSort {
  [Label("Newest")] Newest,
  [Label("Price, low to high")] PriceLow,
  [Label("Price, high to low")] PriceHigh,
  [Label("Name")] Name,
}
