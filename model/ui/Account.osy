/// Put once on a product page: counts the page's opening for the desk's figures. Renders nothing.
[Composable]
[AllowAnonymous]
public component ShopProductView(Product product) {
  on mount { ViewedProduct(product); }
  render { }
}

/// Under a bag line: what changed since it went in — sold out, fewer left, a new price — or nothing.
[Composable]
[AllowAnonymous]
public component ShopLineNote(BagLine line) {
  string note = "";
  // Read when the bag is opened — the checkout checks again, so a change while it is open is still caught there.
  on mount { note = LineProblem(line); }
  render {
    if (note != "") { Text(note, fontSize: FontSize.Label, color: Colors.Danger, role: UiRole.Status); }
  }
}

/// The account's way in, for a store's header beside the bag (`slot actions { ShopAccountButton(); }`): a person
/// glyph that opens the account — or the sign-in, when nobody is signed in.
[Composable]
[AllowAnonymous]
public component ShopAccountButton() {
  var me = Session.CurrentUser;
  action Open() { Navigation.Go("/account"); }
  render {
    IconButton(me == null ? "Sign in" : "Your account", onPress: Open) { Icon(Icons.User); }
  }
}
