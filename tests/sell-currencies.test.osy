// Selling in another currency (D-SELLCURRENCY1). A shop in kronor that SELLS in euros — real prices from its price
// list or its own converted and rounded, an order placed, invoiced and charged in euros with the day's rate on it —
// while US dollars stay SHOWN (an estimate, charged in kronor). The rates come from `FakeRates` (model/rates.osy): one
// euro is 11.3205 kronor, so a krona is 0.08833532 euro.

using Osysharp.Http;
using Osysharp.Payments;
using Osysharp.Shop;
using Osysharp.Workflow;

/// The floor shop in kronor — 25 % VAT, 79 kr delivery, free from 1,000 kr — with the rates running and euros SOLD.
void KronorShopSellingEuros() {
  runas (Desk) {
    var shop = TheShop();
    shop.Currency = "SEK"; shop.CurrencySymbol = "kr"; shop.SymbolAfter = true;
    shop.DeliveryFee = 79m; shop.FreeDeliveryFrom = 1000m; shop.VatPercent = 25m;
    UnitOfWork.Commit();
    StartExchangeRates();
    Workflow.Settle(RateWatch.Single());
    SellInCurrency("EUR", true);
  }
}

/// A visit that chose euros, with `size` of the loafer in its bag.
void EuroBag(string visitId, string product, string size) {
  runas (new Visitor { Id = visitId }) {
    ShowPricesIn("EUR");
    Assert.Equal("", AddToBag(Pick(product, size), 1));
  }
}

/// Stripe's answer to a checkout session — what a test's `Http.Post` stub hands back.
HttpResponse CardSession() {
  return new HttpResponse { StatusCode = 200, Body = "{\"id\":\"cs_9\",\"url\":\"https://checkout.stripe.com/c/pay/cs_9\"}" };
}

/// Places a visit's euro bag as a collection paid by card on Stripe (which the test stubs), as Maja. Answers the receipt.
Receipt EuroOrderByCard(string visitId) {
  runas (new Visitor { Id = visitId }) {
    runas (Maja) {
      return PlaceOrder("Maja Berg", "maja@example.test", "", "collect", "stripe", "", "", "", "");
    }
  }
}

[Test(Floor)]
void a_converted_price_is_rounded_to_the_nearest_price_the_currency_rule_allows() {
  Assert.Equal(14.95m, NicePrice(15.20m, PriceRounding.To95));   // 14.95 is 0.25 away, 15.95 is 0.75
  Assert.Equal(15.95m, NicePrice(15.60m, PriceRounding.To95));
  Assert.Equal(15.90m, NicePrice(15.44m, PriceRounding.To90));
  Assert.Equal(16m, NicePrice(15.5m, PriceRounding.Whole));
  Assert.Equal(15m, NicePrice(17.4m, PriceRounding.ToFive));
  Assert.Equal(10m, NicePrice(14.9m, PriceRounding.ToTen));
  Assert.Equal(15.21m, NicePrice(15.205m, PriceRounding.Cents));
  Assert.Equal(0.95m, NicePrice(0.30m, PriceRounding.To95));      // never rounded away to nothing
  Assert.Equal(5m, NicePrice(1m, PriceRounding.ToFive));
}

[Test(Floor)]
void a_sold_currency_prices_from_the_price_list_else_converts_and_rounds() {
  KronorShopSellingEuros();
  runas (Desk) { SetVariantPrice(Pick("Loafer", "39"), "EUR", "12"); }
  runas (new Visitor { Id = "v-sell-list" }) {
    ShowPricesIn("EUR");
    Assert.Equal("", AddToBag(Pick("Loafer", "38"), 1));
    Assert.Equal("", AddToBag(Pick("Loafer", "39"), 1));
    var lines = BagFor(false)!.Lines.ToList();
    // 120 kr is €10.60 — made €10.95, the nearest price ending .95; the 39 has its own €12.
    Assert.Equal(10.95m, LinePrice(lines.Single(l => l.Variant.Size == "38")));
    Assert.Equal(12m, LinePrice(lines.Single(l => l.Variant.Size == "39")));
    var quote = CheckoutQuote("collect", "");
    Assert.Equal("EUR", quote.Currency);
    Assert.Equal(22.95m, quote.Total);
    Assert.Equal(4.59m, quote.Vat);                                 // 22.95 × 25/125, in euros
    Assert.Equal("", LineProblem(lines.First()));                   // the switch is not a price that moved
  }
  // A page reads the same price off the rows it loaded with the variant.
  var rate = ExchangeRate.Single(r => r.Currency == "EUR");
  Assert.Equal(12m, SoldPriceFrom(Pick("Loafer", "39").Prices.ToArray(), 120m, rate));
  Assert.Equal(10.95m, SoldPriceFrom(Pick("Loafer", "38").Prices.ToArray(), 120m, rate));
}

[Test(Floor)]
void an_order_in_a_sold_currency_is_placed_invoiced_and_charged_in_it_with_the_days_rate() {
  KronorShopSellingEuros();
  EuroBag("v-sell-order", "Loafer", "38");
  List<string> posted = [];
  Http.Post.Stub((url, body) => { posted.Add(body); return CardSession(); });
  var receipt = EuroOrderByCard("v-sell-order");
  Assert.Equal("EUR", receipt.Currency);
  Assert.Equal(10.95m, receipt.Total);
  // Stripe is asked for euros — €10.95 in cents — never kronor.
  Assert.Contains("eur", posted[0]);
  Assert.Contains("1095", posted[0]);
  Assert.DoesNotContain("sek", posted[0]);
  runas (Desk) {
    var order = Order.Single(o => o.Reference == receipt.Reference);
    Assert.Equal(OrderStatus.Reserved, order.Status);
    Assert.Equal("EUR", order.Currency);
    Assert.Equal(0.08833532m, order.Rate);
    Assert.Equal("Test Bank", order.RateSource);
    Assert.Equal(2.19m, order.Vat);                                 // 10.95 × 25/125
    MarkPaid(order, "");
    Workflow.Settle(order);
    var invoice = Invoice.Single(i => i.Order == order);
    Assert.Equal(10.95m, invoice.Total);
    Assert.Equal(0.08833532m, invoice.Rate);
    // The VAT stated in kronor too, at the invoice's rate (art. 230): 2.19 / 0.08833532 = 24.79.
    var lines = VatInShopCurrency(invoice, [25m], [2.19m]);
    Assert.Contains("1 EUR = 11.3205 SEK", lines[0]);
    Assert.Contains("article 230", lines[0]);
    Assert.Equal("VAT 25 % in SEK: 24.79 kr", lines[1]);
    Assert.Equal("€10.95", OrderMoney(order.Total, order));
    Assert.Equal(123.96m, InShopMoney(order.Total, order));         // the figures count it in kronor
    Assert.True(ReceiptPdf(order).Length > 0);
  }
}

