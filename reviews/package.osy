// Osysharp.Shop.Reviews — product reviews for Osysharp.Shop, as an add-on: written by customers who bought the
// product, moderated by staff, averaged on the product page and in its search-engine data. The shop finds it: an app's
// `use` line is all.
package Osysharp.Shop.Reviews {
  version     "0.5.1";
  minPlatform "0.9.0";
  summary     "product reviews for the shop — verified buyers only, moderated by staff, averaged for search engines.";
  model "model/**/*.osy";
  use Osysharp.Shop@1;
  // A shop's staff hold the shop's roles in Osysharp.Identity's grants.
  use Osysharp.Identity@0;
  use Osysharp.Seo@0;
  use Osysharp.Ui;
  use Osysharp.Workflow;
  tests "tests";
}
