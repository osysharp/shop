// The producer's test project for Osysharp.Shop.Looks.Atelier — a milliner's shop — hats blocked by hand, wearing the look.
//
// ⭐ IT READS THE WORKING TREE: the repository's `osy.workspace` lists `kits/*`, so `use Osysharp.Shop.Looks.Atelier`
//    resolves from the directory beside this one. ⛔ It does not ship — `tests` in ../package.osy is a setting, not a role.
app AtelierLookTests {
  model "model/**/*.osy";
  tests "*.test.osy";
  use Osysharp.Shop@1 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Identity@0;
  use Osysharp.Accounts@1;
  use Osysharp.Payments@0;
  use Osysharp.Delivery@0;
  use Osysharp.Seo@0;
  use Osysharp.Blocks;
  use Osysharp.Pages@0;
  use Osysharp.Site.Looks@0;
  use Osysharp.Shop.Looks.Atelier@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
  use Osysharp.Storage;
}
