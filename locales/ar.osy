  /// __BlockSpec_ProductRow · text on the page
  text "Leave it empty for the newest from every shelf." => "اتركه فارغًا لعرض الأحدث من كل الأقسام.";
  /// __BlockSpec_ProductRow · text on the page
  text "Link under it" => "الرابط أسفله";
  /// __BlockSpec_ProductRow · text on the page
