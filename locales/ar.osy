  /// placeholders: {v.Percent} = v.Percent (decimal), {OrderMoney} = OrderMoney(…) (string)
  /// shown through VatLines()
  text "Of which VAT ({v.Percent} %): {OrderMoney}" => "منها ضريبة القيمة المضافة ({v.Percent} %): {OrderMoney}";

  // ── VerifyEmailPage (/verify-email/{token}) ──
  /// VerifyEmailPage · /verify-email/{token} · a title
  /// shown through [Title]
  /// also in ShopConfirmAddress
  title "Confirm your address" => "أكّد عنوانك";

  // ── VoidGiftCard ──
  /// VoidGiftCard · an error message
  /// placeholders: {card.Status.Label} = card.Status.Label (string)
  /// shown through Exception
  error "That card is {card.Status.Label} already." => "حالة هذه البطاقة {card.Status.Label} بالفعل.";

  // ── WholesaleProblem ──
  /// WholesaleProblem · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {MoneyIn2} = MoneyIn(…) (string)
  /// shown through WholesaleProblem()
  text "An order on your price list is at least {MoneyIn}. Add {MoneyIn2} more." => "الحد الأدنى للطلب وفق قائمة أسعارك {MoneyIn}. أضف {MoneyIn2} أخرى.";
  /// WholesaleProblem · text on the page
  /// placeholders: {VariantName} = VariantName(…) (string), {min} = min (int), {have} = have (int) — {min} is a count: give one text per plural form
  /// shown through WholesaleProblem()
  text "{VariantName} is sold to you by {min} or more. Your bag has {have}." => { zero: "يُباع لك {VariantName} بحد أدنى {min} قطعة. وفي سلتك {have}.", one: "يُباع لك {VariantName} بحد أدنى {min} قطعة. وفي سلتك {have}.", two: "يُباع لك {VariantName} بحد أدنى {min} قطعة. وفي سلتك {have}.", few: "يُباع لك {VariantName} بحد أدنى {min} قطع. وفي سلتك {have}.", many: "يُباع لك {VariantName} بحد أدنى {min} قطعة. وفي سلتك {have}.", other: "يُباع لك {VariantName} بحد أدنى {min} قطعة. وفي سلتك {have}." };

  // ── WithdrawalText ──
  /// WithdrawalText · text on the page
  /// placeholders: {days} = days (int), {value} = … (string), {WithdrawalAddressee} = WithdrawalAddressee(…) (string), {value2} = … (string), {order.Reference} = order.Reference (string) — {days} is a count: give one text per plural form
  /// shown through WithdrawalText()
  text "\n\nYour right of withdrawal: you may cancel this purchase within {days} days of receiving the goods, without giving a reason — return it from your order's page, or tell us{value}\n\nWithdrawal form (fill in and send only if you want to withdraw):\n  To: {WithdrawalAddressee}{value2}\n  I hereby give notice that I withdraw from my contract of sale of the following goods: order {order.Reference}\n  Ordered on / received on:\n  Name:\n  Address:\n  Date:" => { zero: "\n\nحقك في الانسحاب: يمكنك إلغاء هذا الشراء خلال {days} يوم من استلام السلع، دون إبداء أي سبب، وذلك بإرجاعها من صفحة طلبك، أو بإبلاغنا{value}\n\nنموذج الانسحاب (املأه وأرسله فقط إذا أردت الانسحاب):\n  إلى: {WithdrawalAddressee}{value2}\n  أُعلمكم بموجبه بأنني أنسحب من عقد بيع السلع التالية: الطلب {order.Reference}\n  تاريخ الطلب / تاريخ الاستلام:\n  الاسم:\n  العنوان:\n  التاريخ:", one: "\n\nحقك في الانسحاب: يمكنك إلغاء هذا الشراء خلال {days} يوم من استلام السلع، دون إبداء أي سبب، وذلك بإرجاعها من صفحة طلبك، أو بإبلاغنا{value}\n\nنموذج الانسحاب (املأه وأرسله فقط إذا أردت الانسحاب):\n  إلى: {WithdrawalAddressee}{value2}\n  أُعلمكم بموجبه بأنني أنسحب من عقد بيع السلع التالية: الطلب {order.Reference}\n  تاريخ الطلب / تاريخ الاستلام:\n  الاسم:\n  العنوان:\n  التاريخ:", two: "\n\nحقك في الانسحاب: يمكنك إلغاء هذا الشراء خلال {days} يوم من استلام السلع، دون إبداء أي سبب، وذلك بإرجاعها من صفحة طلبك، أو بإبلاغنا{value}\n\nنموذج الانسحاب (املأه وأرسله فقط إذا أردت الانسحاب):\n  إلى: {WithdrawalAddressee}{value2}\n  أُعلمكم بموجبه بأنني أنسحب من عقد بيع السلع التالية: الطلب {order.Reference}\n  تاريخ الطلب / تاريخ الاستلام:\n  الاسم:\n  العنوان:\n  التاريخ:", few: "\n\nحقك في الانسحاب: يمكنك إلغاء هذا الشراء خلال {days} أيام من استلام السلع، دون إبداء أي سبب، وذلك بإرجاعها من صفحة طلبك، أو بإبلاغنا{value}\n\nنموذج الانسحاب (املأه وأرسله فقط إذا أردت الانسحاب):\n  إلى: {WithdrawalAddressee}{value2}\n  أُعلمكم بموجبه بأنني أنسحب من عقد بيع السلع التالية: الطلب {order.Reference}\n  تاريخ الطلب / تاريخ الاستلام:\n  الاسم:\n  العنوان:\n  التاريخ:", many: "\n\nحقك في الانسحاب: يمكنك إلغاء هذا الشراء خلال {days} يومًا من استلام السلع، دون إبداء أي سبب، وذلك بإرجاعها من صفحة طلبك، أو بإبلاغنا{value}\n\nنموذج الانسحاب (املأه وأرسله فقط إذا أردت الانسحاب):\n  إلى: {WithdrawalAddressee}{value2}\n  أُعلمكم بموجبه بأنني أنسحب من عقد بيع السلع التالية: الطلب {order.Reference}\n  تاريخ الطلب / تاريخ الاستلام:\n  الاسم:\n  العنوان:\n  التاريخ:", other: "\n\nحقك في الانسحاب: يمكنك إلغاء هذا الشراء خلال {days} يوم من استلام السلع، دون إبداء أي سبب، وذلك بإرجاعها من صفحة طلبك، أو بإبلاغنا{value}\n\nنموذج الانسحاب (املأه وأرسله فقط إذا أردت الانسحاب):\n  إلى: {WithdrawalAddressee}{value2}\n  أُعلمكم بموجبه بأنني أنسحب من عقد بيع السلع التالية: الطلب {order.Reference}\n  تاريخ الطلب / تاريخ الاستلام:\n  الاسم:\n  العنوان:\n  التاريخ:" };
  /// WithdrawalText · text on the page
  /// placeholders: {shop.ContactEmail} = shop.ContactEmail (string)
  /// shown through WithdrawalText()
  text " at {shop.ContactEmail}." => " على {shop.ContactEmail}.";

