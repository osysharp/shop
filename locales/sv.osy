  /// shown through EmailText.text
  /// beside: "The link pays this order only, and stops working once it is paid or called off."
  text "Here is the order we put together for you. It is reserved for {order.HoldDays} days — pay it with the button below." => { one: "Här är ordern vi har satt ihop åt dig. Den är reserverad i {order.HoldDays} dag. Betala den med knappen nedan.", other: "Här är ordern vi har satt ihop åt dig. Den är reserverad i {order.HoldDays} dagar. Betala den med knappen nedan." };
