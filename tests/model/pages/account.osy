// The account pages a store writes around the kit's components — here as bare as a page can be, so the tests drive
// the components and nothing else.
using Osysharp.Shop;
using Osysharp.Ui;

[Route("/")] [AllowAnonymous] component KitHome() { render { Text("Kit test shop"); } }
// The Accounts kit's addresses, taken over by name — what its mail links to, and where a visitor is sent to sign in.
[Route("/login")] [AllowAnonymous] component SignInPage() { render { ShopSignIn(); } }
[Route("/sign-up")] [AllowAnonymous] component SignUpPage() { render { ShopSignUp(); } }
[Route("/forgot-password")] [AllowAnonymous] component ForgotPasswordPage() { render { ShopForgotPassword(); } }
[Route("/reset-password/{token}")] [AllowAnonymous] component ResetPasswordPage(string token) { render { ShopChooseNewPassword(token); } }
[Route("/verify-email/{token}")] [AllowAnonymous] component VerifyEmailPage(string token) { render { ShopConfirmAddress(token); } }
[Route("/account")] component AccountPage() { render { ShopAccountPanel(); } }
[Route("/desk")] component KitDesk() { render { ShopDesk(); } }
/// What this store offers before a free gift card — added to the shop's slot, as an add-on kit adds its own.
component CodesInstead() : GiftCardGoodwill {
  render { Link(href: "/codes", label: "Discount codes") { Text("Make a discount code"); } }
}
[Route("/counter")] [Authorize(IsShopCounter)] component KitCounter() { render { ShopCounter(); } }
[Route("/pay/{pay}")] [AllowAnonymous] component KitPay(Pay pay) { render { ShopPayByLink(pay); } }
[Route("/bag/back/{link}")] [AllowAnonymous] component KitResumeBag(ResumeBag link) { render { ShopResumeBag(link); } }
[Route("/download/{link}")] [AllowAnonymous] component KitDownload(DownloadLink link) { render { ShopDownload(link); } }
[Route("/gift-card")] [AllowAnonymous] component KitGiftCard() { render { ShopGiftCardBalance(); } }
// The bag page a store has — here only what the visit's bag holds, so a test can see what arrived in it.
[Route("/bag")] [AllowAnonymous] component KitBag() {
  string visitId = Visitor.Id;
  live var bag = Bag.Include(b => b.Lines.Variant.Product).SingleOrDefault(b => b.VisitId == visitId);
  render {
    Stack(gap: 2) {
      Text("The bag");
      if (bag != null) {
        foreach (var l in bag.Lines) {
          Text($"In the bag: {l.Variant.Product.Name} ({l.Variant.Size}) × {l.Quantity} at €{l.PriceWhenAdded:0}");
        }
      }
    }
  }
}
// The checkout's small parts a store places in its own checkout — here alone, for this browser's own visit (a test
// makes the browser the visit it means with `runas (new Visitor { Id = … })`).
[Route("/checkout-parts")] [AllowAnonymous] component KitCheckoutParts() {
  render {
    Stack(gap: 4) {
      CheckoutTerms();
      CheckoutStoreCredit(() => { });
      CheckoutGiftCard(() => { });
      CheckoutDigitalConsent();
    }
  }
}
[Route("/search")] [AllowAnonymous] component KitSearch() { render { ShopSearchPage(); } }
[Route("/sale")] [AllowAnonymous] component KitSale() { render { ShopSearchPage(onlySale: true); } }
[Route("/returns-policy")] [AllowAnonymous] component KitReturns() { render { ShopPolicy("returns"); } }
