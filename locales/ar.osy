  // ── ShopDownload ──
  /// ShopDownload · a control's name for screen readers
  accessibleName "Your download" => "تنزيلك";
  /// ShopDownload · a button's label · at most ~28 characters
  /// placeholders: {view.File} = view.File (string)
  /// shown through Button.label
  button "Download {view.File}" => "تنزيل {view.File}";
  /// ShopDownload · text on the page
  /// placeholders: {view.Left} = view.Left (int), {value} = … (string), {view.Until} = view.Until (string) — {view.Left} is a count: give one text per plural form
  text "It opens {view.Left} more {value}, until {view.Until}." => { zero: "يمكن فتحه {view.Left} {value} أخرى، حتى {view.Until}.", one: "يمكن فتحه {view.Left} {value} أخرى، حتى {view.Until}.", two: "يمكن فتحه {view.Left} {value} أخرى، حتى {view.Until}.", few: "يمكن فتحه {view.Left} {value} أخرى، حتى {view.Until}.", many: "يمكن فتحه {view.Left} {value} أخرى، حتى {view.Until}.", other: "يمكن فتحه {view.Left} {value} أخرى، حتى {view.Until}." };
  /// ShopDownload · text on the page
  text "time" => "مرة";
  /// ShopDownload · text on the page
  text "times" => "مرات";
  /// ShopDownload · text on the page
  /// placeholders: {view.File} = view.File (string), {view.OrderReference} = view.OrderReference (string)
  text "{view.File} · order {view.OrderReference}" => "{view.File} · الطلب {view.OrderReference}";

  // ── ShopDownloadsMail ──
  /// ShopDownloadsMail · a button's label · at most ~24 characters
  /// placeholders: {l.File} = l.File (string)
  /// shown through EmailButton.label
  button "Download {l.File}" => "تنزيل {l.File}";
  /// ShopDownloadsMail · a button's label · at most ~20 characters
  /// shown through ShopOrderButton.label
  /// beside: "Your downloads are ready"
  /// also in ShopOrderMessage
  /// also in ShopOrderConfirmation
  /// also in ShopShipped
  button "See your order" => "عرض طلبك";
  /// ShopDownloadsMail · the preview line an inbox shows beside an email's subject
  /// placeholders: {order.Reference} = order.Reference (string)
  /// shown through ShopMailLayout.preview
  mailPreview "Your downloads from order {order.Reference} are ready" => "تنزيلات طلبك {order.Reference} جاهزة";
  /// ShopDownloadsMail · an email's subject line
  /// placeholders: {order.Reference} = order.Reference (string), {Name} = ….Name (string)
  mailSubject "Your downloads — order {order.Reference} — {Name}" => "تنزيلاتك: الطلب {order.Reference}، {Name}";
  /// ShopDownloadsMail · text on the page
  /// placeholders: {shop.DownloadLimit} = shop.DownloadLimit (int), {shop.DownloadDays} = shop.DownloadDays (int) — {shop.DownloadLimit} is a count: give one text per plural form
  /// shown through EmailNote.text
  /// beside: "Your downloads are ready", "See your order"
  text "Each link works {shop.DownloadLimit} times, for {shop.DownloadDays} days. Signed in, you find them under your account too." => { zero: "يعمل كل رابط {shop.DownloadLimit} مرة، لمدة {shop.DownloadDays} يومًا. وعند تسجيل الدخول تجدها أيضًا في حسابك.", one: "يعمل كل رابط {shop.DownloadLimit} مرة، لمدة {shop.DownloadDays} يومًا. وعند تسجيل الدخول تجدها أيضًا في حسابك.", two: "يعمل كل رابط {shop.DownloadLimit} مرة، لمدة {shop.DownloadDays} يومًا. وعند تسجيل الدخول تجدها أيضًا في حسابك.", few: "يعمل كل رابط {shop.DownloadLimit} مرات، لمدة {shop.DownloadDays} يومًا. وعند تسجيل الدخول تجدها أيضًا في حسابك.", many: "يعمل كل رابط {shop.DownloadLimit} مرة، لمدة {shop.DownloadDays} يومًا. وعند تسجيل الدخول تجدها أيضًا في حسابك.", other: "يعمل كل رابط {shop.DownloadLimit} مرة، لمدة {shop.DownloadDays} يومًا. وعند تسجيل الدخول تجدها أيضًا في حسابك." };
  /// ShopDownloadsMail · text on the page
  /// placeholders: {order.Reference} = order.Reference (string)
  /// shown through EmailText.text
  /// beside: "Your downloads are ready", "See your order"
  text "Thank you — order {order.Reference} is paid. Here is what you bought to download." => "شكرًا لك، تم دفع الطلب {order.Reference}. إليك ما اشتريته للتنزيل.";
  /// ShopDownloadsMail · text on the page
  /// placeholders: {DigitalConsentWords} = DigitalConsentWords(…) (string), {ToString} = order.DigitalConsentAt.Value.ToString(…) (DateTime)
  /// shown through EmailNote.text
  text "You asked to have them at once: “{DigitalConsentWords}” ({ToString} UTC)." => "طلبت استلامها فورًا: “{DigitalConsentWords}” ({ToString} UTC).";
  /// ShopDownloadsMail · text on the page
  /// shown through EmailHeading.text
  /// beside: "See your order"
  text "Your downloads are ready" => "تنزيلاتك جاهزة";

  // ── ShopFooterLink ──
