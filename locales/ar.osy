  label "Total" => "الإجمالي";
  /// ShopPayLinkMail · a label (a field, a list item, a menu entry) · at most ~26 characters
  /// shown through EmailRow.label
  label "What you sent back" => "ما أرجعته";
  /// ShopPayLinkMail · the preview line an inbox shows beside an email's subject
  /// placeholders: {OrderMoney} = OrderMoney(…) (string), {order.Reference} = order.Reference (string)
  /// shown through ShopMailLayout.preview
  mailPreview "Pay {OrderMoney} for order {order.Reference}" => "ادفع {OrderMoney} للطلب {order.Reference}";
  /// ShopPayLinkMail · an email's subject line
  /// placeholders: {order.Reference} = order.Reference (string), {Name} = ….Name (string)
  mailSubject "Your order {order.Reference} — ready to pay — {Name}" => "طلبك {order.Reference} جاهز للدفع، {Name}";
  /// ShopPayLinkMail · text on the page
  /// placeholders: {order.HoldDays} = order.HoldDays (int) — {order.HoldDays} is a count: give one text per plural form
  /// shown through EmailText.text
  /// beside: "The link pays this order only, and stops working once it is paid or called off."
  text "Here is the order we put together for you. It is reserved for {order.HoldDays} days — pay it with the button below." => { zero: "إليك الطلب الذي جهّزناه لك. وهو محجوز لمدة {order.HoldDays} يوم، فادفعه عبر الزر أدناه.", one: "إليك الطلب الذي جهّزناه لك. وهو محجوز لمدة {order.HoldDays} يوم، فادفعه عبر الزر أدناه.", two: "إليك الطلب الذي جهّزناه لك. وهو محجوز لمدة {order.HoldDays} يوم، فادفعه عبر الزر أدناه.", few: "إليك الطلب الذي جهّزناه لك. وهو محجوز لمدة {order.HoldDays} أيام، فادفعه عبر الزر أدناه.", many: "إليك الطلب الذي جهّزناه لك. وهو محجوز لمدة {order.HoldDays} يومًا، فادفعه عبر الزر أدناه.", other: "إليك الطلب الذي جهّزناه لك. وهو محجوز لمدة {order.HoldDays} يوم، فادفعه عبر الزر أدناه." };
  /// ShopPayLinkMail · text on the page
  /// shown through EmailNote.text
  text "The link pays this order only, and stops working once it is paid or called off." => "يدفع الرابط هذا الطلب فقط، ويتوقف عن العمل بعد دفعه أو إلغائه.";
  /// ShopPayLinkMail · text on the page
  /// placeholders: {order.ExchangeFor.Reference} = order.ExchangeFor.Reference (string)
  /// shown through EmailText.text
  /// beside: "The link pays this order only, and stops working once it is paid or called off."
  text "What you sent back from order {order.ExchangeFor.Reference} is in. What you chose instead costs more — pay the difference with the button below and it goes out to you." => "وصل ما أرجعته من الطلب {order.ExchangeFor.Reference}. وما اخترته بدلًا منه أغلى ثمنًا، فادفع الفرق عبر الزر أدناه وسيُرسل إليك.";
  /// ShopPayLinkMail · text on the page
  /// shown through EmailHeading.text
  /// beside: "The link pays this order only, and stops working once it is paid or called off."
  text "Your order is ready to pay" => "طلبك جاهز للدفع";
