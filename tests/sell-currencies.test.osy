}

/// Maja writes the order for her euro bag (one Loafer 38, €10.95, collected, by card) straight to the tables, with
/// every row right but the currency and the rate it names. Answers its status once the order's workflow has priced it.
OrderStatus ForgedEuroOrder(string visitId, string reference, string? currency, decimal rate) {
  EuroBag(visitId, "Loafer", "38");
  var sale = ExchangeRate.Single(r => r.Currency == "EUR");
  var status = OrderStatus.Placed;
  runas (new Visitor { Id = visitId }) {
    var collect = DeliveryChoices("").Single(d => d.Id == "collect");
    // …placed from her own visit, as the checkout records it (D-ORDERLINK1) — which is also what lets her read it back.
    var order = new Order { VisitId = visitId, Fulfilment = Fulfilment.Collect, DeliveryMethod = "collect", DeliveryLabel = collect.Label,
                            PaymentMethod = "stripe", PaymentLabel = "Card", Currency = currency, Rate = rate,
                            RateDate = sale.RateDate, RateSource = sale.Source,
                            Subtotal = 10.95m, Total = 10.95m, Vat = 2.19m, HoldDays = 3,
                            PlacedAt = DateTime.UtcNow, Reference = reference, PlacedFrom = BagFor(false),
                            // The visit that writes it, as the checkout records it — an order is read by its own visit
                            // (D-GUESTROWS1, D-ORDERLINK1), so without it the status below reads as nothing at all.
                            VisitId = Visitor.Id };
    new OrderLine { Order = order, Variant = Pick("Loafer", "38"), ProductName = "Loafer", VariantLabel = "38", Quantity = 1,
                    Price = 10.95m, VatPercent = 25m };
    new OrderVat { Order = order, Percent = 25m, Gross = 10.95m, Vat = 2.19m, Country = "SE" };
    new OrderContact { Order = order, Name = "Maja Berg", Email = "maja@example.test" };
    UnitOfWork.Commit();
    status = order.Status;
  }
  return status;
}

// SECURITY-INVARIANT(an-order-is-priced-by-the-shop), for the currency: the checkout writes an order's rows as the
// customer, so its currency and its rate are claims too — one that says "the shop's own" for a bag bought in euros
// would be charged the euro figures in kronor, and one with a rate of its own would be booked at it.
[Test(Floor)]
void a_customer_cannot_state_their_own_currency_or_rate() {
  KronorShopSellingEuros();
  // The euro figures, said to be kronor — and euros at a rate of the customer's own: neither is held.
  Assert.Equal(OrderStatus.Unavailable, ForgedEuroOrder("v-sell-forge-1", "KT-FX1", null, 1m));
  Assert.Equal(OrderStatus.Unavailable, ForgedEuroOrder("v-sell-forge-2", "KT-FX2", "EUR", 1m));
  runas (Desk) { Assert.Equal(2, Pick("Loafer", "38").Stock); }
  // The same rows with the shop's own currency and rate are an order like any other.
  Assert.Equal(OrderStatus.Reserved, ForgedEuroOrder("v-sell-forge-3", "KT-FX3", "EUR", 0.08833532m));
}

// Only an EXPLICIT stop is the shop no longer selling in a currency (owner, 2026-09-29): "Only show it", or the rates
// stopped altogether. A rate gone stale sells nothing while it is stale, and is not the shop deciding anything — an
// add-on holding something agreed in the currency (a subscription) hears nothing of it. Heard while the rate still
// stands, so there is a rate to convert at.
[Test(Floor)]
void an_add_on_hears_when_the_shop_stops_selling_a_currency_and_not_when_its_rate_goes_stale() {
  KronorShopSellingEuros();
  TestClock.Advance(TimeSpan.FromDays(7));
  runas (Desk) { Assert.False(RateUsable(ExchangeRate.Single(r => r.Currency == "EUR"))); }
  Assert.Equal(0, AddOnHeard.Count(h => h.What.StartsWith("not sold")));
  runas (Desk) {
    SellInCurrency("EUR", false);
    SellInCurrency("EUR", false);                                                // already only shown: heard once
  }
  Assert.Equal(["not sold EUR at 0.0883"], AddOnHeard.Where(h => h.What.StartsWith("not sold")).Select(h => h.What).ToList());
  // Sold again, then every rate stopped: heard again — before the rate goes.
  runas (Desk) {
    FetchExchangeRatesNow();
    SellInCurrency("EUR", true);
    StopExchangeRates();
  }
  Assert.Equal(2, AddOnHeard.Count(h => h.What == "not sold EUR at 0.0883"));
  Assert.Equal(0, AddOnHeard.Count(h => h.What.StartsWith("not sold USD")));    // only shown, never sold
}

// ── a gift card in a currency the shop no longer sells (owner, 2026-09-29: "yes to all the open questions") ────────

/// A €40 card from Maja for Anna, bought in euros by card and paid — answers the code mailed to Anna. The caller stubs
/// the card provider (`CardSession`).
string EuroCardForAnna(string visitId) {
  var reference = "";
  runas (new Visitor { Id = visitId }) {
    ShowPricesIn("EUR");
    Assert.Equal("", AddGiftCardToBag(CardOf("Your amount"), 40m, "Maja", "Anna", "anna@example.test", "Happy birthday", null));
    runas (Maja) {
      reference = PlaceOrder("Maja Berg", "maja@example.test", "", NothingToShipId(), "stripe", "", "", "", "SE").Reference;
    }
  }
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    MarkPaid(order, "");
    Workflow.Settle(order);
    Workflow.Settle(GiftCard.Single(c => c.SoldWith == order));
  }
  return CodeMailedTo("anna@example.test");
}

// The card is reissued at the rate it was SOLD at (`GiftCard.Rate`), never the day's: that is the rate its debt is
// booked at, so the move earns and costs the shop nothing, and the holder gets exactly what the buyer paid for.
[Test(Floor)]
void a_card_in_a_currency_no_longer_sold_is_reissued_in_the_shops_own_at_the_rate_it_was_sold_at() {
  KronorShopSellingEuros();
  GiftShelf();
  Http.Post.Stub((url, body) => CardSession());
  var code = EuroCardForAnna("v-reissue");
  runas (Desk) {
    var card = GiftCard.Single();
    Assert.Equal(0.08833532m, card.Rate);
    // Still sold in euros: nothing to reissue — it pays for an order in euros as it is.
    Assert.Contains("still sells in EUR", Assert.Throws<Exception>(() => ReissueGiftCard(card, "")).Message);
    Assert.False(DeskGiftCardRows("").Single().CanReissue);
    SellInCurrency("EUR", false);
    var row = DeskGiftCardRows("").Single();
    Assert.True(row.CanReissue);
    Assert.Equal(452.82m, row.InShopMoney);                                      // €40 / 0.08833532
    var again = ReissueGiftCard(card, "");
    Workflow.Settle(card);
    Workflow.Settle(again);
    Assert.Equal(GiftCardStatus.Voided, card.Status);
    Assert.Equal(0m, card.Balance);
    Assert.Null(again.Currency);
    Assert.Equal(452.82m, again.Amount);
    Assert.Equal(452.82m, again.Balance);
    Assert.Equal(1m, again.Rate);
    Assert.False(again.SinglePurpose);
    Assert.Equal(card.ExpiresAt, again.ExpiresAt);                               // its last day, not a new one
    Assert.Equal("anna@example.test", again.SendTo);
    // The ledger shows both sides, each naming the other — a move, not a void written off.
    var off = GiftCardLedger(card).First();
    Assert.Equal("Reissued", off.What);
    Assert.Equal(-40m, off.Amount);
    Assert.Contains($"as …{again.Last4}", off.Note);
    Assert.False(GiftCardLedger(card).Any(l => l.What == "Voided"));
    var on = GiftCardLedger(again).Single();
    Assert.Equal("Reissued", on.What);
    Assert.Equal(452.82m, on.Amount);
    Assert.Contains($"from …{card.Last4}", on.Note);
    Assert.Contains("1 EUR = 11.3205 SEK", on.Note);
    var rows = DeskGiftCardRows("");
    Assert.Equal($"Reissued in SEK as …{again.Last4}", rows.Single(r => r.Ending == card.Last4).Reissue);
    Assert.Equal($"Reissued from …{card.Last4} (EUR)", rows.Single(r => r.Ending == again.Last4).Source);
    Assert.Contains("SEK already", Assert.Throws<Exception>(() => ReissueGiftCard(again, "")).Message);
    var mail = ShopMail.Single(m => m.To == "anna@example.test" && m.Text.Contains("We no longer sell in EUR"));
    Assert.Contains("452.82 kr", mail.Text);
    Assert.Contains("1 EUR = 11.3205 SEK", mail.Text);
    Assert.Contains("The old code no longer works", mail.Text);
  }
  // The old code pays nothing; the new one, mailed to Anna, pays for an order in kronor.
  Assert.NotEqual("", GiftCardBalance(code).Problem);
  var fresh = CodeMailedTo("anna@example.test");
  Assert.NotEqual(code, fresh);
  Bag("v-reissue-sek", "Loafer", "38", 1);
  runas (new Visitor { Id = "v-reissue-sek" }) {
    Assert.Equal($"Gift card ending {fresh.Substring(15, 4)}, 452.82 kr to spend", ApplyGiftCard(fresh));
  }
}

[Test(Floor)]
void a_single_purpose_card_reissued_stays_single_purpose_with_the_vat_its_sale_paid() {
  KronorShopSellingEuros();
  GiftShelf();
  runas (Desk) {
    TheShop().GiftCardsAreSinglePurpose = true;
    UnitOfWork.Commit();
  }
  Http.Post.Stub((url, body) => CardSession());
  EuroCardForAnna("v-reissue-spv");
  runas (Desk) {
    var card = GiftCard.Single();
    Assert.True(card.SinglePurpose);
    // Staff do not get to change what a card was sold as — turning the setting off changes nothing for it.
    TheShop().GiftCardsAreSinglePurpose = false;
    UnitOfWork.Commit();
    SellInCurrency("EUR", false);
    var again = ReissueGiftCard(card, "The shop no longer sells in euros");
    Assert.True(again.SinglePurpose);
    Assert.Equal(25m, again.VatPercent);
    Assert.Equal(card.VatPercent, again.VatPercent);
  }
}
