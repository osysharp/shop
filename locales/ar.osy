  error "A location needs a name." => "يحتاج الموقع إلى اسم.";
  /// AddLocation · an error message
  /// shown through Exception
  error "Give it a short code — letters and digits." => "أعطه رمزًا قصيرًا من حروف وأرقام.";
  /// AddLocation · an error message
  /// placeholders: {c} = c (string)
  /// shown through Exception
  error "There is already a location called {c}." => "يوجد بالفعل موقع باسم {c}.";

  // ── AddToCounterSale ──
  /// AddToCounterSale · an error message
  /// shown through Exception
  /// also in AddToDeskOrder
  error "Add one or more." => "أضف واحدًا أو أكثر.";
  /// AddToCounterSale · an error message
  /// placeholders: {have} = have (int), {VariantName} = VariantName(…) (string) — {have} is a count: give one text per plural form
  /// shown through Exception
  error "There are only {have} of {VariantName} here." => { zero: "لا يوجد هنا من {VariantName} إلا {have} قطعة.", one: "لا يوجد هنا من {VariantName} إلا {have} قطعة.", two: "لا يوجد هنا من {VariantName} إلا {have} قطعة.", few: "لا يوجد هنا من {VariantName} إلا {have} قطع.", many: "لا يوجد هنا من {VariantName} إلا {have} قطعة.", other: "لا يوجد هنا من {VariantName} إلا {have} قطعة." };
  /// AddToCounterSale · an error message
