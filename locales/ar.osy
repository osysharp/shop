  // ── PackingSlipPdf ──
  /// PackingSlipPdf · a title
  /// placeholders: {order.Reference} = order.Reference (string), {shop.Name} = shop.Name (string)
  /// shown through PdfDocument.Title
  title "Packing slip {order.Reference} — {shop.Name}" => "قائمة التعبئة {order.Reference}، {shop.Name}";

  // ── PayByLink ──
  /// PayByLink · an error message
  /// placeholders: {order.Reference} = order.Reference (string)
  /// shown through Exception
  error "Order {order.Reference} is paid already — thank you." => "الطلب {order.Reference} مدفوع بالفعل، شكرًا لك.";
  /// PayByLink · an error message
  /// placeholders: {order.Reference} = order.Reference (string), {StatusText} = StatusText(…) (string)
  /// shown through Exception
  error "Order {order.Reference} is {StatusText} and can no longer be paid." => "حالة الطلب {order.Reference} هي {StatusText}، ولم يعد من الممكن دفعه.";
  /// PayByLink · an error message
  /// shown through Exception
  error "Pay as the shop told you." => "ادفع كما أخبرك المتجر.";
  /// PayByLink · an error message
  /// shown through Exception
  error "This shop no longer takes that payment — ask the shop." => "لم يعد هذا المتجر يقبل طريقة الدفع هذه. تواصل مع المتجر.";
  /// PayByLink · an error message
  /// placeholders: {provider.Label} = provider.Label (string)
  /// shown through Exception
  error "{provider.Label} could not be reached just now — try again in a moment." => "تعذّر الوصول إلى {provider.Label} الآن. حاول مجددًا بعد قليل.";

  // ── PaymentRequestFor ──
  /// PaymentRequestFor · a description
  /// placeholders: {shop.Name} = shop.Name (string), {order.Reference} = order.Reference (string)
  /// shown through PaymentRequest.Description
  /// also in PlaceBag
  /// also in ChargeSavedMethod
  description "{shop.Name} — order {order.Reference}" => "{shop.Name}، الطلب {order.Reference}";

  // ── PickupPointsFor ──
  /// PickupPointsFor · an error message
  /// placeholders: {provider.Name} = provider.Name (string)
  /// shown through Exception
  error "{provider.Name} could not be reached for its points just now — try again in a moment." => "تعذّر الوصول إلى {provider.Name} لجلب نقاطه الآن. حاول مجددًا بعد قليل.";

  // ── PlaceBag ──
  /// PlaceBag · an error message
  /// placeholders: {order.Problem} = order.Problem (string)
  /// shown through Exception
  error "Something in your bag went a moment before you: {order.Problem}. Your bag now holds what is left." => "نفد منتج في سلتك قبلك بلحظات: {order.Problem}. تحتوي سلتك الآن على ما تبقّى.";
  /// PlaceBag · an error message
  /// shown through Exception
  error "There is no gift card or store credit to pay with. Choose another way to pay." => "لا توجد بطاقة هدية أو رصيد في المتجر للدفع به. اختر طريقة دفع أخرى.";
  /// PlaceBag · an error message
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {MoneyIn2} = MoneyIn(…) (string)
  /// shown through Exception
  error "Your gift card and store credit cover {MoneyIn} of {MoneyIn2} . Choose how to pay the rest." => "تغطي بطاقة الهدية ورصيد المتجر {MoneyIn} من {MoneyIn2}. اختر طريقة دفع الباقي.";
  /// PlaceBag · an error message
  /// placeholders: {order.Problem} = order.Problem (string)
  /// shown through Exception
