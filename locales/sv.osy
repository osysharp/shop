  // ── __BlockSpec_ProductRow ──
  /// __BlockSpec_ProductRow · text on the page
  text "A row of the shop's products — from one shelf, or the newest — each with its photograph and price." => "En rad av butikens produkter – från en hylla, eller de nyaste – var och en med bild och pris.";
  /// __BlockSpec_ProductRow · text on the page
  text "From the shelf" => "Från hyllan";
  /// __BlockSpec_ProductRow · text on the page
  text "How many" => "Hur många";
  /// __BlockSpec_ProductRow · text on the page
  text "Leave it empty for the newest from every shelf." => "Lämna tomt för det nyaste från alla hyllor.";
  /// __BlockSpec_ProductRow · text on the page
  text "Link under it" => "Länk under";
  /// __BlockSpec_ProductRow · text on the page
  text "New in" => "Nytt";
  /// __BlockSpec_ProductRow · text on the page
  text "Product row" => "Produktrad";
  /// __BlockSpec_ProductRow · text on the page
