// Placing orders: the order's workflow takes the stock, and a bag that asks for more than is left is refused and
// made true.

using Osysharp.Shop;
using Osysharp.Workflow;

[Test(Floor)]
void placing_an_order_reserves_the_goods_and_takes_them_from_stock() {
  runas (new Visitor { Id = "v-1" }) {
    Bag("v-1", "Loafer", "38", 2);
    var receipt = Checkout("v-1");

    Assert.Equal(OrderStatus.Reserved, receipt.Status);
    Assert.StartsWith("KT-", receipt.Reference);          // the shop's own prefix
    Assert.Equal(240m, receipt.Total);
    Assert.Equal(0, Pick("Loafer", "38").Stock);          // both taken
    Assert.Equal(0, BagCount());                     // and the bag is empty
  }
}

[Test(Floor)]
void an_order_for_more_than_is_left_is_refused_and_the_bag_is_made_true() {
  runas (new Visitor { Id = "v-slow" }) {
    Bag("v-slow", "Loafer", "38", 2);                     // there were two when this visitor looked…
    Buy("v-fast", "Loafer", "38", 1);                     // …and somebody else took one

    var e = Assert.Throws<Exception>(() => Checkout("v-slow"));
    Assert.Contains("only one Loafer (38) is left", e.Message);
    Assert.Equal(1, BagCount());                  // the bag now asks for what there is
    Assert.Equal(1, Pick("Loafer", "38").Stock);          // and nothing was taken
  }
}

[Test(Floor)]
void a_thing_that_sold_out_leaves_the_bag_and_says_so() {
  runas (new Visitor { Id = "v-slow" }) {
    Bag("v-slow", "Chelsea", "38", 1);
    Buy("v-fast", "Chelsea", "38", 1);

    var e = Assert.Throws<Exception>(() => Checkout("v-slow"));
    Assert.Contains("Chelsea (38) has sold out", e.Message);
    Assert.Equal(0, BagCount());
  }
}

[Test(Floor)]
void the_bag_refuses_more_than_there_is() {
  runas (new Visitor { Id = "v-1" }) {
    Assert.Equal("There is only one.", AddToBag(Pick("Loafer", "39"), 2));
    Assert.Equal("", AddToBag(Pick("Loafer", "39"), 1));
    Assert.Equal("There is only one.", AddToBag(Pick("Loafer", "39"), 1));   // one is already in the bag
  }
}

[Test(Floor)]
void a_variant_price_overrides_the_product_price() {
  var receipt = PlaceOrderFor("v-1", "Chelsea", "38");
  Assert.Equal(190m, receipt.Total);
}

Receipt PlaceOrderFor(string visitId, string product, string size) {
  Bag(visitId, product, size, 1);
  return Checkout(visitId);
}

[Test(Floor)]
void a_delivery_costs_the_fee_until_the_bag_reaches_free_delivery() {
  runas (new Visitor { Id = "v-cheap" }) {
    Bag("v-cheap", "Loafer", "39", 1);
    var cheap = PlaceOrder("Maja Berg", "maja@example.test", "", "flat", "banktransfer",
                           "Storgatan 1", "111 22", "Stockholm", "Sweden");
    Assert.Equal(129m, cheap.Total);                      // 120 + 9

    Bag("v-dear", "Loafer", "38", 2);
    runas (new Visitor { Id = "v-dear" }) {
      var dear = PlaceOrder("Maja Berg", "maja@example.test", "", "flat", "banktransfer",
                            "Storgatan 1", "111 22", "Stockholm", "Sweden");
      Assert.Equal(240m, dear.Total);                     // over 200: free
    }
  }
}

[Test(Floor)]
void the_checkout_offers_what_the_app_set_up_and_pay_on_collection_only_when_collecting() {
  runas (new Visitor { Id = "v-choices" }) {
    Bag("v-choices", "Loafer", "39", 1);
    var ways = DeliveryChoices("SE");
    Assert.Equal(["flat", "collect", "parcel", "courier", "courier/locker"], ways.Select(w => w.Id).ToList());
    Assert.Equal(9m, ways[0].Price);
    Assert.False(ways[1].NeedsAddress);
    Assert.Equal("Storgatan 1, weekdays 10–18", ways[1].Description);
    Assert.Equal(["banktransfer", "oncollection", "stripe", "klarna"], PaymentChoices(true).Select(p => p.Key).ToList());
    Assert.Equal(["banktransfer", "stripe", "klarna"], PaymentChoices(false).Select(p => p.Key).ToList());
    Assert.True(PaymentChoices(true).Single(p => p.Key == "stripe").LeavesTheShop);
    var e = Assert.Throws<Exception>(() => PlaceOrder("Maja Berg", "maja@example.test", "", "flat", "oncollection",
                                                      "Storgatan 1", "111 22", "Stockholm", "SE"));
    Assert.Contains("not on offer", e.Message);
  }
}

[Test(Floor)]
void a_parcels_weight_is_what_a_weight_priced_delivery_quotes_by() {
  runas (new Visitor { Id = "v-weight" }) {
    runas (Desk) {
      var loafer = Pick("Loafer", "39");
      loafer.WeightGrams = 900;
      UnitOfWork.Commit();
    }
    Bag("v-weight", "Loafer", "39", 1);
    Assert.Equal(["flat", "collect", "parcel", "courier", "courier/locker"], DeliveryChoices("SE").Select(w => w.Id).ToList());
    Assert.Equal(49m, DeliveryChoices("SE").Single(w => w.Id == "parcel").Price);   // 900 g ≤ 1 kg
    Assert.Equal(99m, DeliveryChoices("DE").Single(w => w.Id == "parcel").Price);   // abroad
  }
}

[Test(Floor)]
void sending_an_order_a_carrier_delivers_books_the_parcel_and_keeps_its_label() {
  runas (new Visitor { Id = "v-courier" }) {
    runas (Desk) { Pick("Loafer", "39").WeightGrams = 900; UnitOfWork.Commit(); }
    Bag("v-courier", "Loafer", "39", 1);
    var reference = PlaceOrder("Maja Berg", "maja@example.test", "", "courier", "banktransfer",
                               "Storgatan 1", "11122", "Stockholm", "SE").Reference;
    runas (Desk) {
      var order = Order.Single(o => o.Reference == reference);
      MarkPaid(order, "");
      Workflow.Settle(order);
      var label = MarkSent(order, "");
      Workflow.Settle(order);
      Assert.Equal(OrderStatus.Fulfilled, order.Status);
      Assert.Equal("TRK-" + reference + "-900", order.Tracking);          // the carrier's number, and the parcel's weight
      Assert.Equal("https://track.example/" + reference, order.TrackingUrl);
      Assert.NotEqual("", label);
      Assert.Equal(label == "" ? "" : "x", LabelLink(order) == "" ? "" : "x");
      Assert.True(ShopMail.Any(m => m.To == "maja@example.test" && m.Text.Contains("https://track.example/" + reference)));
    }
  }
}

[Test(Floor)]
void a_bank_transfer_order_carries_the_shops_bank_details_to_the_customer() {
  Bag("v-bank", "Loafer", "39", 1);
  var receipt = Checkout("v-bank");
  Assert.Equal("IBAN SE00 0000 0000", receipt.PayInstructions);
  Assert.Equal("", receipt.PayUrl);
  runas (Desk) {
    Assert.True(ShopMail.Any(m => m.To == "maja@example.test" && m.Text.Contains("IBAN SE00 0000 0000")));
  }
}

[Test(Floor)]
void a_delivery_needs_an_address() {
  runas (new Visitor { Id = "v-1" }) {
    Bag("v-1", "Loafer", "39", 1);
    var e = Assert.Throws<Exception>(() => PlaceOrder("Maja Berg", "maja@example.test", "", "flat",
                                                      "banktransfer", "", "", "", ""));
    Assert.Contains("full address", e.Message);
  }
}

[Test(Floor)]
void a_one_of_a_kind_thing_is_bought_once_and_carries_its_spec_sheet() {
  runas (new Visitor { Id = "v-late" }) {
    var super = Product.Include(p => p.Specs).Single(p => p.Name == "Super");
    Assert.Equal("Columbus SL", Spec(super.Specs, "Tubing"));
    Assert.Equal("", Spec(super.Specs, "Groupset"));
    Assert.Equal("Frame size", super.Specs.OrderBy(s => s.Rank).First().Name);

    var reference = Buy("v-bike", "Super", "", 1);
    Assert.Equal(0, Pick("Super", "").Stock);
    var held = Product.Include(p => p.Variants).Single(p => p.Name == "Super");
    Assert.True(OnHold(held.Variants));                            // reserved, not sold — it comes back if the order lapses
    Assert.False(Sold(held.Variants));
    runas (Desk) {
      MarkPaid(Order.Single(o => o.Reference == reference), "");
      Workflow.Settle(Order.Single(o => o.Reference == reference));
    }
    var paid = Product.Include(p => p.Variants).Single(p => p.Name == "Super");
    Assert.False(OnHold(paid.Variants));
    Assert.True(Sold(paid.Variants));
    Assert.Equal("Sold out.", AddToBag(Pick("Super", ""), 1));
  }
}

[Test(Floor)]
void a_draft_is_the_desks_and_nobody_elses() {
  Assert.Equal(0, Product.Count(p => p.Name == "Secret"));
  runas (Desk) { Assert.Equal(1, Product.Count(p => p.Name == "Secret")); }
}

[Test(Floor)]
void a_visitor_cannot_write_stock() {
  Assert.Throws<Exception>(() => SetStock(Pick("Loafer", "38"), 50));
  Assert.Equal(2, Pick("Loafer", "38").Stock);
}

[Test(Floor)]
void a_visitor_cannot_read_who_ordered() {
  Buy("v-1", "Loafer", "39", 1);
  Assert.Equal(0, OrderContact.Count());
  runas (Desk) { Assert.Equal(1, OrderContact.Count()); }
}

[Test(Floor)]
void an_unpaid_reservation_lapses_and_its_goods_go_back_on_sale() {
  var reference = Buy("v-lapse", "Loafer", "38", 2);
  Assert.Equal(0, Pick("Loafer", "38").Stock);

  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    TestClock.Advance(TimeSpan.FromDays(3) + TimeSpan.FromHours(1));
    Workflow.Settle(order);
    Assert.Equal(OrderStatus.Lapsed, order.Status);
  }
  Assert.Equal(2, Pick("Loafer", "38").Stock);
  runas (Desk) { Assert.Equal(1, OrderLine.Count()); }  // the order still says what it was for
}

[Test(Floor)]
void a_category_knows_what_is_under_it() {
  var women = Category.Single(c => c.Slug == "women");
  var boots = Category.Single(c => c.Slug == "womens-boots");
  Assert.True(IsUnder(boots, women));
  Assert.False(IsUnder(women, boots));
  Assert.Equal(2, Product.Where(p => p.Category != null).ToList().Count(p => IsUnder(p.Category, women)));
}

[Test(Floor)]
void a_price_is_written_the_shops_way() {
  var shop = TheShop();
  Assert.Equal("€1,200", Money(1200m, shop));
  Assert.Equal("€24.50", Money(24.5m, shop));
}

[Test(Floor)]
void a_visitor_sees_every_listed_product_and_no_draft() {
  // Anonymous — the shop floor is public. Loafer, Chelsea and Super; the draft is not among them.
  Assert.Equal(3, Product.Count());
  Assert.Equal(3, Product.Include(p => p.Variants).Include(p => p.Images).ToList().Count);
}

[Test(Floor)]
void a_projection_is_followed_by_its_own_terminal() {
  // Server-side in-memory LINQ over loaded rows: a Select does not end the query.
  var super = Product.Include(p => p.Specs).Single(p => p.Name == "Super");
  Assert.Equal(2, super.Specs.Select(s => s.Name).Count());
  Assert.True(super.Specs.Select(s => s.Name).Any());
  Assert.Equal("Frame size", super.Specs.OrderBy(s => s.Rank).Select(s => s.Name).FirstOrDefault());
}

[Test(Floor)]
void a_way_to_pay_that_cannot_take_the_shops_currency_is_not_offered_and_the_desk_says_why() {
  // The shop sells in euros; `KronorOnly` moves kronor only (as Swish does). It is ready, and still never offered.
  Assert.False(PaymentChoices(true).Any(p => p.Key == "kronor"));
  runas (Desk) {
    var row = Providers().Single(r => r.Kind == "payment" && r.Key == "kronor");
    Assert.False(row.Ready);
    Assert.Contains("Swedish kronor only", row.NotReady);
    Assert.Contains("EUR", row.NotReady);
  }
}

[Test(Floor)]
void staff_choose_which_providers_are_offered_and_in_what_order() {
  runas (new Visitor { Id = "v-desk-choice" }) {
    runas (Desk) {
      OfferProvider("payment", "banktransfer", false);
      MoveProvider("delivery", "courier", -3);                      // to the top
    }
    Assert.False(PaymentChoices(false).Any(p => p.Key == "banktransfer"));
    Bag("v-desk-choice", "Loafer", "38", 1);
    Assert.Equal("courier", DeliveryChoices("SE")[0].Id);
    runas (Desk) {
      var rows = Providers();
      Assert.False(rows.Single(r => r.Kind == "payment" && r.Key == "banktransfer").Offered);
      Assert.Equal("courier", rows.First(r => r.Kind == "delivery").Key);   // the desk's order, first
      OfferProvider("payment", "banktransfer", true);
    }
    Assert.True(PaymentChoices(false).Any(p => p.Key == "banktransfer"));
  }
}
