// The producer's test project for Osysharp.Shop.Looks.Studio — a ceramicist's studio — bowls thrown to order, wearing the look.
//
// ⭐ IT READS THE WORKING TREE: the repository's `osy.workspace` lists `kits/*`, so `use Osysharp.Shop.Looks.Studio`
//    resolves from the directory beside this one. ⛔ It does not ship — `tests` in ../package.osy is a setting, not a role.
app StudioLookTests {
  model "model/**/*.osy";
  tests "*.test.osy";
  use Osysharp.Shop@0 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Payments@0;
  use Osysharp.Delivery@0;
  use Osysharp.Seo@0;
  use Osysharp.Blocks;
  use Osysharp.Pages@0;
  use Osysharp.Site.Looks@0;
  use Osysharp.Shop.Looks.Studio@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
  use Osysharp.Storage;
}
