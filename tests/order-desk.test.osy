// Staff's notes on an order, its timeline, a new address before it goes out, an order taken on the desk, and the
// link that pays it.

using Osysharp.Http;
using Osysharp.Payments;
using Osysharp.Payments.Stripe;
using Osysharp.Shop;
using Osysharp.Workflow;

/// Maja's own order, from her account: a Loafer (39, or the size given) delivered to Stockholm and paid by transfer.
string MajasDelivery(string visit, string size = "39") {
  runas (new Visitor { Id = visit }) {
    var reference = "";
    runas (Maja) {
      Bag(visit, "Loafer", size, 1);
      reference = PlaceOrder("Maja Berg", "maja@example.test", "", "flat", "banktransfer",
                             "Storgatan 1", "11122", "Stockholm", "SE").Reference;
    }
    return reference;
  }
}

/// The grant at the end of a payment link, as the text the link carries.
string TokenOf(string link) {
  return link.Substring(link.LastIndexOf("/") + 1);
}

/// The same link with its last characters changed — what a guess, or a typo, looks like.
string Altered(string token) {
  return token.Substring(0, token.Length - 4) + (token.EndsWith("AAAA") ? "BBBB" : "AAAA");
}

/// What a function holding a payment link can read of who the order is for — the link reaches the order, not them.
[AllowAnonymous] int ContactsSeenThrough(Pay pay) { return OrderContact.Count() + ShopAccount.Count(); }

[Test(Floor)]
void a_customer_reads_the_message_sent_to_them_and_never_the_staffs_notes() {
  var reference = MajasDelivery("v-notes");
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    NoteOnOrder(order, "Asked for it gift-wrapped — she will call about the colour of the ribbon.");
    MessageCustomer(order, "Your loafers go out on Monday.");
    Assert.Equal(2, OrderNote.Count(n => n.Order == order));
    // The message is mailed, and kept with the order it is about.
    Assert.True(ShopMail.Any(m => m.Order == order && m.To == "maja@example.test" && m.Subject.Contains("About your order")));
  }
  runas (Packer) {
    var order = Order.Single(o => o.Reference == reference);
    NoteOnOrder(order, "Box was dented — repacked.");
    Assert.Throws<Exception>(() => MessageCustomer(order, "Hello from the packing table"));   // only staff write to her
  }
  runas (Maja) {
    var order = Order.Single(o => o.Reference == reference);
    // She reads the one message sent to her — and neither note, nor who wrote it.
    Assert.Equal(1, OrderNote.Count(n => n.Order == order));
    var mine = OrderNote.Single(n => n.Order == order);
    Assert.Equal("Your loafers go out on Monday.", mine.Text);
    Assert.Null(mine.By);
    Assert.Equal(1, MessagesAbout(order).Count);
    // …and cannot write one on it, nor slip a message in as though the shop sent it.
    Assert.Throws<Exception>(() => NoteOnOrder(order, "Please upgrade me"));
    Assert.Throws<Exception>(() => { new OrderNote { Order = order, Text = "Refund approved", ToCustomer = true, At = DateTime.UtcNow }; UnitOfWork.Commit(); });
  }
  runas (Olle) { Assert.Equal(0, OrderNote.Count(n => n.Order.Reference == reference)); }
  Assert.Equal(0, OrderNote.Count(n => n.Order.Reference == reference));   // a visitor: nothing
}

[Test(Floor)]
void the_timeline_tells_what_happened_to_an_order_in_order() {
  var reference = MajasDelivery("v-timeline");
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    NoteOnOrder(order, "Called to check the door code.");
    MarkPaid(order, "");
    Workflow.Settle(order);
    MarkSent(order, "PN 555");
    Workflow.Settle(order);
    var what = OrderTimeline(order).Select(e => e.What).ToList();
    Assert.Equal("Placed", what[0]);
    Assert.True(what.IndexOf("Note") < what.IndexOf("Paid"));
    Assert.True(what.IndexOf("Paid") < what.IndexOf("Sent"));
    // What she was mailed — the confirmation, paid, on its way — each against the order.
    Assert.True(what.Count(w => w == "Mailed the customer") >= 3);
    var sent = OrderTimeline(order).Single(e => e.What == "Sent");
    Assert.Equal("Tracking PN 555", sent.Detail);
    Assert.Equal("Bank transfer", OrderTimeline(order).Single(e => e.What == "Paid").Detail);
  }
  var cancelled = MajasDelivery("v-timeline-2", "38");
  runas (Desk) {
    var order = Order.Single(o => o.Reference == cancelled);
    CancelOrder(order, "She found them cheaper");
    Workflow.Settle(order);
    var line = OrderTimeline(order).Single(e => e.What == "Cancelled");
    Assert.Equal("She found them cheaper", line.Detail);
  }
}

[Test(Floor)]
void an_address_changes_before_the_parcel_goes_out_and_never_to_another_country() {
  var reference = MajasDelivery("v-move");
  // Maja, from her account — twice, while it waits for payment.
  runas (Maja) {
    var order = Order.Single(o => o.Reference == reference);
    ChangeMyOrderAddress(order, "Hornsgatan 64", "11821", "Stockholm", "SE");
    Workflow.Settle(order);
    ChangeMyOrderAddress(order, "Hornsgatan 66", "11821", "Stockholm", "Sweden");
    Workflow.Settle(order);
    // A new country is refused: the delivery and its VAT were priced for Sweden.
    var abroad = Assert.Throws<Exception>(() => ChangeMyOrderAddress(order, "Karl Johans gate 1", "0154", "Oslo", "NO"));
    Assert.Contains("country", abroad.Message);
  }
  Order? hers = null;
  runas (Desk) { hers = Order.Single(o => o.Reference == reference); }
  runas (Olle) {
    Assert.Null(Order.SingleOrDefault(o => o.Reference == reference));    // not his to read, nor to move
    Assert.Throws<Exception>(() => ChangeMyOrderAddress(hers!, "Elsewhere 1", "11111", "Stockholm", "SE"));
  }
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    Assert.Equal("Hornsgatan 66", order.Contact.Single().Street);
    MarkPaid(order, "");
    Workflow.Settle(order);
    ChangeOrderAddress(order, "Hornsgatan 68", "11821", "Stockholm", "SE");     // paid, not yet sent: still fine
    Workflow.Settle(order);
    Assert.Equal("Hornsgatan 68", order.Contact.Single().Street);
    var moves = OrderTimeline(order).Where(e => e.What == "Address changed").ToList();
    Assert.Equal(3, moves.Count);
    Assert.Equal("From Storgatan 1, 11122 Stockholm to Hornsgatan 64, 11821 Stockholm", moves[0].Detail);
    Assert.Equal("the customer", moves[0].Who);
    Assert.Contains("(staff)", moves[2].Who);

    MarkSent(order, "PN 1");
    Workflow.Settle(order);
    var late = Assert.Throws<Exception>(() => ChangeOrderAddress(order, "Hornsgatan 70", "11821", "Stockholm", "SE"));
    Assert.Contains("gone out", late.Message);
  }
  // A collection has no address to change.
  var collect = Buy("v-move-collect", "Chelsea", "38", 1);
  runas (Desk) {
    var order = Order.Single(o => o.Reference == collect);
    Assert.Throws<Exception>(() => ChangeOrderAddress(order, "Hornsgatan 64", "11821", "Stockholm", "SE"));
  }
}

[Test(Floor)]
void an_order_taken_on_the_desk_is_placed_like_a_web_order_and_mails_a_link_to_pay_it() {
  List<string> posted = [];
  Http.Post.Stub((url, body) => { posted.Add(body); return new HttpResponse { StatusCode = 200, Body = "{\"id\":\"cs_9\",\"url\":\"https://checkout.stripe.com/c/pay/cs_9\"}" }; });
  var reference = "";
  var link = "";
  runas (Desk) {
    var bag = StartDeskOrder();
    AddToDeskOrder(bag, Pick("Chelsea", "38"), 1);
    Assert.Throws<Exception>(() => AddToDeskOrder(bag, Pick("Chelsea", "38"), 1));   // there is only one
    Assert.Throws<Exception>(() => AddToDeskOrder(bag, Variant.Single(v => v.Product.Name == "Secret"), 1));   // a draft
    Assert.Equal(190m, DeskOrderQuote(bag, "collect", "SE").Total);
    var receipt = PlaceDeskOrder(bag, new DeskCustomer { Name = "Maja Berg", Email = "Maja@Example.test", Phone = "070 123 45 67" },
                                 "collect", "stripe", true);
    reference = receipt.Reference;
    link = receipt.PayUrl;
    Assert.Equal(0, posted.Count);                       // nobody was sent to Stripe while staff placed it
    var order = Order.Single(o => o.Reference == reference);
    Assert.Equal(OrderStatus.Reserved, order.Status);    // the same workflow: the goods are held…
    Assert.Equal(190m, order.Total);
    Assert.Equal("Maja Berg", order.Account!.DisplayName);      // …and it is in her account's history
    Assert.Equal("Placed on the desk", OrderTimeline(order)[0].What);
    // Confirmed like any order, and the link mailed in the shop's frame.
    Assert.True(ShopMail.Any(m => m.Order == order && m.Subject.StartsWith("Your order " + reference + " —")));
    var mailed = ShopMail.Single(m => m.Order == order && m.Subject.Contains("ready to pay"));
    Assert.Contains(TokenOf(link), mailed.Html ?? "");
    Assert.Equal(0, Bag.Count(b => b.VisitId != null && b.VisitId.StartsWith("desk-")));   // the desk's bag is gone
  }
  Assert.Equal(0, Pick("Chelsea", "38").Stock);

  // The customer's page: the order and its price — and nothing about who or where.
  var view = PayLinkFor(Pay.From(TokenOf(link)));
  Assert.Equal("open", view.State);
  Assert.Equal(reference, view.Reference);
  Assert.Equal(190m, view.Total);
  Assert.True(view.LeavesTheShop);
  Assert.Equal("https://checkout.stripe.com/c/pay/cs_9", PayByLink(Pay.From(TokenOf(link))));
  Assert.Contains("client_reference_id=" + reference, posted[0]);
  Assert.Contains("unit_amount%5D=19000", posted[0]);
  // Back to the store's own return page — through the order's link, never its reference.
  Assert.DoesNotContain("paid%2F" + reference, posted[0]);
  var back = Regex.Match(posted[0], "paid%2F(g1\\.[A-Za-z0-9_\\-]+)%2Fstripe-");
  Assert.True(back.Success);
  Assert.Equal(reference, OrderByLink(OrderLink.From(back.Groups[1].Value)).Reference);
}

[Test(Floor)]
void a_payment_link_pays_its_own_order_once_and_nothing_else() {
  Http.Post.Stub((url, body) => new HttpResponse { StatusCode = 200, Body = "{\"id\":\"cs_9\",\"url\":\"https://checkout.stripe.com/c/pay/cs_9\"}" });
  var reference = "";
  var other = "";
  var link = "";
  runas (Desk) {
    var bag = StartDeskOrder();
    AddToDeskOrder(bag, Pick("Chelsea", "38"), 1);
    var receipt = PlaceDeskOrder(bag, new DeskCustomer { Name = "Kim", Email = "kim@example.test" }, "collect", "stripe", false);
    reference = receipt.Reference;
    Assert.Equal("", receipt.PayUrl);                                         // not asked for
    var second = StartDeskOrder();
    AddToDeskOrder(second, Pick("Loafer", "39"), 1);
    other = PlaceDeskOrder(second, new DeskCustomer { Name = "Lo", Email = "lo@example.test" }, "collect", "stripe", false).Reference;
    link = SendPayLink(Order.Single(o => o.Reference == reference), false);    // one to read out on the phone
    Assert.Equal(0, ShopMail.Count(m => m.Subject.Contains("ready to pay")));
  }
  // The link opens the order it was made for — and, of the people behind it, nothing: not the contact, not an account.
  var pay = Pay.From(TokenOf(link));
  Assert.Equal(reference, PayLinkFor(pay).Reference);
  Assert.Equal(0, ContactsSeenThrough(pay));
  // A link that was altered, or made up, opens nothing and pays nothing.
  Assert.Throws<NotAuthorized>(() => Pay.From(Altered(TokenOf(link))));
  Assert.Throws<NotAuthorized>(() => Pay.From("g1.not-a-link"));
  Assert.Throws<NotAuthorized>(() => PayByLink(Pay.From("g1.not-a-link")));
  // Nobody but staff sends one — and where one was mailed, and who sent it, are the shop's.
  Assert.Throws<Exception>(() => SendPayLink(Order.Single(o => o.Reference == other), false));
  runas (Desk) {
    SendPayLink(Order.Single(o => o.Reference == reference), true);
    var sent = OrderTimeline(Order.Single(o => o.Reference == reference)).Where(e => e.Kind == "link").ToList();
    Assert.Equal(2, sent.Count);
    Assert.True(sent.Any(e => e.Detail == "Mailed to kim@example.test"));
    Assert.True(sent.Any(e => e.Detail == "Made to hand over"));
  }
  runas (Packer) { Assert.False(OrderTimeline(Order.Single(o => o.Reference == reference)).Any(e => e.Kind == "link")); }

  // Paid through Stripe's signed webhook, as any web order is…
  var payload = CompletedEvent(reference, "paid");
  Assert.Equal("ok", StripePosts(payload, SignedBy("whsec_demo", payload), "sk_test_x"));
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    Workflow.Settle(order);
    Assert.Equal(OrderStatus.Paid, order.Status);
    Assert.Equal("pi_" + reference, order.PaymentRef);
  }
  // …and every link to it is taken back: it opens nothing, and a page still holding one starts nothing.
  Assert.Throws<NotAuthorized>(() => Pay.From(TokenOf(link)));
  Assert.Throws<NotAuthorized>(() => PayByLink(pay));
}

[Test(Floor)]
void a_payment_link_stops_working_when_the_order_is_called_off() {
  var cancelled = "";
  var lapsed = "";
  var cancelledLink = "";
  var lapsedLink = "";
  runas (Desk) {
    var bag = StartDeskOrder();
    AddToDeskOrder(bag, Pick("Chelsea", "38"), 1);
    cancelled = PlaceDeskOrder(bag, new DeskCustomer { Name = "Kim", Email = "kim@example.test" }, "collect", "banktransfer", false).Reference;
    var second = StartDeskOrder();
    AddToDeskOrder(second, Pick("Loafer", "39"), 1);
    lapsed = PlaceDeskOrder(second, new DeskCustomer { Name = "Lo", Email = "lo@example.test" }, "collect", "banktransfer", false).Reference;
    cancelledLink = SendPayLink(Order.Single(o => o.Reference == cancelled), false);
    lapsedLink = SendPayLink(Order.Single(o => o.Reference == lapsed), false);
  }
  Assert.Equal(cancelled, PayLinkFor(Pay.From(TokenOf(cancelledLink))).Reference);   // both work while they wait
  Assert.Equal(lapsed, PayLinkFor(Pay.From(TokenOf(lapsedLink))).Reference);
  runas (Desk) {
    var order = Order.Single(o => o.Reference == cancelled);
    CancelOrder(order, "She changed her mind");
    Workflow.Settle(order);
    Assert.Equal(OrderStatus.Cancelled, order.Status);
  }
  Assert.Throws<NotAuthorized>(() => Pay.From(TokenOf(cancelledLink)));
  Assert.Equal(lapsed, PayLinkFor(Pay.From(TokenOf(lapsedLink))).Reference);         // one order's links, not the other's
  runas (Desk) {
    var order = Order.Single(o => o.Reference == lapsed);
    TestClock.Advance(TimeSpan.FromDays(3) + TimeSpan.FromHours(1));
    Workflow.Settle(order);
    Assert.Equal(OrderStatus.Lapsed, order.Status);
  }
  Assert.Throws<NotAuthorized>(() => Pay.From(TokenOf(lapsedLink)));
}

[Test(Floor)]
void erasing_a_customer_takes_the_desks_notes_and_the_addresses_their_order_moved_between() {
  var reference = MajasDelivery("v-erase-desk");
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    NoteOnOrder(order, "Maja is on the third floor, the door code is 1234.");
    MessageCustomer(order, "Your loafers go out on Monday.");
    ChangeOrderAddress(order, "Hornsgatan 64", "11821", "Stockholm", "SE");
    Workflow.Settle(order);
    SendPayLink(order, true);
    CancelOrder(order, "She changed her mind");
    Workflow.Settle(order);
  }
  runas (Maja) {
    Assert.Contains("Your loafers go out on Monday.", PersonalData(MyShopAccount()));   // her copy carries what the shop wrote her
    EraseMyAccount();
  }
  runas (Desk) {
    Workflow.Settle(ShopErasure.Single());
    var order = Order.Single(o => o.Reference == reference);
    Assert.False(OrderNote.Any(n => n.Order == order && n.Text.Contains("door code")));
    Assert.Null(OrderEvent.Single(e => e.Order == order && e.Kind == OrderEventKind.AddressChanged).Text);
    Assert.Null(OrderEvent.Single(e => e.Order == order && e.Kind == OrderEventKind.PayLinkSent).Text);   // where the link went
  }
}

[Test(Floor)]
void a_links_payment_request_adds_up_to_the_order_with_delivery_and_mixed_vat() {
  runas (Desk) {
    var shop = TheShop();
    shop.VatPercent = 25m;
    shop.VatReducedPercent = 12m;
    Product.Single(p => p.Name == "Loafer").Vat = VatClass.Reduced;
    UnitOfWork.Commit();
    var bag = StartDeskOrder();
    AddToDeskOrder(bag, Pick("Loafer", "39"), 1);
    AddToDeskOrder(bag, Pick("Chelsea", "38"), 1);
    var receipt = PlaceDeskOrder(bag, new DeskCustomer { Name = "Kim", Email = "kim@example.test", Street = "Storgatan 1",
                                                         PostCode = "11122", City = "Stockholm", Country = "SE" },
                                 "parcel", "banktransfer", false);
    var order = Order.Single(o => o.Reference == receipt.Reference);
    Assert.Equal(OrderStatus.Reserved, order.Status);
    var request = PaymentRequestFor(order);
    Assert.Equal(Minor(order.Total), request.Amount);
    Assert.Equal(request.Amount, request.Lines.Sum(l => l.UnitPrice * l.Quantity));
    Assert.Equal(2, request.Lines.Count(l => l.Name.StartsWith("Parcel by weight")));   // delivery shared over both rates
  }
}
