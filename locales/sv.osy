  /// placeholders: {order.Reference} = order.Reference (string), {order.Status.Label} = order.Status.Label (string)
  /// shown through Exception
  error "{order.Reference} is {order.Status.Label}, not on its way." => "{order.Reference} är {order.Status.Label} och är inte på väg.";

  // ── MarkDown ──
  /// MarkDown · an error message
  /// shown through Exception
  /// also in ScheduleMarkDown
  error "A markdown is between 5 and 90 percent." => "En prissänkning ligger mellan 5 och 90 procent.";
  /// MarkDown · an error message
  /// shown through Exception
  error "A sale runs for at least a day." => "En rea pågår i minst en dag.";
  /// MarkDown · an error message
  /// placeholders: {product.Name} = product.Name (string)
  /// shown through Exception
  error "{product.Name} already shows a struck-through price — clear it first." => "{product.Name} visar redan ett överstruket pris. Ta bort det först.";
  /// MarkDown · an error message
  /// placeholders: {product.Name} = product.Name (string)
  /// shown through Exception
  error "{product.Name} has a sale scheduled in those days — move or end that one first." => "{product.Name} har en rea planerad de dagarna — flytta eller avsluta den först.";
  /// MarkDown · an error message
  /// placeholders: {product.Name} = product.Name (string)
  /// shown through Exception
  error "{product.Name} is already on sale — end that one first." => "{product.Name} är redan på rea. Avsluta den först.";

  // ── MarkInvoicePaid ──
  /// MarkInvoicePaid · an error message
  /// placeholders: {order.Reference} = order.Reference (string)
