  /// placeholders: {Name} = ….Name (string)
  mailSubject "Still thinking it over? Your bag at {Name}" => "Funderar du fortfarande? Din kasse hos {Name}";
  /// ShopBagReminder · text on the page
  /// shown through EmailText.text
  /// beside: "You left something in your bag", "Back to your bag"
  text "It is still there, as you left it:" => "Det ligger kvar precis som du lämnade det:";
  /// ShopBagReminder · text on the page
  /// shown through EmailNote.text
  /// beside: "You left something in your bag", "It is still there, as you left it:", "Back to your bag"
  text "The button opens your bag on any phone or computer for the next seven days, without signing in. This is the only reminder we send about it, and prices and stock can change until you order." => "Knappen öppnar din kasse på vilken telefon eller dator som helst de kommande sju dagarna, utan inloggning. Det här är den enda påminnelsen vi skickar om det, och priser och lagersaldo kan ändras tills du beställer.";
  /// ShopBagReminder · text on the page
  /// shown through EmailNote.text
  /// beside: "You left something in your bag", "It is still there, as you left it:", "Back to your bag"
  text "This is the only reminder we send about it. Prices and stock can change until you order." => "Det här är den enda påminnelsen vi skickar om det. Priser och lagersaldo kan ändras tills du beställer.";
  /// ShopBagReminder · text on the page
  /// shown through EmailHeading.text
  /// beside: "It is still there, as you left it:", "Back to your bag"
  text "You left something in your bag" => "Du glömde något i din kasse";

  // ── ShopBanner ──
  /// ShopBanner · a control's name for screen readers
  accessibleName "Banner" => "Banderoll";

  // ── ShopCampaignRefusal ──
  /// ShopCampaignRefusal · message
  /// shown through ShopCampaignRefusal()
  message "A picture in the newsletter is not one you can open — remove it, or upload it again yourself." => "En bild i nyhetsbrevet går inte att öppna. Ta bort den eller ladda upp den själv igen.";
  /// ShopCampaignRefusal · message
  /// shown through ShopCampaignRefusal()
  message "The subject goes out exactly as written, so it cannot use {placeholders} — put them in the body." => "Ämnesraden skickas exakt som den är skriven och kan därför inte innehålla {placeholders}. Lägg dem i texten.";

  // ── ShopCategoryTiles ──
