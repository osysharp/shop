  error "{order.Reference} is not on invoice terms." => "{order.Reference} är inte på faktura.";
  /// MarkInvoicePaid · an error message
  /// placeholders: {order.Reference} = order.Reference (string)
  /// shown through Exception
  error "{order.Reference} is paid already." => "{order.Reference} är redan betald.";

  // ── MarkPacked ──
  /// MarkPacked · an error message
  /// placeholders: {order.Reference} = order.Reference (string), {order.Status.Label} = order.Status.Label (string)
  /// shown through Exception
  error "{order.Reference} is {order.Status.Label} — only an order being prepared is packed." => "{order.Reference} är {order.Status.Label}. Bara en order som förbereds packas.";

