// A signed-in account changes its own password and address — each on the strength of the current password, and the
// address only once the new one has confirmed it (Osysharp.UserAccounts).

using Osysharp.UserAccounts;
using Osysharp.Mail;
using Osysharp.Shop;

[Test(Floor)]
[runas(Maja)]
void a_customer_changes_their_password_with_the_current_one() {
  Assert.Throws<Exception>(() => ChangePassword("maja@example.test", "wrong", "a-new-pass-1"));
  Assert.NotEqual("", ChangePassword("maja@example.test", "maja-pass-1", "a-new-pass-1"));
  Assert.NotEqual("", SignIn("maja@example.test", "a-new-pass-1").Ticket);
  Assert.Equal("", SignIn("maja@example.test", "maja-pass-1").Ticket);
}

/// The old address is told at once, in the shop's design; the account moves only when the new address confirms it.
[Test(Floor)]
void a_customer_moves_to_a_new_address_once_it_confirms() {
  runas (Maja) {
    Assert.Throws<Exception>(() => ChangeEmail("maja@example.test", "maja-pass-1", "olle@example.test"));   // taken
    Assert.Equal("", ChangeEmail("maja@example.test", "maja-pass-1", "Maja@New.test"));
  }
  Assert.Equal("", SignIn("maja@new.test", "maja-pass-1").Ticket);   // not yet
  string token = "";
  runas (AuthBootstrap) {
    Assert.Equal(1, OutgoingMail.Count(m => m.To == "maja@example.test" && m.Subject == "Your Kit Test Shop account's address is changing"));
    var confirm = OutgoingMail.Single(m => m.To == "maja@new.test");
    Assert.Equal("Confirm your new address at Kit Test Shop", confirm.Subject);
    var text = confirm.Text ?? "";
    token = text.Substring(text.IndexOf("/verify-email/") + 14, 32);
  }
  runas (AuthBootstrap) { Assert.True(VerifyEmail(token).Proven); }
  Assert.NotEqual("", SignIn("maja@new.test", "maja-pass-1").Ticket);
  Assert.Equal("", SignIn("maja@example.test", "maja-pass-1").Ticket);
  // Still the same shop account: her orders, her bag and her details stay hers.
  runas (Desk) { Assert.Equal("Maja Berg", ShopAccount.Single(a => a.Email == "maja@new.test").DisplayName); }
}

[Test(Floor)]
void staff_list_their_customers_and_nobody_else_may() {
  runas (Maja) { Buy("v-c1", "Loafer", "38", 1); }
  runas (Desk) {
    var reference = Order.Single().Reference;
    MarkPaid(Order.Single(), "");
    var maja = Customers("berg").Single();
    Assert.Equal(1, maja.Orders);
    Assert.Equal(120m, maja.Spent);
    Assert.Equal(reference, OrdersOf(maja.Account).Single().Reference);
    Assert.True(Customers("").Any(c => c.Account.Email == "olle@example.test"));
  }
  runas (Maja) { Assert.Throws<Exception>(() => Customers("")); }
}
