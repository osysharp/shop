    Assert.Equal("", AddToBag(Pick("Chelsea", "38"), 1));                         // €16.95 more: €27.90 ≥ €20
    Assert.Equal(0m, DeliveryChoices("SE").Single(d => d.Id == "flat").Price);
  }
  runas (Desk) { SetSoldDeliveryPrice("EUR", "flat", ""); }                        // off the table: converted again
  runas (Desk) { Assert.Equal("", SoldCurrenciesOnTheDesk().Single().Delivery.Single(d => d.Id == "flat").Set); }
}

[Test(Floor)]
void a_way_to_pay_that_cannot_take_the_currency_is_not_offered_and_the_desk_says_why() {
  KronorShopSellingEuros();
  EuroBag("v-sell-pay", "Loafer", "38");
  runas (new Visitor { Id = "v-sell-pay" }) {
    var keys = PaymentChoices(true).Select(p => p.Key).ToList();
    Assert.Contains("stripe", keys);
    Assert.DoesNotContain("banktransfer", keys);   // paid into the shop's kronor account
    Assert.DoesNotContain("oncollection", keys);
    Assert.DoesNotContain("kronor", keys);         // kronor only, as Swish
    Assert.Contains("klarna", keys);               // the shop's Klarna market is Germany, which pairs with euros
    Assert.Throws<Exception>(() => PlaceOrder("Maja Berg", "maja@example.test", "", "collect", "banktransfer", "", "", "", ""));
  }
  // Klarna takes euros from a buyer in a euro country, and kronor from one in Sweden — each country's own currency.
  Assert.Contains("klarna", PaymentChoicesIn(false, "EUR", "DE").Select(p => p.Key).ToList());
  Assert.DoesNotContain("klarna", PaymentChoicesIn(false, "EUR", "SE").Select(p => p.Key).ToList());
  Assert.Contains("klarna", PaymentChoicesIn(false, "SEK", "SE").Select(p => p.Key).ToList());
  Assert.DoesNotContain("klarna", PaymentChoicesIn(true, "SEK", "").Select(p => p.Key).ToList());   // its market: Germany
  Assert.Contains("banktransfer", PaymentChoicesIn(true, "SEK", "").Select(p => p.Key).ToList());
  runas (Desk) {
    var notOffered = string.Join("\n", SoldCurrenciesOnTheDesk().Single(s => s.Currency == "EUR").NotOffered);
    Assert.Contains("Bank transfer is paid into the shop's own account, in SEK", notOffered);
    Assert.Contains("Kronor: This moves Swedish kronor only", notOffered);
    Assert.DoesNotContain("Klarna", notOffered);
    // …and in the shop's own kronor, the desk says why Klarna (a German market) is not offered.
    Assert.Equal("Klarna takes EUR from a buyer in DE, not SEK.", Providers().Single(r => r.Key == "klarna").NotReady);
  }
}

[Test(Floor)]
void a_gift_card_is_in_the_currency_it_was_bought_in_and_pays_only_for_an_order_in_it() {
  KronorShopSellingEuros();
  GiftShelf();
  var reference = "";
  Http.Post.Stub((url, body) => CardSession());
  runas (new Visitor { Id = "v-sell-card" }) {
    ShowPricesIn("EUR");
    // The shop's bounds, 10 kr to 500 kr, are €0.88 to €44.17 in euros.
    Assert.Contains("€0.88 to €44.17", AddGiftCardToBag(CardOf("Your amount"), 50m, "Maja", "Anna", "anna@example.test", "", null));
    Assert.Equal("", AddGiftCardToBag(CardOf("Your amount"), 40m, "Maja", "Anna", "anna@example.test", "", null));
    runas (Maja) {
      reference = PlaceOrder("Maja Berg", "maja@example.test", "", NothingToShipId(), "stripe", "", "", "", "SE").Reference;
    }
  }
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    MarkPaid(order, "");
    Workflow.Settle(order);
    var card = GiftCard.Single(c => c.SoldWith == order);
    Workflow.Settle(card);
    Assert.Equal("EUR", card.Currency);
    Assert.Equal(40m, card.Amount);
    Assert.Equal(0.08833532m, card.Rate);
  }
  var code = CodeMailedTo("anna@example.test");
  Assert.Equal("EUR", GiftCardBalance(code).Currency);
  // In kronor it is refused, and says how to spend it; in euros it pays.
  Bag("v-sell-card-sek", "Loafer", "38", 1);
  runas (new Visitor { Id = "v-sell-card-sek" }) {
    Assert.Throws<Exception>(() => ApplyGiftCard(code));
  }
  EuroBag("v-sell-card-eur", "Loafer", "38");
  runas (new Visitor { Id = "v-sell-card-eur" }) {
    Assert.Equal($"Gift card ending {code.Substring(15, 4)}, €40 to spend", ApplyGiftCard(code));
    Assert.Equal(10.95m, CheckoutQuote("collect", "").GiftCards);
    // Switched to kronor, the card stays on the bag and pays nothing.
    ShowPricesIn("SEK");
    Assert.Equal(0m, CheckoutQuote("collect", "").GiftCards);
  }
}

[Test(Floor)]
void store_credit_is_the_shops_own_money_and_an_order_in_euros_is_refunded_the_way_it_was_paid() {
  KronorShopSellingEuros();
  runas (Desk) {
    GrantCredit(Maja, 50m, "A late parcel");
    Workflow.Settle(StoreCreditGrant.Single());
  }
  EuroBag("v-sell-credit", "Loafer", "38");
  Http.Post.Stub((url, body) => CardSession());
  var reference = "";
  runas (new Visitor { Id = "v-sell-credit" }) {
    runas (Maja) {
      UseStoreCredit(true);
      Assert.Equal(0m, CheckoutQuote("collect", "").Credit);     // kronor credit does not pay a euro order
    }
  }
  reference = EuroOrderByCard("v-sell-credit").Reference;
  runas (Desk) {
    var order = Order.Single(o => o.Reference == reference);
    Assert.Equal(0m, order.CreditUsed);
    MarkPaid(order, "");
    Workflow.Settle(order);
    MarkSent(order, "PostNord 1");
    Workflow.Settle(order);
  }
  runas (Maja) {
    var line = OrderLine.Single(l => l.Order.Reference == reference);
    Assert.Throws<Exception>(() => ReturnItem(line, 1, "Too small", true));
  }
  // Refunded in part by the desk: the credit note is in euros, its VAT the euro VAT.
  runas (Desk) {
    var line = OrderLine.Single(l => l.Order.Reference == reference);
    var ret = RefundPart(line, 1, "Too small", true);
    Workflow.Settle(ret);
    var note = CreditNote.Single(c => c.Invoice.Order.Reference == reference);
    Assert.Equal(10.95m, note.Total);
    Assert.Equal(2.19m, note.Vat);
    Assert.Equal(0m, note.ToStoreCredit);
    Assert.Equal(50m, CreditBalanceOf(Maja));
  }
}

// An agreed price (a subscription's) is in ONE currency: placed in a bag bought in it, and never in another — the add-on
// that agreed it agrees it again when the bag moves (the subscriptions kit's currencies.test.osy).
[Test(Floor)]
void an_agreed_price_is_placed_in_its_own_currency_and_never_in_another() {
  KronorShopSellingEuros();
  EuroBag("v-sell-plan", "Loafer", "38");
  runas (Desk) {
    var line = BagLine.Single(l => l.Bag.VisitId == "v-sell-plan");
    new AgreedLinePrice { Line = line, Price = 99m, Label = "Every month" };               // in kronor
    UnitOfWork.Commit();
  }
  runas (new Visitor { Id = "v-sell-plan" }) {
    var refused = Assert.Throws<Exception>(() => PlaceOrder("Maja Berg", "maja@example.test", "", "collect", "stripe", "", "", "", ""));
    Assert.Contains("Every month was agreed in SEK, and your bag is in EUR now", refused.Message);
  }
  runas (Desk) {
    var agreed = AgreedLinePrice.Single(a => a.Line.Bag.VisitId == "v-sell-plan");
    agreed.Price = 8.95m;
    agreed.Currency = "EUR";
    agreed.Line.PriceWhenAdded = 8.95m;                                                    // as the shop agrees it
    UnitOfWork.Commit();
  }
  runas (new Visitor { Id = "v-sell-plan" }) {
    Http.Post.Stub((url, body) => CardSession());
    var receipt = PlaceOrder("Maja Berg", "maja@example.test", "", "collect", "stripe", "", "", "", "");
    Assert.Equal("EUR", receipt.Currency);
    Assert.Equal(8.95m, receipt.Total);
  }
}

