  mailWords "We are sorry it did not work out, {customer.firstname}. Here is your money back." => "Vi beklagar att det inte blev som du tänkt, {customer.firstname}. Här får du pengarna tillbaka.";

  // ── __RegionSpec_ShopShipped ──
