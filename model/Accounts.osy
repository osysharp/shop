// Accounts. A shop's customers and its staff are ONE kind of account — Osysharp.UserAccounts' `User`, as the shop's own
// `ShopAccount` — told apart by role. Signing up, signing in, a forgotten password, a changed address (confirmed from the
// new address), two-step sign-in, a phone and a provider are all Osysharp.UserAccounts'; what the shop adds is what a shop
// keeps about a customer (where their orders go, the language it writes to them in) and its roles.
//
// ⚑ THE APP STATES THE ACCOUNTS SETUP ONCE: `app.Accounts = ShopAccounts("Rust & Chrome");` — the shop's kind of account
//   for every sign-up, the Customer role for it, and the shop's own mail for each account message. (A setting is the
//   app's to state; a kit cannot state another kit's.)
// ⚑ THE PAGES ARE THE ACCOUNTS KIT'S ADDRESSES — `/login`, `/sign-up`, `/forgot-password`, `/reset-password/{token}`,
//   `/verify-email/{token}`, `/account` — which its mail links to and where the platform sends a visitor who must sign in.
//   A store takes each over in its own frame by declaring a component of the same name around the shop's own screens:
//     [Route("/login")] [Layout(Shop)] [AllowAnonymous] component SignInPage() { render { ShopSignIn(); } }
// ⚑ WHO HOLDS WHICH ROLE IS THE APP'S TO SHOW: Osysharp.Identity's `RoleGrant` is read by each person for their own, so
//   the desk's list of packers and counter staff needs the app to let staff read it —
//     partial entity RoleGrant { security { allow read when IsShopStaff; } }
//   A sign-up is given `Customer` (`ShopAccounts()`); `osy user add … --role Staff` makes staff.
// ⚑ SIGNING IN IS NEVER REQUIRED TO BUY. A visitor's bag belongs to their visit (Bag.osy) and checkout takes a guest.
//   An account adds what a visit cannot keep: the bag across devices and weeks, the order history, and returns.

namespace Osysharp.Shop;

using Osysharp.Identity;
using Osysharp.UserAccounts;
using Osysharp.EmailTemplates;
using Osysharp.Workflow;

// ⚠ Appended, never inserted: an enum is stored by position.
/// The app's roles — a shop's `[Role]` enum is the app's one role vocabulary, granted through Osysharp.Identity's
/// `RoleGrant` like every app's.
/// `Counter`: sells at a shop's counter (Counter.osy) — rings up sales, takes payment, hands over what is collected
/// there, takes returns back — at ONE location when its limit names one, and sees no money beyond the sale in front of
/// them: no figures, no invoices, no books, no desk.
[Role] public enum ShopRole { Staff, Authenticator, Customer, Packer, Counter }

/// A packer or a counter clerk limited to ONE location — the orders they pick, pack and send, or the counter they sell
/// at. Without one, a packer or clerk works at every location. Staff are never limited. (A shop without locations has
/// nothing to limit.)
[Unique(Member, Role, "They are already limited to a location for that role.")]
public entity ShopRoleLimit {
  [Required] Principal Member;
  [Required] ShopRole Role;
  [Required] StockLocation Location;
  security {
    allow read, create, update, delete when IsShopStaff;
    // …and each person reads their own — what a counter clerk's page asks to know where they sell (Counter.osy).
    allow read when IsAuthenticated where Member == user;
  }
}

policy IsShopStaff => RoleGrant.Any(g => g.Member == user && g.Role == ShopRole.Staff);
/// Somebody who gets orders out of the door — a PACKER (picks, packs, sends, prints labels; sees no money), or staff,
/// who can do everything a packer can.
policy IsShopPacker => RoleGrant.Any(g => g.Member == user && (g.Role == ShopRole.Packer || g.Role == ShopRole.Staff));
/// Somebody who may get an order picked at `location` out of the door — staff, a packer for every location, or a packer
/// limited to that one (`ShopRoleLimit`).
policy PacksAt(StockLocation? location) => IsShopStaff
  || (RoleGrant.Any(g => g.Member == user && g.Role == ShopRole.Packer)
      && !ShopRoleLimit.Any(l => l.Member == user && l.Role == ShopRole.Packer && l.Location != location));
/// Somebody who sells at a counter — a counter clerk, or staff (who can do everything a clerk can).
policy IsShopCounter => RoleGrant.Any(g => g.Member == user && (g.Role == ShopRole.Counter || g.Role == ShopRole.Staff));
/// Somebody who may sell at the counter of `location` (null: a shop without locations) — staff, a clerk for every
/// location, or a clerk limited to that one (`ShopRoleLimit`).
policy SellsAt(StockLocation? location) => IsShopStaff
  || (RoleGrant.Any(g => g.Member == user && g.Role == ShopRole.Counter)
      && !ShopRoleLimit.Any(l => l.Member == user && l.Role == ShopRole.Counter && l.Location != location));

/// A shop's account — a customer keeping their bag and seeing their orders, or one of the staff who run the shop. It IS
/// an Osysharp.UserAccounts `User`: the address, the name (`DisplayName`), the password and every way of signing in are that
/// kit's, with its rules; these are what the shop adds.
public entity ShopAccount : User {
  /// A phone number for a delivery — what the checkout fills in. Not the number the account signs in with
  /// (`User.Phone`, proven by a texted code).
  [MaxLength(40)] string? ContactPhone;
  /// Where their orders usually go — what the checkout fills in for them.
  [MaxLength(200)] string? Street;
  [MaxLength(20)] string? PostCode;
  [MaxLength(80)] string? City;
  [MaxLength(80)] string? Country;
  /// The language they read the shop in, as a culture ("sv-SE"): set when they switch language while signed in, and
  /// when they sign up in the language they were reading. A new phone or computer reads the shop in it until they
  /// choose otherwise there, and the shop's mail to them that is not about an order (a reset link, their store credit,
  /// a bag left behind, a newsletter) is written in it. An order's mail is in the language the order was placed in.
  [PreferredCulture] Culture? Language;
  // ⚠ Osysharp.UserAccounts' rules on `User` are the floor: these can only narrow them. Each customer reads and edits their
  //   own account; staff and the sign-in flow read every account. Nobody else sees who shops here.
  security {
    allow read when IsAuthenticated || IsAuthenticator;
    allow create when IsAuthenticator;
    allow update when IsAuthenticated || IsAuthenticator where Id == user.Id;
    allow update when IsAuthenticator || IsShopStaff;
    // SECURITY-INVARIANT(shop-a-customer-sees-no-other-account): another account's row — who it is, where it lives — is
    // staff's and the sign-in flow's to read, never another customer's. Guarded by tests/accounts.test.osy.
    deny read when !IsShopStaff && !IsAuthenticator where Id != user.Id;
  }
}

/// What a shop's sign-up makes: a `ShopAccount`, in the language the visitor was reading (in a shop that speaks more
/// than one) — `ShopAccounts()` names it.
public class ShopAccountKinds : AccountKinds {
  public override User New(string email, string name) {
    return new ShopAccount {
      Email = email,
      Language = App.Languages.Count > 1 ? App.CultureOf(Session.Language) : null,
    };
  }
}

/// The account's mail, in the shop's design and in the account's language — each one the shop's `ShopMails` writes, so a
/// store that rewrote a shop mail has it here too. Osysharp.UserAccounts sends them; `ShopAccounts()` names this.
/// An account the shop did not make (staff added with `osy user add`, which makes a plain `User`), and any account before
/// the shop is set up (its first day: no name, no address to write from yet), is sent the UserAccounts kit's own mail.
public class ShopAccountMails : AccountMails {
  public override RenderedEmail PasswordReset(User account, string link) {
    if (account is ShopAccount a && ShopSettings.Any()) { return App.Setting<ShopSetup>().Mails.PasswordReset(a, link); }
    return base.PasswordReset(account, link);
  }
  public override RenderedEmail Verification(User account, string address, string link, bool isChange, string code) {
    if (account is ShopAccount a && ShopSettings.Any()) { return App.Setting<ShopSetup>().Mails.ConfirmAddress(a, address, code, link, isChange); }
    return base.Verification(account, address, link, isChange, code);
  }
  public override RenderedEmail AccountExists(string address, string signInLink, string resetLink) {
    if (ShopSettings.Any()) { return App.Setting<ShopSetup>().Mails.AccountExists(address, signInLink, resetLink); }
    return base.AccountExists(address, signInLink, resetLink);
  }
  public override RenderedEmail AddressChangeRequested(User account, string newAddress) {
    if (account is ShopAccount a && ShopSettings.Any()) { return App.Setting<ShopSetup>().Mails.AddressChanged(a, newAddress, toTheOldAddress: true); }
    return base.AddressChangeRequested(account, newAddress);
  }
}

/// The accounts setup a shop signs people in with — what the app states as `app.Accounts = ShopAccounts("Rust & Chrome");`:
/// every sign-up makes a `ShopAccount` with the `Customer` role, the account's mail is the shop's, and a signed-in
/// customer lands on their account page. `requireVerifiedEmail` asks every account to prove its address — by the link or
/// the six-digit code its mail carries — before it is signed in (off by default: a mail outage must not become an
/// outage of the shop). For more, state an `AccountsSetup` of your own with these members set the same way.
public AccountsSetup ShopAccounts(string appName, bool requireVerifiedEmail = false) {
  return new AccountsSetup {
    AppName = appName, SignupRole = ShopRole.Customer, Kinds = new ShopAccountKinds(), Mails = new ShopAccountMails(),
    HomePath = "/account", MinPasswordLength = 8, RequireVerifiedEmail = requireVerifiedEmail,
  };
}

/// The signed-in shop account, or null for a visitor (and for an account the shop did not make — staff added with
/// `osy user add` are plain Accounts users, with no bag or orders of their own).
[AllowAnonymous]
public ShopAccount? MyShopAccount() {
  if (Session.CurrentUser is ShopAccount a) { return a; }
  return null;
}

/// How the shop names an account — a customer, or one of the staff — by its name, or its address when it gave none.
public string ShopNameOf(Principal account) {
  return account.DisplayName.Trim() != "" ? account.DisplayName : account.Email;
}

/// Whether the signed-in account is staff — what a page asks before it offers the desk.
public bool AmStaff() {
  var me = Session.CurrentUser;
  return me != null && RoleGrant.Any(g => g.Member == me && g.Role == ShopRole.Staff);
}

/// Saves the details a signed-in customer keeps on their account.
public void SaveMyDetails(string name, string phone, string street, string postCode, string city, string country) {
  var me = MyShopAccount();
  if (me == null) { throw new Exception("Sign in first."); }
  me.DisplayName = name.Trim(); me.ContactPhone = Blank(phone);
  me.Street = Blank(street); me.PostCode = Blank(postCode); me.City = Blank(city); me.Country = Blank(country);
  UnitOfWork.Commit();
}

/// Keeps the language a signed-in customer switched to on their account, so the shop greets them in it on another
/// phone or computer, and writes to them in it. A visitor's choice stays with their browser alone. Call it beside
/// `Session.SetLanguage(language)` in the store's language switch — a public page's, so a visitor may call it too, and
/// for them it does nothing.
[AllowAnonymous]
public void RememberMyLanguage(string language) {
  var me = MyShopAccount();
  if (me == null || !App.Languages.Contains(language)) { return; }
  // What an account keeps is the culture the shop writes that language in ("sv" → "sv-SE").
  var culture = App.CultureOf(language);
  if (culture == null) { return; }
  me.Language = culture;
  UnitOfWork.Commit();
}

/// The language the shop writes to `email` in when the mail is not about an order: the language on its account, when
/// it has one and it chose one — else null, and the mail is in the language of whoever sends it.
public string? ShopLanguageOf(string email) {
  var account = ShopAccount.FirstOrDefault(a => a.Email == NormalisedEmail(email));
  return account == null ? null : account.Language;
}

/// The language the shop speaks for a culture an account keeps ("sv-SE" → "sv") — or the culture itself when it
/// speaks none of it.
public string ShopSpokenLanguage(string culture) {
  var spoken = App.Languages.FirstOrDefault(l => culture == l || culture.StartsWith(l + "-"));
  return spoken ?? culture;
}

/// A language as it names itself — "Svenska", "English" — which is how a person finds their own in a list.
public string ShopLanguageName(string code) {
  var language = code.Contains("-") ? code.Substring(0, code.IndexOf("-")) : code;
  if (language == "en") { return "English"; }
  if (language == "sv") { return "Svenska"; }
  if (language == "de") { return "Deutsch"; }
  if (language == "fr") { return "Français"; }
  if (language == "fi") { return "Suomi"; }
  if (language == "nb") { return "Norsk bokmål"; }
  if (language == "da") { return "Dansk"; }
  if (language == "es") { return "Español"; }
  if (language == "it") { return "Italiano"; }
  if (language == "nl") { return "Nederlands"; }
  if (language == "pl") { return "Polski"; }
  if (language == "pt") { return "Português"; }
  return code.ToUpper();
}

// ── the desk's view of customers ──────────────────────────────────────────────────────────────────────────────

/// One customer as the desk lists them: who, and what they have bought.
public class CustomerRow {
  public ShopAccount Account;
  public int Orders;
  public decimal Spent;
}

/// The shop's customers — every shop account (each made by the shop's sign-up) — newest first, narrowed by a search over
/// name and address. With what each has ordered and spent (paid orders only).
[Authorize(IsShopStaff)]
public List<CustomerRow> Customers(string search) {
  var s = search.Trim().ToLower();
  var accounts = ShopAccount
    .OrderByDescending(a => a.CreatedAt).ToList()
    .Where(a => s == "" || a.Email.Contains(s) || a.DisplayName.ToLower().Contains(s)).ToList();
  var rows = new List<CustomerRow>();
  foreach (var a in accounts) {
    var paid = Order.Where(o => o.Account == a && o.PaidAt != null).ToList();
    rows.Add(new CustomerRow { Account = a, Orders = paid.Count, Spent = paid.Sum(o => InShopMoney(o.Total, o)) });
  }
  return rows;
}

/// Every order one customer placed, newest first — the desk's view of a customer.
[Authorize(IsShopStaff)]
public List<Order> OrdersOf(ShopAccount customer) {
  return Order.Where(o => o.Account == customer).OrderByDescending(o => o.PlacedAt).ToList();
}
