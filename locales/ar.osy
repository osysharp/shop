  error "You can return {value} more of that." => { zero: "يمكنك إرجاع {value} قطعة أخرى من هذا المنتج.", one: "يمكنك إرجاع {value} قطعة أخرى من هذا المنتج.", two: "يمكنك إرجاع {value} قطعة أخرى من هذا المنتج.", few: "يمكنك إرجاع {value} قطع أخرى من هذا المنتج.", many: "يمكنك إرجاع {value} قطعة أخرى من هذا المنتج.", other: "يمكنك إرجاع {value} قطعة أخرى من هذا المنتج." };

