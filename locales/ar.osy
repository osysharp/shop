  // ── CheckReturnable ──
  /// CheckReturnable · an error message
  /// shown through Exception
  error "A download cannot be sent back — you agreed to have it at once. Write to us if something is wrong with it." => "لا يمكن إرجاع التنزيل الرقمي، فقد وافقت على استلامه فورًا. راسلنا إن كان فيه خلل.";
  /// CheckReturnable · an error message
  /// shown through Exception
  error "A gift card is not sent back — write to us while it is unused and we will refund it." => "بطاقة الهدية لا تُرجع. راسلنا ما دامت غير مستخدمة وسنسترد مبلغها.";
  /// CheckReturnable · an error message
