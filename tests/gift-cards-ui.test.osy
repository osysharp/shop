// Gift cards and downloads through the screen: staff issue a card and upload a file privately on the desk; a customer
// checks a card, pays with one at the checkout, and downloads what they bought from their account and from the link.

using Osysharp.Shop;
using Osysharp.Storage;
using Osysharp.Workflow;

void StaffOnTheDesk() {
  Ui.Visit("/account/sign-in");
  Ui.Fill("Email", "anna@shop.test");
  Ui.Fill("Password", "desk-pass-1");
  Ui.Click("Sign in");
  Ui.Visit("/desk");
}

void MajaSignsIn() {
  Ui.Visit("/account/sign-in");
  Ui.Fill("Email", "maja@example.test");
  Ui.Fill("Password", "maja-pass-1");
  Ui.Click("Sign in");
}

/// ⭐ THE SHOP'S `GiftCardGoodwill` SLOT, FILLED BY THE APP (`CodesInstead`, model/pages/account.osy): before staff give a
/// gift card away, the desk offers what the app — or an add-on kit, as the discount codes kit does — adds there.
[Test(Floor)]
void the_desk_offers_what_the_app_adds_before_a_free_gift_card() {
  Ui.SignInAs(Desk);
  Ui.Visit("/desk");
  Ui.Click("Gift cards");
  Ui.Click("Issue a gift card…");
  Assert.Visible("Make a discount code", within: "Usually simpler");
}

// D-GIFTCARD-FREECARDS1: a card given away still has its goods taxed when it is spent, so before one is issued the desk
// says a discount code or store credit is usually the simpler gift — and takes staff to either.
[Test(Floor)]
void before_a_free_card_the_desk_points_to_a_discount_code_or_store_credit() {
  StaffOnTheDesk();
  Ui.Click("Gift cards");
  Assert.Visible("Cards sold now are multi-purpose vouchers");
  Ui.Click("Issue a gift card…");
  Assert.Visible("For goodwill — a sorry, a thank-you — a discount code or store credit is usually simpler.");
  Assert.Visible("Make a discount code");
  Ui.Click("Give store credit instead");
  // The customers tab, where store credit is given.
  Assert.Visible("Search by name or email");
  Assert.Hidden("Issue and mail it");
}

// D-GIFTCARD-SPV1: the setting on the desk, and the warning when the shop is not the kind a single-purpose card suits —
// this one sells VAT-free to businesses abroad (its VAT-number check).
[Test(Floor)]
void staff_turn_on_single_purpose_cards_and_the_desk_says_why_they_are_wrong_here() {
  StaffOnTheDesk();
  Ui.Click("Settings");
  Ui.Check("Gift cards are single-purpose vouchers — their VAT is paid when a card is sold, and none when it is spent");
  Ui.Click("Save settings");
  Assert.Visible("Saved.");
  Assert.Visible("The shop sells to other countries");
  runas (Desk) { Assert.True(TheShop().GiftCardsAreSinglePurpose); }
  Ui.Click("Gift cards");
  Assert.Visible("Cards sold now are single-purpose vouchers");
  Assert.Visible("The shop sells to other countries");
}

[Test(Floor)]
void staff_issue_a_card_on_the_desk_and_anybody_checks_it_by_its_code() {
  StaffOnTheDesk();
  Ui.Click("Gift cards");
  Assert.Visible("No gift cards yet.");
  Ui.Click("Issue a gift card…");
  Ui.Fill("Amount", "40");
  Ui.Fill("Email", "olle@example.test");
  Ui.Fill("Why — for whoever reads the card next", "Sorry about the broken cup.");
  Ui.Click("Issue and mail it");
  Assert.Visible("Issued and mailed.");
  runas (Desk) { Workflow.Settle(GiftCard.Single()); }
  Ui.Click("Find");
  Ui.Click("Open");
  Assert.Visible("From the shop");
  Assert.Visible("Sorry about the broken cup.");
  // The code is in the mail, and only there — its balance, checked by anybody who has it.
  var code = CodesMailedTo("olle@example.test").Single();
  Ui.Visit("/gift-card");
  Ui.Fill("Gift card code", code);
  Ui.Click("Check");
  Assert.Visible("€40");
  Assert.Visible($"Gift card ending {code.Substring(15, 4)}");
  Ui.Fill("Gift card code", "AAAA-BBBB-CCCC-DDDD");
  Ui.Click("Check");
  Assert.Visible("That is not one of our gift cards");
}

[Test(Floor)]
void the_checkout_takes_a_gift_card_code() {
  runas (new Visitor { Id = "v-card-ui" }) {
    var code = IssueTo("maja@example.test", 30m);
    Bag("v-card-ui", "Loafer", "38", 1);
    Ui.Visit("/checkout-parts");
    Ui.Click("Pay with a gift card");
    Ui.Fill("Gift card code", "NOPE");
    Ui.Click("Use it");
    Assert.Visible("16 letters and digits");
    Ui.Fill("Gift card code", code);
    Ui.Click("Use it");
    Assert.Visible($"Gift card ending {code.Substring(15, 4)}, €30");
    Assert.Equal(30m, CheckoutQuote("collect", "").GiftCards);
    Ui.Click("Remove");
    Assert.Hidden($"Gift card ending {code.Substring(15, 4)}");
    Assert.Equal(0m, CheckoutQuote("collect", "").GiftCards);
  }
}

[Test(Floor)]
void staff_upload_a_file_for_sale_privately_from_the_product() {
  runas (Desk) {
    var guide = new Product { Name = "Brewing guide", Slug = "brewing-guide", Price = 20m };
    new Variant { Product = guide, Size = "PDF" };
    UnitOfWork.Commit();
  }
  StaffOnTheDesk();
  Ui.Click("Products");
  Ui.Click("Edit", within: "Brewing guide");
  Assert.Visible("Sell as a file…");
  Ui.Upload("Sell as a file…", "brewing-guide.pdf", "%PDF-1.4 how to brew");
  Assert.Visible("Sold as a file: brewing-guide.pdf");
  runas (Desk) {
    var pdf = Variant.Single(v => v.Size == "PDF");
    Assert.True(pdf.IsDownload);
    // Stored privately, at a name the platform chose — never under public/.
    Assert.StartsWith("uploads/", pdf.DownloadPath!);
    Assert.Equal("%PDF-1.4 how to brew", Text.FromBytes(File.ReadAllBytes(pdf.DownloadPath!)));
  }
}

[Test(Floor)]
void a_customer_downloads_from_the_account_and_from_the_mailed_link() {
  GuideShelf();
  var reference = MajaBuysTheGuide("v-dl-ui");
  MajaSignsIn();
  Ui.Visit("/account");
  Ui.Click("Downloads");
  Assert.Visible("Brewing guide");
  Assert.Visible("5 downloads left");
  Ui.Click("Download");
  runas (Desk) { Assert.Equal(1, Download.Single().Count); }
  // The link in the mail, opened by anybody who has it.
  Ui.SignOut();
  Ui.Visit($"/download/{DownloadLinkIn("maja@example.test")}");
  Assert.Visible("brewing-guide.pdf");
  Assert.Visible("It opens 4 more times");
  Ui.Click("Download brewing-guide.pdf");
  runas (Desk) { Assert.Equal(2, Download.Single().Count); }
}
