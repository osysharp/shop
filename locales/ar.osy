  /// placeholders: {words} = words (string)
  accessibleName "{words} (another site)" => "{words} (موقع آخر)";

  // ── ShopFooterSignup ──
  /// ShopFooterSignup · a heading
  /// shown through ShopFooterSignup.heading
  heading "The newsletter" => "النشرة البريدية";

  // ── ShopForgotPassword ──
  /// ShopForgotPassword · a button's label · at most ~19 characters
  /// shown through Button.label
  /// beside: "Email"
  button "Send the link" => "أرسل الرابط";
  /// ShopForgotPassword · message
  /// placeholders: {email} = email (string)
  /// shown through Alert.message
  /// beside: "Back to sign in"
  message "If there is an account for {email}, a link is on its way. It works once, for an hour." => "إن كان هناك حساب لـ {email}، فالرابط في طريقه إليك. يعمل مرة واحدة، لمدة ساعة.";
  /// ShopForgotPassword · a subtitle
  /// shown through PageHead.subtitle
  subtitle "We will mail you a link to choose a new one." => "سنرسل إليك رابطًا لاختيار كلمة مرور جديدة.";
  /// ShopForgotPassword · a title
  /// shown through PageHead.title
  title "Forgotten your password?" => "نسيت كلمة المرور؟";

  // ── ShopGiftCardBalance ──
  /// ShopGiftCardBalance · a control's name for screen readers
  accessibleName "Check a gift card" => "تحقق من بطاقة هدية";
  /// ShopGiftCardBalance · text on the page
  /// placeholders: {answer.Ending} = answer.Ending (string)
  text "Gift card ending {answer.Ending}" => "بطاقة هدية تنتهي بـ {answer.Ending}";
  /// ShopGiftCardBalance · text on the page
  /// placeholders: {answer.ValidUntil} = answer.ValidUntil (string)
  text "To spend until {answer.ValidUntil}." => "صالحة للاستخدام حتى {answer.ValidUntil}.";

  // ── ShopGiftCardMail ──
  /// ShopGiftCardMail · a button's label · at most ~31 characters
  /// shown through EmailButton.label
  button "See what is left on it" => "اعرف الرصيد المتبقي";
  /// ShopGiftCardMail · the preview line an inbox shows beside an email's subject
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {shop.Name} = shop.Name (string)
  /// shown through ShopMailLayout.preview
  mailPreview "A gift card of {MoneyIn} to spend at {shop.Name}" => "بطاقة هدية بقيمة {MoneyIn} للتسوق من {shop.Name}";
  /// ShopGiftCardMail · an email's subject line
  /// placeholders: {Name} = ….Name (string)
  mailSubject "A gift card from {Name}" => "بطاقة هدية من {Name}";
  /// ShopGiftCardMail · an email's subject line
  /// placeholders: {card.FromName} = card.FromName (string), {Name} = ….Name (string)
  mailSubject "{card.FromName} sent you a {Name} gift card" => "أرسل إليك {card.FromName} بطاقة هدية من {Name}";
  /// ShopGiftCardMail · text on the page
  /// shown through EmailHeading.text
  text "A gift card for you" => "بطاقة هدية لك";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {shop.Name} = shop.Name (string)
  /// shown through EmailText.text
  text "Here is a gift card of {MoneyIn} to spend at {shop.Name}." => "إليك بطاقة هدية بقيمة {MoneyIn} للتسوق من {shop.Name}.";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {card.Currency} = card.Currency (string), {card.Currency2} = card.Currency (string), {card.Currency3} = card.Currency (string)
  /// shown through EmailNote.text
  text "The card is in {card.Currency}: it pays for an order in {card.Currency2}. Choose {card.Currency3} at the top of the shop's pages to spend it." => "البطاقة بعملة {card.Currency}: وتُستخدم لدفع طلب بعملة {card.Currency2}. اختر {card.Currency3} أعلى صفحات المتجر لاستخدامها.";
  /// ShopGiftCardMail · text on the page
  /// shown through EmailText.text
  text "The old code no longer works. This is your new one:" => "لم يعد الرمز القديم صالحًا. هذا رمزك الجديد:";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {LocalDay} = LocalDay(…) (string)
  /// shown through EmailNote.text
  /// beside: "See what is left on it"
  text "Type the code at the checkout. It pays for anything in the shop, in part or all of it, and what you do not spend stays on it until {LocalDay}. Keep this mail: the code is not kept anywhere else." => "اكتب الرمز عند إتمام الشراء. يمكنك الدفع بها لأي شيء في المتجر، كليًا أو جزئيًا، وما لا تنفقه يبقى عليها حتى {LocalDay}. احتفظ بهذه الرسالة، فالرمز غير محفوظ في أي مكان آخر.";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {value} = … (string), {old.Last4} = old.Last4 (string), {shop.Currency} = shop.Currency (string), {MoneyIn} = MoneyIn(…) (string), {RateAsSold} = RateAsSold(…) (string)
  /// shown through EmailText.text
  text "We no longer sell in {value}, so your gift card ending {old.Last4} could not be spent. Here it is again in {shop.Currency}: {MoneyIn}, what was left on it at the rate it was bought at ({RateAsSold})." => "لم نعد نبيع بعملة {value}، فلم يكن بالإمكان استخدام بطاقة هديتك المنتهية بـ {old.Last4}. وها هي من جديد بعملة {shop.Currency}: {MoneyIn}، وهو ما تبقّى عليها بسعر الصرف وقت شرائها ({RateAsSold}).";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {shop.Currency} = shop.Currency (string)
  /// shown through EmailHeading.text
  text "Your gift card, now in {shop.Currency}" => "بطاقة هديتك، الآن بعملة {shop.Currency}";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {FirstName} = FirstName(…) (string)
  /// shown through EmailHeading.text
  text "{FirstName}, a gift card for you" => "{FirstName}، بطاقة هدية لك";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {FirstName} = FirstName(…) (string), {shop.Currency} = shop.Currency (string)
  /// shown through EmailHeading.text
  text "{FirstName}, your gift card, now in {shop.Currency}" => "{FirstName}، بطاقة هديتك الآن بعملة {shop.Currency}";
  /// ShopGiftCardMail · text on the page
  /// placeholders: {card.FromName} = card.FromName (string), {MoneyIn} = MoneyIn(…) (string), {shop.Name} = shop.Name (string)
  /// shown through EmailText.text
  text "{card.FromName} has given you a gift card of {MoneyIn} to spend at {shop.Name}." => "أهداك {card.FromName} بطاقة هدية بقيمة {MoneyIn} للتسوق من {shop.Name}.";

  // ── ShopGiftCode ──
  /// ShopGiftCode · a button's label · at most ~20 characters
  /// shown through EmailButton.label
  /// beside: "A code for you"
  button "Go to the shop" => "إلى المتجر";
  /// ShopGiftCode · the preview line an inbox shows beside an email's subject
  /// placeholders: {gives} = gives (string)
  /// shown through ShopMailLayout.preview
  mailPreview "A code for {gives} your next order" => "رمز يمنحك {gives} على طلبك القادم";
  /// ShopGiftCode · an email's subject line
  /// placeholders: {Name} = ….Name (string)
  mailSubject "A code from {Name}" => "رمز من {Name}";
  /// ShopGiftCode · text on the page
  /// shown through EmailHeading.text
  /// beside: "Go to the shop"
  text "A code for you" => "رمز لك";
  /// ShopGiftCode · text on the page
  /// placeholders: {gives} = gives (string), {code} = code (string)
  /// shown through EmailText.text
  /// beside: "A code for you", "Go to the shop"
  text "Here is a code for {gives} your next order: {code}" => "إليك رمزًا يمنحك {gives} على طلبك القادم: {code}";
  /// ShopGiftCode · text on the page
  /// placeholders: {ToString} = until.ToString(…) (DateOnly)
  /// shown through EmailNote.text
  /// beside: "A code for you", "Go to the shop"
  text "Type it at the checkout. It is yours alone, for one order, until {ToString}." => "اكتبه عند إتمام الشراء. وهو لك وحدك، لطلب واحد، حتى {ToString}.";

