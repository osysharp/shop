// Customer accounts: signing up and in through Osysharp.Accounts, a reset by mail in the shop's design, and what a
// customer may and may not see and change. (The sign-in flow's own guarantees — a taken address never said, a first
// proof claiming the account, the timing of a miss — are that kit's, proved by its own tests.)

using Osysharp.Identity;
using Osysharp.Accounts;
using Osysharp.Mail;
using Osysharp.Shop;

[Test(Floor)]
void a_visitor_signs_up_as_a_customer_and_signs_in_again() {
  Assert.NotEqual("", SignUp("New@Example.test ", "long-enough-1", "Nils").Ticket);
  Assert.NotEqual("", SignIn("new@example.test", "long-enough-1").Ticket);   // one account, however the address was typed
  runas (Desk) {
    // The shop's own kind of account, with the customer role and nothing more.
    var nils = ShopAccount.Single(a => a.Email == "new@example.test");
    Assert.Equal("Nils", nils.DisplayName);
    Assert.True(RoleGrant.Any(g => g.Member == nils && g.Role == ShopRole.Customer));
    Assert.False(RoleGrant.Any(g => g.Member == nils && g.Role == ShopRole.Staff));
  }
}

[Test(Floor)]
void signup_refuses_a_short_password_and_something_that_is_not_an_address() {
  Assert.Throws<Exception>(() => SignUp("short@example.test", "short", ""));
  Assert.Throws<Exception>(() => SignUp("no-at-sign", "long-enough-1", ""));
}

// A taken address is never answered with a sentence saying so: the MAIL tells its owner, in the shop's design.
[Test(Floor)]
void signup_for_a_taken_address_says_nothing_and_the_shops_mail_tells_its_owner() {
  Assert.Equal("", SignUp("Maja@Example.test", "not-majas-password", "Somebody").Ticket);
  runas (AuthBootstrap) {
    Assert.Equal(1, OutgoingMail.Count(m => m.To == "maja@example.test" && m.Subject == "You already have an account at Kit Test Shop"));
  }
  runas (Desk) { Assert.Equal(1, ShopAccount.Count(a => a.Email == "maja@example.test")); }
  Assert.NotEqual("", SignIn("maja@example.test", "maja-pass-1").Ticket);
}

// SECURITY-INVARIANT(shop-a-customer-sees-no-other-account): another account — who it is, where it lives — is staff's
// and the sign-in flow's to read, never another customer's: not as a shop account, not through Osysharp.Accounts' `User`
// or Osysharp.Identity's `Principal`, which every signed-in person may otherwise read.
[Test(Floor)]
void a_customer_sees_and_edits_only_their_own_account() {
  runas (Maja) {
    Assert.Equal(1, ShopAccount.Count());
    SaveMyDetails("Maja B", "070", "Storgatan 1", "11122", "Stockholm", "Sweden");
    Assert.Equal("Stockholm", MyShopAccount()!.City);
    Assert.Equal("Maja B", MyShopAccount()!.DisplayName);
    Assert.Null(ShopAccount.FirstOrDefault(a => a.Email == "olle@example.test"));   // not a row she can see at all
    Assert.False(User.Any(a => a.Email == "olle@example.test"));
    Assert.False(Principal.Any(a => a.Email == "olle@example.test"));
  }
  runas (Desk) { Assert.Equal(5, ShopAccount.Count()); }   // staff, a packer, a counter clerk, two customers
}

[Test(Floor)]
void a_customer_cannot_make_themselves_staff_or_set_their_own_hash() {
  runas (Maja) {
    var me = MyShopAccount()!;
    Assert.Denied(() => new RoleGrant { Member = me, Role = ShopRole.Staff });
    Assert.Denied(() => { me.PasswordHash = Security.HashPassword("mine-now"); UnitOfWork.Commit(); });
    Assert.False(AmStaff());
  }
  runas (Desk) { Assert.True(AmStaff()); }
}

[Test(Floor)]
void a_reset_mail_in_the_shops_design_sets_a_new_password_once() {
  Assert.Equal("", RequestPasswordReset("maja@example.test"));
  Assert.Equal("", RequestPasswordReset("nobody@example.test"));   // the same answer, and no mail
  var token = "";
  runas (AuthBootstrap) {
    var mail = OutgoingMail.Single(m => m.To == "maja@example.test");
    Assert.Equal("Reset your password at Kit Test Shop", mail.Subject);
    Assert.Equal(0, OutgoingMail.Count(m => m.To == "nobody@example.test"));
    // A LINK to choose the new password — the Accounts kit's address, which the store's page takes over.
    var text = mail.Text ?? "";
    Assert.Contains("Choose a new password here: http", text);
    token = text.Substring(text.IndexOf("/reset-password/") + 16, 32);
  }
  Assert.NotEqual("", ResetPassword(token, "brand-new-pass"));
  Assert.NotEqual("", SignIn("maja@example.test", "brand-new-pass").Ticket);
  Assert.Equal("", SignIn("maja@example.test", "maja-pass-1").Ticket);
  Assert.Throws<Exception>(() => ResetPassword(token, "another-pass-1"));   // once
}

[Test(Floor)]
void with_no_mail_provider_an_account_mail_waits_in_the_outbox() {
  RequestPasswordReset("olle@example.test");
  runas (AuthBootstrap) {
    var mail = OutgoingMail.Single(m => m.To == "olle@example.test");
    Workflow.Settle(mail);
    Assert.Equal(Osysharp.Mail.MailStatus.Held, mail.Status);
  }
}
