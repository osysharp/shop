  /// ShopPayByLink · text on the page
  /// placeholders: {ToLower} = view.StatusText.ToLower(…) (string)
  text "It is {ToLower}. Write to the shop if you still want it." => "حالته: {ToLower}. راسل المتجر إن كنت لا تزال تريده.";
  /// ShopPayByLink · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string)
