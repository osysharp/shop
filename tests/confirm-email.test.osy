// A proven address (`ShopAccounts(…, requireVerifiedEmail: true)`): no ticket until the address is proven, by the link
// or the code the SHOP's mail carries; sign-up answers a new address and a taken one alike, and the mail says which. The
// flow is Osysharp.Accounts' (its own tests prove the codes' limits and the first proof's claim); these prove the shop's
// screens and mail drive it end to end.

using Osysharp.Accounts;
using Osysharp.Mail;
using Osysharp.Shop;

/// The subject and text of the newest proof mail to `address`, as the shop wrote it — read by the sign-in flow, the one
/// reader the outbox has here.
string ProofTo(string address, bool subject = false) {
  var said = "";
  runas (AuthBootstrap) {
    var mail = OutgoingMail.Where(m => m.To == address && m.Subject.StartsWith("Confirm your address")).OrderByDescending(m => m.CreatedAt).First();
    said = subject ? mail.Subject : mail.Text ?? "";
  }
  return said;
}

/// The six-digit code in the newest proof mail to `address`.
string CodeTo(string address) {
  var text = ProofTo(address);
  return text.Substring(text.IndexOf("where you were asked for it: ") + 29, 6);
}

/// The link's token in the newest proof mail to `address`.
string TokenTo(string address) {
  var text = ProofTo(address);
  return text.Substring(text.IndexOf("/verify-email/") + 14, 32);
}

[Test(Floor)]
void a_new_account_is_not_signed_in_until_its_address_is_proven_and_the_code_signs_it_in() {
  AddressProofRequired.Stub(() => true);
  var signedUp = SignUp("nils@example.test", "long-enough-1", "Nils");
  Assert.Equal("", signedUp.Ticket);
  Assert.True(signedUp.MustVerify);
  // A sign-in answers no ticket either — the right password learns the address must be proven.
  Assert.True(SignIn("nils@example.test", "long-enough-1").MustVerify);
  Assert.False(SignIn("nils@example.test", "wrong-guess").MustVerify);
  // The shop's mail, in its design, carries the code.
  Assert.Equal("Confirm your address at Kit Test Shop", ProofTo("nils@example.test", subject: true));
  Assert.NotEqual("", VerifyEmailCode("Nils@Example.test ", CodeTo("nils@example.test"), "long-enough-1").Ticket);
  Assert.NotEqual("", SignIn("nils@example.test", "long-enough-1").Ticket);
  runas (Desk) { Assert.NotNull(ShopAccount.Single(a => a.Email == "nils@example.test").EmailVerifiedAt); }
}

[Test(Floor)]
void sign_up_answers_a_taken_address_as_a_new_one_and_the_mail_says_which() {
  AddressProofRequired.Stub(() => true);
  Assert.True(SignUp("nils@example.test", "long-enough-1", "Nils").MustVerify);
  Assert.True(SignUp("maja@example.test", "maja-pass-1", "Maja").MustVerify);
  runas (AuthBootstrap) {
    Assert.Equal(1, OutgoingMail.Count(m => m.To == "nils@example.test" && m.Subject.StartsWith("Confirm your address")));
    Assert.Equal(1, OutgoingMail.Count(m => m.To == "maja@example.test" && m.Subject.StartsWith("You already have an account")));
    Assert.Equal(0, OutgoingMail.Count(m => m.To == "maja@example.test" && m.Subject.StartsWith("Confirm your address")));
  }
}

[Test(Floor)]
void a_customer_cannot_mark_their_own_address_proven() {
  runas (Maja) {
    var me = MyShopAccount()!;
    Assert.Denied(() => { me.EmailVerifiedAt = DateTime.UtcNow; UnitOfWork.Commit(); });
  }
}

// ── through the screen ────────────────────────────────────────────────────────────────────────────────────────────

[Test(Floor)]
void signing_up_asks_for_the_code_and_the_code_signs_the_new_customer_in() {
  AddressProofRequired.Stub(() => true);
  Ui.Visit("/sign-up");
  Ui.Fill("Your name", "Nils");
  Ui.Fill("Email", "nils@example.test");
  Ui.Fill("Password", "long-enough-1");
  Ui.Click("Create account");
  Assert.Visible("We have sent a message to nils@example.test. Type the code it gives you — or open its link.");
  Ui.Fill("Code", CodeTo("nils@example.test"));
  Ui.Click("Confirm");
  Assert.Visible("Your account");
  Assert.Visible("nils@example.test");
}

[Test(Floor)]
void signing_in_to_an_unproven_account_asks_for_the_code_the_mail_just_carried() {
  AddressProofRequired.Stub(() => true);
  Ui.Visit("/login");
  Ui.Fill("Email", "maja@example.test");
  Ui.Fill("Password", "maja-pass-1");
  Ui.Click("Sign in");
  Assert.Visible("Confirm your address first — we have mailed a code to maja@example.test.");
  var code = CodeTo("maja@example.test");
  Ui.Fill("Code", code == "000000" ? "111111" : "000000");
  Ui.Click("Confirm");
  Assert.Visible("That code is not right, or it has expired — check the newest message, or ask for a new code.");
  Ui.Fill("Code", code);
  Ui.Click("Confirm");
  Assert.Visible("Your account");
}

[Test(Floor)]
void the_link_page_asks_for_the_password_or_a_new_one() {
  AddressProofRequired.Stub(() => true);
  SignUp("nina@example.test", "strangers-pass-1", "Not Nina");
  Ui.Visit("/verify-email/" + TokenTo("nina@example.test"));
  Assert.Visible("Confirm your address");
  Ui.Fill("New password", "ninas-own-pass-1");
  Ui.Click("Choose it and sign in");
  Assert.Visible("Your account");
  Assert.Equal("", SignIn("nina@example.test", "strangers-pass-1").Ticket);
}
