  runas (new Visitor { Id = "v-sell-ship" }) {
    // 79 kr is €6.98 — €6.95; the shop's 1,000 kr threshold is €88.34 — €87.95, not reached by €10.95.
    Assert.Equal(6.95m, DeliveryChoices("SE").Single(d => d.Id == "flat").Price);
  }
  runas (Desk) {
    SetSoldDeliveryPrice("EUR", "flat", "5");
    SetCurrencySale("EUR", PriceRounding.To95, 20m);
    Assert.Equal(87.95m, SoldCurrenciesOnTheDesk().Single().FreeDeliveryConverted);
  }
  runas (new Visitor { Id = "v-sell-ship" }) {
