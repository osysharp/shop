// What the Boutique look asks of a store, shown: its bag's Check out opens the store's own checkout page
// (`appPage "/checkout"`).

using Osysharp.Shop;

[TestFixture]
void Window() {
  new ShopSettings { Name = "Boutique test store", Currency = "SEK", CurrencySymbol = "kr", SymbolAfter = true, OrderPrefix = "T-" };
  var p = new Product { Name = "Oxford brogue", Slug = "oxford-brogue", Price = 900m };
  new Variant { Product = p, Stock = 3 };
}

[Test(Window)]
void the_looks_check_out_opens_the_stores_checkout_page() {
  runas (new Visitor { Id = "v-boutique" }) {
    Assert.Equal("", AddToBag(Variant.Single(), 1));
    Ui.Visit("/");
    Ui.Click("Bag, 1 item(s)");                       // the shell's bag button: its words, and how many
    Ui.Click("Check out");
    Assert.OnPage("/checkout");
    Assert.Visible("Checkout — shoes made to last");
  }
}
