  /// ShopPayByLink · text on the page
  text "This order can no longer be paid" => "لم يعد من الممكن دفع هذا الطلب";
  /// ShopPayByLink · text on the page
  text "What you sent back" => "ما أرجعته";
  /// ShopPayByLink · text on the page
