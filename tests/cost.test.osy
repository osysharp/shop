// WHAT AN ORDER COSTS — the statements one more order sends to the database, and what a member of staff waits for when
// they place one from the desk. The shop tells what happens to an order as events (Events.osy), which the test app's add-on
// hears (model/addon.osy) as any add-on kit does; a change that makes an order dearer turns these red with both numbers.
//
// ⚑ ONE MORE, NOT THE FIRST: each test places one order before its mark — the first pays what only the first pays (a
//   counter row, a first run of each workflow). A test settles at once the background work a deployed app queues, so
//   these are upper bounds on production.

using Osysharp.Shop;
using Osysharp.Workflow;

void Said(string what, string mark) {
  Log.Information(what + ": " + Cost.StatementsSince(mark) + " statements, " + Cost.RoundTripsSince(mark) + " round trips, "
    + Cost.RequestsSince(mark) + " requests, " + Cost.ServerCallsSince(mark) + " server calls");
}

/// One more order placed at the checkout, and the add-on hearing it.
[Test(Floor)]
void one_more_order_placed_stays_within_its_budget() {
  Buy("v-cost-first", "Loafer", "38", 1);
  Bag("v-cost-next", "Loafer", "39", 1);
  var mark = Cost.Mark();
  var reference = Checkout("v-cost-next").Reference;
  Said("Placed", mark);
  // Read HERE, before the check below: looking as the desk whether the add-on heard is the test's own reading (four
  // statements), not something an order costs — counted with the order it took this past its bound with the checkout
  // itself at 100.
  var statements = Cost.StatementsSince(mark);
  var roundTrips = Cost.RoundTripsSince(mark);
  var requests = Cost.RequestsSince(mark);
  runas (Desk) { Assert.True(AddOnHeard.Any(h => h.What == "placed " + reference)); }
  // A checkout costs about 98 statements: the setup is configuration, worked out once and kept; the shop reads the desk's
  // settings where it uses them; and a unit of work sends a read once while nothing it read has changed. The bound
  // leaves 5% over that.
  Assert.AtMost(103, statements);
  Assert.AtMost(91, roundTrips);
  Assert.Equal(0, requests);
}

/// …paid and sent from the desk, the add-on hearing each.
[Test(Floor)]
void one_more_order_paid_and_sent_stays_within_its_budget() {
  var first = Buy("v-cost-pay-1", "Loafer", "38", 1);
  var next = Buy("v-cost-pay-2", "Loafer", "39", 1);
  runas (Desk) {
    PayAndSend(first);
    var mark = Cost.Mark();
    PayAndSend(next);
    Said("Paid and sent", mark);
    // Read HERE, before the check below, as the placed test does: whether the add-on heard is the test's own reading.
    var statements = Cost.StatementsSince(mark);
    var roundTrips = Cost.RoundTripsSince(mark);
    Assert.True(AddOnHeard.Any(h => h.What == "sent " + next));
    // Paying and sending costs 110 statements (106 measured 2026-11-14, 4 since): 98 of the order's own work — the setup
    // kept, reads sent once a unit of work, a workflow leaving or arming a state reading its slots and their clocks once —
    // and 8 commit positions. Every commit a live page hears reads its place among the app's commits (its transaction id
    // and the commit-position sequence) in its last write round trip, so a page places it by the database and never by a
    // clock (ENG-LIVE-CORRECTNESS-4): needed, one statement and no round trip a commit. And 4 are the settle guard of the
    // two mail runs the span starts (the payment's mail and the dispatch's, each a `ShopMailDelivery` that starts itself
    // on its new row): 2 a start, the run's lock and its status as committed, which keep an operator's cancel during a
    // start from being undone (measured 2026-11-20: 106 → 110, as the desk order below). The bound is that cost. The round
    // trips measure 83: the 79 of before and the guard's 4, each a round trip of its own (the lock is held before the
    // status is read). A run has measured one more or less, so their bound is one over.
    Assert.AtMost(110, statements);
    Assert.AtMost(84, roundTrips);
  }
}

/// An order taken on the phone and placed from the desk's page — one more, after the first: what staff wait for.
[Test(Floor)]
void one_more_order_placed_from_the_desk_stays_within_its_request_budget() {
  Ui.Visit("/login");
  Ui.Fill("Email", "anna@shop.test");
  Ui.Fill("Password", "desk-pass-1");
  Ui.Click("Sign in");
  ReadyAnOrderOnThePhone("first@example.test");
  Ui.Click("Place the order");
  Assert.Visible("is placed and reserved");
  ReadyAnOrderOnThePhone("next@example.test");
  var mark = Cost.Mark();
  Ui.Click("Place the order");
  Assert.Visible("is placed and reserved");
  Said("Placed from the desk", mark);
  // An order placed from the desk costs 7 requests, 3 server calls and about 128 statements: the setup kept, reads sent
  // once a unit of work. Each workflow that starts itself on a new row is one more read when a commit checks for rows
  // still waiting for their run — sent with the others, so it adds no round trip. The 7 are the 3 calls and the desk's
  // two live lists (the orders, and how many are in each stage) each read twice (measured 2026-11-14): the
  // order's first commit is a change the page shows at once, and the call's later commits — the order's workflow setting
  // its status, the bag's delete clearing the order's PlacedFrom — come in one burst the page reads once more when it is
  // quiet. 4 of the statements are the two workflow starts' settle guard (2 each: the run's lock and its status as committed),
  // which keeps an operator's cancel during a start from being undone (CANCEL-RACE CR-6/CR-8, measured 2026-11-18: 124 → 128).
  // Requests and calls held exactly, one statement of margin.
  Assert.AtMost(7, Cost.RequestsSince(mark));
  Assert.AtMost(3, Cost.ServerCallsSince(mark));
  Assert.AtMost(129, Cost.Span("Placed from the desk", mark));
}

/// The desk's New order, filled in to the last click.
void ReadyAnOrderOnThePhone(string email) {
  Ui.Visit("/desk");
  Ui.Click("New order…");
  Ui.Fill("Find a product", "loaf");
  Ui.Click("Search");
  Ui.Click("Add", within: "Loafer (38)");
  Ui.Fill("Name", "Kim Lind");
  Ui.Fill("Email", email);
  Ui.Click("Collect from the shop");
  Ui.Click("Bank transfer");
}
