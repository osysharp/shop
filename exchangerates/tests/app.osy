// The producer's test project for Osysharp.Shop.ExchangeRates — every call to the ECB is stubbed.
app EcbKitTests {
  tests "**/*.test.osy";
  use Osysharp.Shop.ExchangeRates@0 { egress "www.ecb.europa.eu"; }
  use Osysharp.Shop@1 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Identity@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Seo@0;
  use Osysharp.Http;
}
