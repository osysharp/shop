  /// ShopOrderByLink · a label (a field, a list item, a menu entry) · at most ~28 characters
  /// placeholders: {view.PaidOn} = view.PaidOn (string)
  /// shown through Badge.label
  label "Paid · {view.PaidOn}" => "مدفوع · {view.PaidOn}";
  /// ShopOrderByLink · a label (a field, a list item, a menu entry) · at most ~28 characters
  /// placeholders: {view.SentOn} = view.SentOn (string)
  /// shown through Badge.label
  label "Sent · {view.SentOn}" => "أُرسل · {view.SentOn}";
  /// ShopOrderByLink · a link · at most ~26 characters
  /// shown through TextLink.label
  link "Follow your parcel" => "تتبّع طردك";
  /// ShopOrderByLink · message
  /// placeholders: {view.PaymentLabel} = view.PaymentLabel (string)
  /// shown through Alert.message
  message "Waiting for your payment by {view.PaymentLabel}. We mail you once it is through." => "بانتظار دفعتك عبر {view.PaymentLabel}. سنراسلك فور اكتمالها.";
  /// ShopOrderByLink · text on the page
  text "Left to pay" => "المتبقي للدفع";
  /// ShopOrderByLink · text on the page
  /// placeholders: {view.Reference} = view.Reference (string), {view.PlacedOn} = view.PlacedOn (string)
  text "Order {view.Reference} · placed {view.PlacedOn}" => "الطلب {view.Reference} · بتاريخ {view.PlacedOn}";
  /// ShopOrderByLink · text on the page
  /// shown through Strong.text
  text "Send something back" => "إرجاع منتج";
  /// ShopOrderByLink · text on the page
  /// placeholders: {view.Tracking} = view.Tracking (string)
  text "Tracking {view.Tracking}" => "التتبع {view.Tracking}";
  /// ShopOrderByLink · text on the page
  /// placeholders: {view.ReturnsUntil} = view.ReturnsUntil (string)
  /// beside: "Send something back"
  text "You may return what you bought until {view.ReturnsUntil}. We refund what comes back the way you paid." => "يمكنك إرجاع ما اشتريته حتى {view.ReturnsUntil}. ونسترد لك قيمة ما يعود بالطريقة التي دفعت بها.";
  /// ShopOrderByLink · text on the page
  /// shown through said
  text "Your return is started. We mail you how to send it back — put a note with the order number in the parcel." => "بدأ الإرجاع. سنرسل إليك بالبريد طريقة إرساله، وضع داخل الطرد ورقة برقم الطلب.";
  /// ShopOrderByLink · text on the page
