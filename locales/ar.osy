  /// ShopOrderConfirmation · the preview line an inbox shows beside an email's subject
  /// placeholders: {order.Reference} = order.Reference (string), {OrderMoney} = OrderMoney(…) (string)
  /// shown through ShopMailLayout.preview
  mailPreview "Order {order.Reference} is reserved for you — {OrderMoney}" => "الطلب {order.Reference} محجوز لك: {OrderMoney}";
  /// ShopOrderConfirmation · an email's subject line
  /// placeholders: {order.Reference} = order.Reference (string), {Name} = ….Name (string)
  mailSubject "Your order {order.Reference} — {Name}" => "طلبك {order.Reference}، {Name}";
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailText.text
  /// beside: "See your order"
  text "Collection" => "الاستلام";
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailText.text
  /// beside: "See your order"
  text "Delivery" => "التوصيل";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {DigitalConsentWords} = DigitalConsentWords(…) (string)
  /// shown through EmailNote.text
  text "For the downloads you asked: “{DigitalConsentWords}” The links come by mail as soon as it is paid." => "بالنسبة إلى التنزيلات طلبت: “{DigitalConsentWords}” وتصلك الروابط بالبريد فور الدفع.";
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailText.text
  /// beside: "See your order"
  text "It is paid in full with your store credit." => "تم دفعه بالكامل من رصيدك في المتجر.";
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailText.text
  /// beside: "See your order"
  text "It is paid in full." => "تم دفعه بالكامل.";
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailText.text
  /// beside: "See your order"
  text "It is yours to use the moment it is paid." => "يمكنك استخدامه فور دفعه.";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {OrderMoney} = OrderMoney(…) (string), {order.HoldDays} = order.HoldDays (int), {order.Reference} = order.Reference (string), {order.PayInstructions} = order.PayInstructions (string) — {order.HoldDays} is a count: give one text per plural form
  /// shown through EmailText.text
  /// beside: "See your order"
  text "Please pay {OrderMoney} within {order.HoldDays} days, quoting {order.Reference}:\n{order.PayInstructions}" => { zero: "يرجى دفع {OrderMoney} خلال {order.HoldDays} يوم، مع ذكر المرجع {order.Reference}:\n{order.PayInstructions}", one: "يرجى دفع {OrderMoney} خلال {order.HoldDays} يوم، مع ذكر المرجع {order.Reference}:\n{order.PayInstructions}", two: "يرجى دفع {OrderMoney} خلال {order.HoldDays} يوم، مع ذكر المرجع {order.Reference}:\n{order.PayInstructions}", few: "يرجى دفع {OrderMoney} خلال {order.HoldDays} أيام، مع ذكر المرجع {order.Reference}:\n{order.PayInstructions}", many: "يرجى دفع {OrderMoney} خلال {order.HoldDays} يومًا، مع ذكر المرجع {order.Reference}:\n{order.PayInstructions}", other: "يرجى دفع {OrderMoney} خلال {order.HoldDays} يوم، مع ذكر المرجع {order.Reference}:\n{order.PayInstructions}" };
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailHeading.text
  /// beside: "See your order"
  text "Thank you for your order" => "شكرًا لطلبك";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {FirstName} = FirstName(…) (string)
  /// shown through EmailHeading.text
  /// beside: "See your order"
  text "Thank you, {FirstName}" => "شكرًا لك، {FirstName}";
  /// ShopOrderConfirmation · text on the page
  /// shown through EmailText.text
  text "The gift cards are mailed once it is paid — each to whom you named, on the day you chose." => "تُرسل بطاقات الهدية بالبريد بعد الدفع، كل منها إلى من حددته، في اليوم الذي اخترته.";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {order.ExchangeFor.Reference} = order.ExchangeFor.Reference (string)
  /// shown through EmailText.text
  /// beside: "See your order"
  text "This is your exchange for order {order.ExchangeFor.Reference}. We hold it for you and send it once what you are sending back is in; if it costs more than that, we will send you a way to pay the difference." => "هذا هو البديل للطلب {order.ExchangeFor.Reference}. نحجزه لك ونرسله فور وصول ما ترجعه؛ وإن كان أغلى ثمنًا فسنرسل إليك طريقة لدفع الفرق.";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {value} = … (string)
  /// shown through EmailText.text
  /// beside: "See your order"
  text "You are paying with {value}; we will confirm when it is through." => "أنت تدفع عبر {value}؛ وسنؤكد لك عند اكتمال الدفع.";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {value} = … (string)
  /// shown through EmailText.text
  /// beside: "See your order"
  text "{value}: we will mail you when it is ready." => "{value}: سنراسلك عندما يصبح جاهزًا.";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {value} = … (string)
  /// shown through EmailText.text
  /// beside: "See your order"
  text "{value}: we will send it to the address you gave." => "{value}: سنرسله إلى العنوان الذي أدخلته.";
  /// ShopOrderConfirmation · text on the page
  /// placeholders: {value} = … (string), {PickupPointText} = PickupPointText(…) (string)
  /// shown through EmailText.text
  /// beside: "See your order"
  text "{value}: we will send it to {PickupPointText}, where you collect it." => "{value}: سنرسله إلى {PickupPointText}، حيث تستلمه.";

