// The producer's test project for Osysharp.Shop.Discounts — a small shop with the add-on listed, as a store lists it.
app DiscountsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Shop.Discounts@0;
  use Osysharp.Shop@0 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Payments@0;
  use Osysharp.Delivery@0;
  use Osysharp.Seo@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
}
