  /// shown through Dialog.subtitle
  /// also in ShopOrderByLink
  subtitle "Pack it with the order number inside. We refund what comes back once it arrives." => "Packa den med ordernumret i paketet. Vi betalar tillbaka det som kommer tillbaka när det har kommit fram.";
