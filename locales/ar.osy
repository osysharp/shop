  /// ShopPasswordResetMail · text on the page
  /// placeholders: {link} = link (string)
  /// shown through EmailText.text
  /// beside: "Reset your password", "Choose a new password", "The link works once, for an hour. If you did not ask, ignore this mail and nothing changes."
  text "Choose a new password here: {link}" => "اختر كلمة مرور جديدة من هنا: {link}";
  /// ShopPasswordResetMail · text on the page
  /// shown through EmailHeading.text
