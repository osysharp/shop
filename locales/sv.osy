  /// shown through Dialog.title
  title "Gift card ending {showing.Ending}" => "Presentkort som slutar på {showing.Ending}";
  /// DeskGiftCards · a title
  /// shown through Dialog.title
  title "Issue a gift card" => "Utfärda ett presentkort";

