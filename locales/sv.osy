  /// shown through StatusWords()
  text "Refund processing" => "Återbetalning pågår";
  /// StatusWords · text on the page
  /// shown through StatusWords()
  text "Refunded" => "Återbetald";
  /// StatusWords · text on the page
  /// shown through StatusWords()
  text "Voided" => "Makulerad";

  // ── StorefrontBagPanel ──
  /// StorefrontBagPanel · a button's label · at most ~11 characters
  /// shown through IconButton.label
  /// also in StorefrontMenuDrawer
  /// also in DeskOrderActions
  /// also in DeskCampaignEditor
  button "Close" => "Stäng";

  // ── TakeBackAtCounter ──
  /// TakeBackAtCounter · an error message
  /// shown through Exception
  error "Choose what is coming back, and how many." => "Välj vad som lämnas tillbaka, och hur många.";

  // ── TellErased ──
  /// TellErased · an error message
  /// placeholders: {Key} = a.Key(…) (string), {ex.Message} = ex.Message (string)
  /// shown through Exception
  error "The erasure did not run: the shop add-on '{Key}' could not erase what it keeps of the customer ({ex.Message}). Nothing was erased — try again once it can." => "Raderingen kördes inte: butikstillägget '{Key}' kunde inte radera det som det sparar om kunden ({ex.Message}). Inget raderades. Försök igen när det går.";

  // ── UndoReturnLine ──
  /// UndoReturnLine · an error message
  /// shown through Exception
  error "That return has already been received." => "Den returen har redan tagits emot.";

  // ── UpdateLocation ──
  /// UpdateLocation · an error message
  /// shown through Exception
  error "The default location holds the shop's stock — it stays in use." => "Standardplatsen har butikens lager, så den används alltid.";

  // ── UpdateProduct ──
  /// UpdateProduct · an error message
  /// shown through Exception
  error "Add at least one size before listing it — a product with none cannot be bought." => "Lägg till minst en storlek innan den läggs ut. En produkt utan storlekar går inte att köpa.";

  // ── VatLines ──
  /// VatLines · text on the page
  /// placeholders: {v.Percent} = v.Percent (decimal), {OrderMoney} = OrderMoney(…) (string)
  /// shown through VatLines()
  text "Of which VAT ({v.Percent} %): {OrderMoney}" => "Varav moms ({v.Percent} %): {OrderMoney}";

  // ── VerifyEmailPage (/verify-email/{token}) ──
  /// VerifyEmailPage · /verify-email/{token} · a title
  /// shown through [Title]
  /// also in ShopConfirmAddress
  title "Confirm your address" => "Bekräfta din adress";

  // ── VoidGiftCard ──
  /// VoidGiftCard · an error message
  /// placeholders: {card.Status.Label} = card.Status.Label (string)
  /// shown through Exception
  error "That card is {card.Status.Label} already." => "Det kortet är redan {card.Status.Label}.";

  // ── WholesaleProblem ──
  /// WholesaleProblem · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {MoneyIn2} = MoneyIn(…) (string)
  /// shown through WholesaleProblem()
  text "An order on your price list is at least {MoneyIn}. Add {MoneyIn2} more." => "En beställning på din prislista är minst {MoneyIn}. Lägg till {MoneyIn2} till.";
  /// WholesaleProblem · text on the page
  /// placeholders: {VariantName} = VariantName(…) (string), {min} = min (int), {have} = have (int) — {min} is a count: give one text per plural form
  /// shown through WholesaleProblem()
  text "{VariantName} is sold to you by {min} or more. Your bag has {have}." => { one: "{VariantName} säljs till dig i {min} eller fler. Din påse har {have}.", other: "{VariantName} säljs till dig i {min} eller fler. Din påse har {have}." };

  // ── WithdrawalText ──
  /// WithdrawalText · text on the page
  /// placeholders: {days} = days (int), {value} = … (string), {WithdrawalAddressee} = WithdrawalAddressee(…) (string), {value2} = … (string), {order.Reference} = order.Reference (string) — {days} is a count: give one text per plural form
  /// shown through WithdrawalText()
  text "\n\nYour right of withdrawal: you may cancel this purchase within {days} days of receiving the goods, without giving a reason — return it from your order's page, or tell us{value}\n\nWithdrawal form (fill in and send only if you want to withdraw):\n  To: {WithdrawalAddressee}{value2}\n  I hereby give notice that I withdraw from my contract of sale of the following goods: order {order.Reference}\n  Ordered on / received on:\n  Name:\n  Address:\n  Date:" => { one: "\n\nDin ångerrätt: du kan ångra köpet inom {days} dag från att du tagit emot varorna, utan att ange något skäl — returnera det från orderns sida, eller meddela oss{value}\n\nÅngerblankett (fyll i och skicka endast om du vill ångra köpet):\n  Till: {WithdrawalAddressee}{value2}\n  Jag meddelar härmed att jag frånträder mitt avtal om köp av följande varor: order {order.Reference}\n  Beställdes den / mottogs den:\n  Namn:\n  Adress:\n  Datum:", other: "\n\nDin ångerrätt: du kan ångra köpet inom {days} dagar från att du tagit emot varorna, utan att ange något skäl — returnera det från orderns sida, eller meddela oss{value}\n\nÅngerblankett (fyll i och skicka endast om du vill ångra köpet):\n  Till: {WithdrawalAddressee}{value2}\n  Jag meddelar härmed att jag frånträder mitt avtal om köp av följande varor: order {order.Reference}\n  Beställdes den / mottogs den:\n  Namn:\n  Adress:\n  Datum:" };
  /// WithdrawalText · text on the page
  /// placeholders: {shop.ContactEmail} = shop.ContactEmail (string)
  /// shown through WithdrawalText()
  text " at {shop.ContactEmail}." => " på {shop.ContactEmail}.";

  // ── __BlockSpec_Banner ──
  /// __BlockSpec_Banner · text on the page
  /// also in __BlockSpec_Announcement
  /// also in __BlockSpec_ProductRow
  text "The link goes to" => "Länken leder till";

