// The staff's side of the shop, as components — drawn on the kit's own staff pages (DeskPages.osy), which stand in the
// store's shell, or placed by a store on a page of its own. Every panel is the kit's logic and the store's theme.

namespace Osysharp.Shop;

using Osysharp.Identity;
using Osysharp.Ui;
using Osysharp.Storage;
using Osysharp.MarkdownEditor;
using Osysharp.MailingLists;

/// The whole desk: one tab per job — the kit's own page (`ShopDeskPage`, /staff/desk), or anywhere a store places it.
[Composable]
[Authorize(IsShopPacker)]
public component ShopDesk() {
  string tab = "orders";
  bool staff = false;
  on mount {
    staff = IsStaffMember();
    // The words staff wrote into the mails before they held regions move onto the regions the first time a member of
    // staff opens the desk — nothing after that (mail/Words.osy).
    if (staff) { MoveShopMailWordsOntoBlocks(); }
  }
  action Show(string which) { tab = which; }

  render {
    Stack(gap: 6, w: "100%") {
      // A packer gets orders out of the door — the rest of the desk (money, stock, customers, settings) is staff's.
      if (staff) {
        Tabs() {
          Tab("Orders", selected: tab == "orders", onPress: () => Show("orders"));
          Tab("Figures", selected: tab == "figures", onPress: () => Show("figures"));
          Tab("Products", selected: tab == "products", onPress: () => Show("products"));
          Tab("Stock", selected: tab == "stock", onPress: () => Show("stock"));
          Tab("Returns", selected: tab == "returns", onPress: () => Show("returns"));
          Tab("Customers", selected: tab == "customers", onPress: () => Show("customers"));
          Tab("Wholesale", selected: tab == "wholesale", onPress: () => Show("wholesale"));
          Tab("Gift cards", selected: tab == "gift-cards", onPress: () => Show("gift-cards"));
          Tab("Mail", selected: tab == "mail", onPress: () => Show("mail"));
          Tab("Newsletters", selected: tab == "newsletters", onPress: () => Show("newsletters"));
          Tab("Subscribers", selected: tab == "subscribers", onPress: () => Show("subscribers"));
          Tab("Settings", selected: tab == "settings", onPress: () => Show("settings"));
        }
      }
      if (tab == "orders") { DeskOrders(); }
      if (staff && tab == "figures") { DeskFigures(); }
      if (staff && tab == "products") { DeskProducts(); }
      if (staff && tab == "stock") { DeskStock(); }
      if (staff && tab == "returns") { DeskReturns(); }
      if (staff && tab == "customers") { DeskCustomers(); }
      if (staff && tab == "wholesale") { DeskWholesale(); }
      if (staff && tab == "gift-cards") { DeskGiftCards(() => Show("customers")); }
      if (staff && tab == "mail") { DeskOutbox(); }
      if (staff && tab == "newsletters") { DeskCampaigns(); }
      if (staff && tab == "subscribers") { DeskMailingLists(); }
      if (staff && tab == "settings") { DeskSettings(); }
    }
  }
}

/// Every order, newest first: who, what, how it is paid and delivered, where it stands — and what can be done to it.
[Composable]
[Authorize(IsShopPacker)]
public component DeskOrders() {
  live var shop = ShopSettings.FirstOrDefault();
  live var orders = Order.Include(o => o.Lines).Include(o => o.Contact).Include(o => o.Location).OrderByDescending(o => o.PlacedAt).ToList();
  string stage = "all";
  // An order acted on stays in view — its buttons greyed now — until a tab is chosen again, so a row does not vanish
  // under the hand that just moved it.
  List<Guid> kept = [];
  action Show(string which) { stage = which; kept = orders.Where(o => InOrderStage(o, which)).Select(o => o.Id).ToList(); }
  // An order taken on the phone or at the counter — staff's, as it is money.
  bool staff = false;
  bool taking = false;
  on mount { staff = IsStaffMember(); }
  action Take() { taking = true; }
  action Taken() { taking = false; }

  render {
    Stack(gap: 4) {
      if (staff) { Row(justify: Justify.End) { Button("New order…", onPress: Take, tone: Tone.Primary); } }
      if (taking) { DeskNewOrder(onDone: Taken); }
      DeskPickups();
      DeskLabels();
      // Where the orders stand — each tab counts what is in it, so the day's work shows before it is opened.
      Tabs() {
        foreach (var t in OrderStageTabs()) {
          Tab($"{t.Label} · {orders.Count(o => InOrderStage(o, t.Key))}", selected: stage == t.Key, onPress: () => Show(t.Key));
        }
      }
      if (orders.Count == 0) { EmptyState("No orders yet", body: "An order appears here the moment it is placed."); }
      foreach (var order in orders) {
        if (InOrderStage(order, stage) || kept.Contains(order.Id)) {
        Card(order.Reference, subtitle: $"{order.PlacedAt.ToString("d MMM, HH:mm")} · {StatusText(order)}") {
          Stack(gap: 3) {
            foreach (var c in order.Contact) { Text($"{c.Name} · {c.Email}", color: Colors.TextMuted); }
            // Where it is picked, for a shop with more than one place (Locations.osy).
            if (order.Location != null) { Text($"Picked at {order.Location!.Name}", color: Colors.TextMuted, fontSize: FontSize.Label); }
            DeskAgeLine(order);
            foreach (var line in order.Lines) {
              Row(justify: Justify.Between, gap: 3) {
                Text($"{line.Quantity} × {line.ProductName}{(line.VariantLabel == null ? "" : " (" + line.VariantLabel + ")")}");
                Text(MoneyIn(line.Price * line.Quantity, order.Currency, shop), color: Colors.TextMuted);
              }
            }
            Divider();
            Row(justify: Justify.Between, align: Align.Center, gap: 3, wrap: Wrapping.Wrap) {
              Text($"{order.PaymentLabel ?? order.PaymentMethod} · {order.DeliveryLabel ?? order.Fulfilment.Label}"
                   + (order.Tracking == null ? "" : $" · {order.Tracking}"), color: Colors.TextMuted);
              Strong(MoneyIn(order.Total, order.Currency, shop));
            }
            DeskOrderActions(order, stage: stage);
          }
        }
        }
      }
    }
  }
}

/// What whoever packs and hands over an order must know about the buyer's age: PROVED by an identity provider (no ID
/// to ask for; a carrier still makes its own check at the door), or only DECLARED (check ID when it is handed over).
/// Nothing for an order with no age.
[Composable]
public component DeskAgeLine(Order order) {
  render {
    if (order.AgeChecked > 0) {
      if (order.AgeVerifiedBy != null) {
        Alert($"Age {order.AgeChecked}+ verified with {order.AgeVerifiedBy}"
              + (order.AgeVerifiedAt == null ? "." : $" on {order.AgeVerifiedAt.Value.ToString("d MMM")}.")
              + (order.Fulfilment == Fulfilment.Deliver ? " No ID to ask for. The carrier makes its own check at the door."
                                                         : " No ID to ask for."), tone: Tone.Success);
      } else {
        Alert($"Age {order.AgeChecked}+ declared, not verified. Check ID when it is handed over.", tone: Tone.Warning);
      }
    }
  }
}

/// Whether an order has no move left for this person — what Details says instead of an empty row.
public bool NothingToDo(Order order, bool staff) {
  if (staff && (order.Status == OrderStatus.Reserved || order.Status == OrderStatus.RefundRequested)) { return false; }
  return !(IsBeingPrepared(order) || IsSent(order));
}

/// The carrier's pickups: those coming, and asking one to come for today's parcels. Shown only when a carrier the
/// shop sends with could be asked.
[Composable]
[Authorize(IsShopPacker)]
public component DeskPickups() {
  live var pickups = ShopPickup.OrderBy(p => p.Date).ToList();
  // With locations: the carrier comes to one of them — the ones that send parcels.
  live var senders = StockLocation.Where(l => l.Active && l.Ships).OrderBy(l => l.Rank).ToList();
  StockLocation? from = null;
  List<PickupCarrier> carriers = [];
  bool asking = false;
  PickupCarrier? carrier = null;
  DateOnly? day = null;
  int parcels = 1;
  string problem = "";
  string done = "";
  on mount { carriers = PickupCarriers(); }
  action Ask() {
    asking = true; problem = ""; done = "";
    carrier = carriers.Count > 0 ? carriers[0] : null;
    day = DateOnly.FromDateTime(DateTime.UtcNow);
    from = senders.Count > 0 ? senders[0] : null;
    parcels = carrier == null ? 1 : Math.Max(1, ParcelsFor(carrier.Key, from).Count);
  }
  action Close() { asking = false; }
  action Book() {
    problem = "";
    if (day == null || carrier == null) { problem = "Choose the carrier and the day."; return; }
    try { var p = BookPickup(carrier.Key, day.Value, parcels, from); done = $"Booked for {p.Date.ToString("d MMM")} — reference {p.Reference}."; }
    catch (Exception ex) { problem = ex.Message; }
  }
  render {
    if (carriers.Count > 0) {
      Row(justify: Justify.Between, align: Align.Center, gap: 3, wrap: Wrapping.Wrap, label: "Pickups") {
        Stack(gap: 0) {
          foreach (var p in pickups) {
            if (p.Date >= DateOnly.FromDateTime(DateTime.UtcNow)) {
              Text($"{p.CarrierName ?? p.Carrier} comes {p.Date.ToString("ddd d MMM")} for {p.Parcels} parcel(s) · {p.Reference}", color: Colors.TextMuted, fontSize: FontSize.Label);
            }
          }
        }
        Button("Book a pickup…", onPress: Ask);
      }
    }
    if (asking) {
      Dialog("Book a pickup", onDismiss: Close, subtitle: "The carrier comes to the shop for the day's parcels.") {
        Stack(gap: 4) {
          if (done == "") {
            Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(150px, 1fr))", gap: 3) {
              Dropdown("Carrier", value: carrier, options: carriers) { c => Text(c.Name); }
              if (senders.Count > 1) { Dropdown("From", value: from, options: senders) { l => Text(l.Name); } }
              DatePicker("Day", value: day);
              NumberField("Parcels", value: parcels, min: 1);
            }
            if (problem != "") { Alert(problem, tone: Tone.Danger); }
            Row(gap: 3, justify: Justify.End) {
              Button("Not now", onPress: Close);
              Button("Book it", onPress: Book, tone: Tone.Primary);
            }
          } else {
            Alert(done, tone: Tone.Success);
            Row(justify: Justify.End) { Button("Done", onPress: Close); }
          }
        }
      }
    }
  }
}

/// The day's labels, printed together: the packed parcels a carrier labels, booked in one press, and every label made
/// today listed with its order — so a packer prints the batch at once rather than order by order. Each label stays on
/// its order's Details too.
///
/// ⚑ A LIST OF PDFs, NOT ONE PDF. Joining the carriers' PDFs into one document needs a PDF reader/merger, and the kits
///   have a writer only (Osysharp.PdfWriter writes text and rules) — so each label opens on its own, in order.
[Composable]
[Authorize(IsShopPacker)]
public component DeskLabels() {
  List<Order> packed = [];
  List<LabelToPrint> labels = [];
  List<string> problems = [];
  bool open = false;
  bool sending = false;
  on mount { packed = ParcelsToLabel(); }
  action Open() { open = true; problems = []; packed = ParcelsToLabel(); labels = TodaysLabels(); }
  action Close() { open = false; }
  action Send() {
    sending = true;
    problems = SendParcels();
    packed = ParcelsToLabel();
    labels = TodaysLabels();
    sending = false;
  }
  render {
    Row(justify: Justify.End, align: Align.Center, gap: 3, label: "Labels") {
      if (packed.Count > 0) { Text($"{packed.Count} packed parcel(s) to label", color: Colors.TextMuted, fontSize: FontSize.Label); }
      Button("Print labels…", onPress: Open);
    }
    if (open) {
      Dialog("Print the day's labels", onDismiss: Close,
             subtitle: "Book the packed parcels with their carriers, then open each label in turn and print it. The customers are mailed as each is sent.") {
        Stack(gap: 4) {
          if (packed.Count > 0) {
            Stack(gap: 2, label: "Packed, not yet sent") {
              SectionLabel($"Packed, not yet sent — {packed.Count}");
              foreach (var o in packed) { Text($"{o.Reference} · {o.DeliveryLabel ?? ""}", color: Colors.TextMuted); }
              Row(justify: Justify.End) {
                Button(packed.Count == 1 ? "Send it and make the label" : $"Send all {packed.Count} and make the labels", onPress: Send,
                       tone: Tone.Primary, disabled: sending);
              }
            }
          }
          foreach (var p in problems) { Alert(p, tone: Tone.Danger); }
          Stack(gap: 2, label: "Today's labels") {
            SectionLabel($"Today's labels — {labels.Count}");
            if (labels.Count == 0) { Text("No labels yet today.", color: Colors.TextMuted); }
            foreach (var l in labels) {
              Row(justify: Justify.Between, align: Align.Center, gap: 3, wrap: Wrapping.Wrap, label: l.Reference) {
                Stack(gap: 0) {
                  Strong($"{l.Reference} · {l.Name}");
                  Text($"{l.Delivery}{(l.Tracking == "" ? "" : " · " + l.Tracking)}", color: Colors.TextMuted, fontSize: FontSize.Label);
                }
                TextLink("Label (PDF)", to: l.Link);
              }
            }
          }
          Row(justify: Justify.End) { Button("Done", onPress: Close); }
        }
      }
    }
  }
}

/// One tab of the orders list.
public class OrderStageTab {
  public string Key = "";
  public string Label = "";
}

/// The stages the desk's orders list is filtered by, in the order the work goes.
public List<OrderStageTab> OrderStageTabs() {
  return [
    new OrderStageTab { Key = "all", Label = "All" },
    new OrderStageTab { Key = "waiting", Label = "Waiting for payment" },
    new OrderStageTab { Key = "paid", Label = "To pick" },
    new OrderStageTab { Key = "picking", Label = "Being picked" },
    new OrderStageTab { Key = "packed", Label = "Packed" },
    new OrderStageTab { Key = "sent", Label = "Sent" },
    new OrderStageTab { Key = "delivered", Label = "Delivered" },
    new OrderStageTab { Key = "closed", Label = "Closed" },
  ];
}

/// Whether an order is in a stage of the list.
public bool InOrderStage(Order o, string stage) {
  return stage == "all"
      || (stage == "waiting" && o.Status == OrderStatus.Reserved)
      || (stage == "paid" && o.Status == OrderStatus.Paid)
      || (stage == "picking" && o.Status == OrderStatus.Picking)
      || (stage == "packed" && o.Status == OrderStatus.Packed)
      || (stage == "sent" && o.Status == OrderStatus.Fulfilled)
      || (stage == "delivered" && o.Status == OrderStatus.Delivered)
      || (stage == "closed" && (o.Status == OrderStatus.Cancelled || o.Status == OrderStatus.Lapsed || o.Status == OrderStatus.Unavailable
                                || o.Status == OrderStatus.Refunded || o.Status == OrderStatus.Voided
                                || o.Status == OrderStatus.RefundRequested || o.Status == OrderStatus.RefundProcessing));
}

/// What staff can do to one order, for the stage of the list it is shown in. A store puts it in its own order row, so
/// the row's look is the store's and the steps are the kit's.
///
/// ⚑ THE ROW CARRIES ONE STAGE'S WORK, THE DIALOG CARRIES EVERYTHING. `stage` "all" (the default) shows
///   only Details; a stage shows its own buttons, always all of them and always in the same order, greyed out on a
///   row they do not apply to — the same button sits in the same column down the list. Details lists every move the
///   order can make now, whatever the stage, with its tracking and label.
public component DeskOrderActions(Order order, string stage = "all") {
  List<string> byHand = [];
  bool staff = false;
  List<PackingLine> packing = [];
  List<string> packed = [];
  string slip = "";
  OrderLine? partLine = null;
  int partQty = 1;
  string partReason = "";
  bool partRestock = true;
  string partNote = "";
  string asking = "";
  string reason = "";
  string tracking = "";
  string problem = "";
  string label = "";

  on mount { byHand = PaidByHandKeys(); staff = IsStaffMember(); }
  action Ask(string what) { asking = what; reason = ""; tracking = ""; problem = ""; }
  action Close() { asking = ""; }
  action Received() { MarkPaid(order, ""); }
  action Send() {
    // Sent: the order's details open on its label and tracking, which is what the packer reaches for next.
    try { label = MarkSent(order, tracking); packing = PackingList(order); packed = []; slip = ""; asking = "details"; }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Collected() { MarkSent(order, ""); }
  action Picking() { StartPicking(order); }
  action Packed() { MarkPacked(order); }
  action Arrived() { MarkDelivered(order); }
  action ConfirmCancel() {
    try { CancelOrder(order, reason); asking = ""; }
    catch (Exception ex) { problem = ex.Message; }
  }
  action ConfirmRefund() {
    try { RefundOrder(order, reason, true); asking = ""; }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Label() { label = LabelLink(order); }
  action Details() { packing = PackingList(order); packed = []; slip = ""; asking = "details"; }
  action Tick(string id) {
    if (packed.Contains(id)) { packed.Remove(id); } else { packed.Add(id); }
  }
  action Slip() { slip = PackingSlipLink(order); }
  action RefundSome() {
    problem = "";
    partNote = "";
    if (partLine == null) { problem = "Choose what to refund."; return; }
    try {
      RefundPart(partLine, partQty, partReason, partRestock);
      partNote = $"Refunded {partQty} × {partLine.ProductName}.";
      packing = PackingList(order);
      partLine = null; partQty = 1; partReason = "";
    }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Row(gap: 2, justify: Justify.End, align: Align.Center) {
      // Money — taking it, calling an order off, giving it back — is staff's; a packer is not shown it at all.
      var collect = order.Fulfilment == Fulfilment.Collect;
      if (stage == "waiting" && staff) {
        Button("Payment received", onPress: Received, disabled: !(order.Status == OrderStatus.Reserved && byHand.Contains(order.PaymentMethod)));
        Button("Cancel…", onPress: () => Ask("cancel"), disabled: order.Status != OrderStatus.Reserved);
      }
      if (stage == "paid") { Button("Start picking", onPress: Picking, disabled: order.Status != OrderStatus.Paid); }
      if (stage == "picking") {
        Button(collect ? "Ready to collect" : "Packed", onPress: Packed, disabled: order.Status != OrderStatus.Picking);
      }
      if (stage == "paid" || stage == "picking" || stage == "packed") {
        if (collect) { Button("Collected", onPress: Collected, tone: Tone.Primary, disabled: !IsBeingPrepared(order)); }
        else { Button("Send…", onPress: () => Ask("send"), tone: Tone.Primary, disabled: !IsBeingPrepared(order)); }
      }
      if (stage == "sent") {
        Button("Delivered", onPress: Arrived, disabled: !(order.Status == OrderStatus.Fulfilled && !collect));
      }
      // A refund that was requested but never reached the provider can be pressed again — it refunds once.
      if (staff && stage != "all" && stage != "waiting") {
        Button("Refund…", onPress: () => Ask("refund"),
               disabled: !(IsBeingPrepared(order) || IsSent(order) || order.Status == OrderStatus.RefundRequested));
      }
      // Every row ends in the same button.
      Button("Details", onPress: Details, tone: Tone.Ghost);
    }
    if (asking == "details") {
      Dialog($"{order.Reference}", onDismiss: Close,
             subtitle: $"{StatusText(order)} · placed {order.PlacedAt.ToString("d MMM, HH:mm")} · {order.DeliveryLabel ?? order.Fulfilment.Label}") {
        Stack(gap: 5) {
          Stack(gap: 2) {
            SectionLabel($"To pack — {packing.Sum(l => l.Quantity)} item(s)");
            foreach (var l in packing) {
              Row(gap: 3, align: Align.Center, label: l.Name) {
                if (l.Photo != "") { Image(src: File.Url(l.Photo), alt: l.Name, w: "48px", aspectRatio: "3 / 4", objectFit: ObjectFit.Cover); }
                Button(packed.Contains(l.LineId) ? "✓" : " ", onPress: () => Tick(l.LineId), size: Size.Sm,
                       tone: packed.Contains(l.LineId) ? Tone.Success : Tone.Default);
                Box(grow: 1) { Text($"{l.Quantity} × {l.Name}{(l.Variant == "" ? "" : " — " + l.Variant)}"); }
                if (l.Sku != "") { Text(l.Sku, color: Colors.TextMuted, fontSize: FontSize.Label); }
              }
            }
            if (packing.Count > 0 && packed.Count == packing.Count) { Alert("Everything is in the parcel.", tone: Tone.Success); }
            DeskAgeLine(order);
          }
          // Every move the order can make now, whatever tab it was opened from.
          Stack(gap: 2, label: "What can be done now") {
            SectionLabel("What can be done now");
            Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
              if (staff && order.Status == OrderStatus.Reserved) {
                if (byHand.Contains(order.PaymentMethod)) { Button("Payment received", onPress: Received); }
                Button("Cancel…", onPress: () => Ask("cancel"));
              }
              if (order.Status == OrderStatus.Paid) { Button("Start picking", onPress: Picking); }
              if (order.Status == OrderStatus.Picking) {
                Button(order.Fulfilment == Fulfilment.Collect ? "Ready to collect" : "Packed", onPress: Packed);
              }
              if (IsBeingPrepared(order)) {
                if (order.Fulfilment == Fulfilment.Collect) { Button("Collected", onPress: Collected, tone: Tone.Primary); }
                else { Button("Send…", onPress: () => Ask("send"), tone: Tone.Primary); }
              }
              if (order.Status == OrderStatus.Fulfilled && order.Fulfilment == Fulfilment.Deliver) {
                Button("Delivered", onPress: Arrived);
              }
              if (staff && (IsBeingPrepared(order) || IsSent(order) || order.Status == OrderStatus.RefundRequested)) {
                Button("Refund…", onPress: () => Ask("refund"));
              }
              if (IsSent(order)) {
                if (order.TrackingUrl != null) { TextLink("Track", to: order.TrackingUrl); }
                if (label != "") { TextLink("Label (PDF)", to: label); }
                else if (order.LabelPath != null) { Button("Label", onPress: Label, tone: Tone.Ghost); }
              }
              if (NothingToDo(order, staff)) { Text("Nothing — this order is closed.", color: Colors.TextMuted); }
            }
          }
          // Where it goes — and a new address, before it goes out.
          DeskOrderAddress(order);
          Stack(gap: 1) {
            SectionLabel("Payment and delivery");
            Text($"{order.PaymentLabel ?? order.PaymentMethod}{(order.PaidAt == null ? " — not paid yet" : " — paid " + order.PaidAt.Value.ToString("d MMM"))}");
            Text($"{order.DeliveryLabel ?? order.Fulfilment.Label}{(order.Tracking == null ? "" : " · " + order.Tracking)}", color: Colors.TextMuted);
          }
          if (staff) { DeskPayLink(order); }
          if (order.PaidAt != null) { OrderProgress(order); }
          // Notes, and everything that happened to it — above the refunds, where whoever packs it reads a note in time.
          DeskOrderHistory(order);
          // Part of it back: returned at the counter or by post — or, before it goes out, a piece that turned out
          // not to be there. The rest of the order carries on.
          if (staff && (IsBeingPrepared(order) || IsSent(order))) {
            Stack(gap: 2) {
              SectionLabel(IsSent(order) ? "Refund part of it — a return" : "Refund part of it — not in stock after all");
              Dropdown("Item", value: partLine, options: order.Lines.ToList(), placeholder: "Choose") {
                l => Text($"{l.Quantity} × {l.ProductName}{(l.VariantLabel == null ? "" : " — " + l.VariantLabel)}");
              }
              Row(gap: 3, align: Align.End, wrap: Wrapping.Wrap) {
                Box(w: "120px") { NumberField("How many", value: partQty, min: 1); }
                Box(grow: 1) { Field("Why", value: partReason, placeholder: IsSent(order) ? "Too small" : "Not on the shelf"); }
              }
              if (IsSent(order)) { Checkbox("It goes back in stock", value: partRestock); }
              if (problem != "") { Alert(problem, tone: Tone.Danger); }
              if (partNote != "") { Alert(partNote, tone: Tone.Success); }
              Row(justify: Justify.End) { Button("Refund these", onPress: RefundSome, tone: Tone.Danger); }
            }
          }
          Row(gap: 3, justify: Justify.End) {
            if (slip == "") { Button("Packing slip (PDF)", onPress: Slip); }
            else { TextLink("Open the packing slip", to: slip); }
            Button("Close", onPress: Close);
          }
        }
      }
    }
    if (asking == "send") {
      Dialog($"Send {order.Reference}", onDismiss: Close,
             subtitle: $"{order.DeliveryLabel ?? "Delivery"}. A carrier that books parcels makes the label and the tracking number; "
                     + "for one you post yourself, add its tracking number if it has one. The customer is mailed either way.") {
        Stack(gap: 4) {
          Field("Tracking number (optional)", value: tracking, placeholder: "Left empty when the carrier gives one");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Not yet", onPress: Close);
            Button("Send it", onPress: Send, tone: Tone.Primary);
          }
        }
      }
    }
    if (asking == "cancel") {
      Dialog($"Cancel {order.Reference}?", onDismiss: Close,
             subtitle: "The reservation ends and its goods go back on sale.") {
        Stack(gap: 4) {
          Field("Reason", value: reason, placeholder: "Customer changed their mind", hint: "Kept on the order, for whoever reads it next.");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Keep it", onPress: Close);
            Button("Cancel order", onPress: ConfirmCancel, tone: Tone.Danger);
          }
        }
      }
    }
    if (asking == "refund") {
      Dialog($"Refund {order.Reference}?", onDismiss: Close,
             subtitle: byHand.Contains(order.PaymentMethod)
               ? "Recorded as refunded and the goods go back on sale. Send the money back yourself."
               : $"The money goes back through {order.PaymentLabel ?? order.PaymentMethod}, and the goods go back on sale.") {
        Stack(gap: 4) {
          Field("Reason", value: reason, placeholder: "Customer returned it", hint: "Kept on the order, for whoever reads it next.");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Keep it", onPress: Close);
            Button("Refund", onPress: ConfirmRefund, tone: Tone.Danger);
          }
        }
      }
    }
  }
}

/// The last 30 days in numbers, what sells, what is looked at, what sits — and marking things down to clear them.
[Composable]
[Authorize(IsShopStaff)]
public component DeskFigures() {
  live var shop = ShopSettings.FirstOrDefault();
  live var sales = Sale.Where(s => s.State == SaleState.Live).OrderBy(s => s.EndsAt).ToList();
  ShopTotals totals = null;
  List<ProductFigures> top = [];
  List<ProductFigures> viewed = [];
  List<Product> slow = [];
  Product marking = null;
  int percent = 30;
  int days = 14;
  string problem = "";

  on mount { Load(); }
  action Load() {
    totals = TotalsFor(30);
    top = TopSellers(30, 8);
    viewed = MostViewed(30, 8);
    slow = SlowMovers(60, 8);
  }
  action AskMarkDown(Product p) { marking = p; percent = 30; days = 14; problem = ""; }
  action Close() { marking = null; }
  action ConfirmMarkDown() {
    try { MarkDown(marking, percent, days); marking = null; slow = SlowMovers(60, 8); }
    catch (Exception ex) { problem = ex.Message; }
  }
  action End(Sale s) { EndMarkdown(s.Product); }

  render {
    Stack(gap: 8) {
      if (totals == null) { Spinner(); }
      if (totals != null) {
        Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(160px, 1fr))", gap: 4) {
          Metric("Orders, 30 days", text: $"{totals.Orders}");
          Metric("Revenue", text: Money(totals.Revenue, shop));
          Metric("Average order", text: Money(totals.AverageOrder, shop));
          Metric("Returns", text: $"{totals.Returns} · {Money(totals.Refunded, shop)} back");
          if (totals.CostedPercent == 0) { Metric("Margin", text: "—"); }
          else { Metric($"Margin · {Math.Round(totals.MarginPercent, 0)}% of sales", text: Money(Math.Round(totals.Margin, 0), shop)); }
        }
        if (totals.CostedPercent == 0) {
          Text("The margin appears once the sizes you sell have a cost price — on each product, or imported from a spreadsheet.",
               color: Colors.TextMuted, fontSize: FontSize.Label);
        }
        if (totals.CostedPercent > 0 && totals.CostedPercent < 100) {
          Text($"The margin is over the {totals.CostedPercent}% of sales whose sizes have a cost price — add the rest on each product.",
               color: Colors.TextMuted, fontSize: FontSize.Label);
        }
      }
      Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(300px, 1fr))", gap: 6) {
        Card("Best sellers", subtitle: "Units sold, last 30 days") {
          Stack(gap: 2) {
            if (top.Count == 0) { Text("Nothing sold yet.", color: Colors.TextMuted); }
            foreach (var f in top) {
              Row(justify: Justify.Between, gap: 3) {
                Text(f.Product.Name);
                Text($"{f.Units} · {Money(f.Revenue, shop)}", color: Colors.TextMuted);
              }
            }
          }
        }
        Card("Most looked at", subtitle: "Page views, and how many became sales") {
          Stack(gap: 2) {
            if (viewed.Count == 0) { Text("No views counted yet.", color: Colors.TextMuted); }
            foreach (var f in viewed) {
              Row(justify: Justify.Between, gap: 3) {
                Text(f.Product.Name);
                Text($"{f.Views} views · {f.Conversion}% bought", color: Colors.TextMuted);
              }
            }
          }
        }
      }
      Card("Sitting on the shelf", subtitle: "Listed, in stock, not sold in 60 days — mark them down to clear them") {
        Stack(gap: 2) {
          if (slow.Count == 0) { Text("Everything is moving.", color: Colors.TextMuted); }
          foreach (var p in slow) {
            Row(justify: Justify.Between, align: Align.Center, gap: 3) {
              Text($"{p.Name} · {Money(p.Price, shop)}");
              Button("Mark down…", onPress: () => AskMarkDown(p), size: Size.Sm);
            }
          }
        }
      }
      Card("On sale now") {
        Stack(gap: 2) {
          if (sales.Count == 0) { Text("Nothing is marked down.", color: Colors.TextMuted); }
          foreach (var s in sales) {
            Row(justify: Justify.Between, align: Align.Center, gap: 3) {
              Text($"{s.Product.Name} · {s.Percent}% off until {s.EndsAt.ToString("d MMM")}");
              Button("End sale", onPress: () => End(s), size: Size.Sm);
            }
          }
        }
      }
    }
    if (marking != null) {
      Dialog($"Mark down {marking.Name}", onDismiss: Close,
             subtitle: "The price drops everywhere at once, the old one shows struck through, and it goes back on the end date.") {
        Stack(gap: 4) {
          NumberField("Percent off", value: percent, min: 5, max: 90, unit: "%");
          NumberField("For how many days", value: days, min: 1, max: 90);
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Not now", onPress: Close);
            Button("Mark down", onPress: ConfirmMarkDown, tone: Tone.Primary);
          }
        }
      }
    }
  }
}

/// Every size of every listed product with what is on the shelf and what is held for orders — per location, when the
/// shop has more than one — and the ways to change it: a count with a reason, and a transfer between locations. Below
/// it, the locations themselves and the transfers on the road.
[Composable]
[Authorize(IsShopStaff)]
public component DeskStock() {
  live var locations = StockLocation.OrderBy(l => l.Rank).ToList();
  // Worked out on the server (the default location's share is the totals less the rest), and asked again after every
  // change made here.
  List<StockRow> rows = [];
  StockRow? adjusting = null;
  StockLocation? at = null;
  int change = 1;
  StockReason reason = StockReason.Received;
  string note = "";
  string problem = "";
  StockRow? moving1 = null;
  StockLocation? from = null;
  StockLocation? to = null;
  int quantity = 1;

  on mount { rows = StockByLocation(); }
  action Refresh() { rows = StockByLocation(); }

  action Ask(StockRow r) {
    adjusting = r; change = 1; reason = StockReason.Received; note = ""; problem = "";
    at = locations.Count == 0 ? null : r.At.Select(a => a.Location).FirstOrDefault();
  }
  action Close() { adjusting = null; moving1 = null; }
  action Confirm() {
    try {
      if (locations.Count == 0) { AdjustStock(adjusting!.Variant!, change, reason, note); }
      else { AdjustStockAt(at, adjusting!.Variant!, change, reason, note); }
      adjusting = null;
      rows = StockByLocation();
    }
    catch (Exception ex) { problem = ex.Message; }
  }
  action AskMove(StockRow r) {
    moving1 = r; quantity = 1; note = ""; problem = "";
    from = r.At.OrderByDescending(a => a.Stock).Select(a => a.Location).FirstOrDefault();
    to = locations.FirstOrDefault(l => from == null || l.Id != from!.Id);
  }
  action ConfirmMove() {
    if (from == null || to == null) { problem = "Choose where it goes from and to."; return; }
    try { SendTransfer(moving1!.Variant!, from!, to!, quantity, note); moving1 = null; rows = StockByLocation(); }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 6) {
      Stack(gap: 1) {
        Text(locations.Count == 0 ? "Lowest first. Held units belong to orders that are not paid yet."
                                  : "Lowest first, per location. Held units belong to orders that are not paid yet.",
             color: Colors.TextMuted, pb: 3);
        foreach (var r in rows) {
          Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, wrap: Wrapping.Wrap, label: r.Name) {
            Stack(gap: 0, minW: "0") {
              Text(r.Name);
              Text($"{r.Stock} on the shelf{(r.Reserved > 0 ? $" · {r.Reserved} held" : "")}{(r.InTransit > 0 ? $" · {r.InTransit} on the way" : "")}",
                   color: r.Stock == 0 ? Colors.Danger : Colors.TextMuted, fontSize: FontSize.Label);
              if (r.At.Count > 0) {
                Text(string.Join(" · ", r.At.Select(a => $"{a.Name} {a.Stock}{(a.Reserved > 0 ? $" ({a.Reserved} held)" : "")}")),
                     color: Colors.TextMuted, fontSize: FontSize.Label);
              }
            }
            Row(gap: 2) {
              if (locations.Count > 1) { Button("Move…", onPress: () => AskMove(r), size: Size.Sm); }
              Button("Adjust…", onPress: () => Ask(r), size: Size.Sm);
            }
          }
        }
      }
      DeskTransfers(onChange: Refresh);
      DeskLocations(onChange: Refresh);
    }
    if (adjusting != null) {
      Dialog($"Stock of {adjusting!.Name}", onDismiss: Close,
             subtitle: locations.Count == 0 ? $"{adjusting!.Stock} on the shelf now. A negative number takes away."
                                            : "Counted at one location. A negative number takes away.") {
        Stack(gap: 4) {
          if (locations.Count > 0) { Dropdown("Where", value: at, options: locations) { l => Text(l.Name); } }
          NumberField("Change by", value: change, min: -999, max: 999);
          Dropdown("Why", value: reason);
          Field("Note (optional)", value: note, placeholder: "Delivery 14 from the supplier");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: Close);
            Button("Save", onPress: Confirm, tone: Tone.Primary);
          }
        }
      }
    }
    if (moving1 != null) {
      Dialog($"Move {moving1!.Name}", onDismiss: Close,
             subtitle: "It leaves now and is sold from nowhere until it is received.") {
        Stack(gap: 4) {
          Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(160px, 1fr))", gap: 3) {
            Dropdown("From", value: from, options: locations) { l => Text(l.Name); }
            Dropdown("To", value: to, options: locations) { l => Text(l.Name); }
            NumberField("How many", value: quantity, min: 1);
          }
          Field("Note (optional)", value: note, placeholder: "The Tuesday van");
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: Close);
            Button("Send it", onPress: ConfirmMove, tone: Tone.Primary);
          }
        }
      }
    }
  }
}

/// Stock on the road between locations: received when it arrives, called off when it never went. Nothing for a shop
/// with none on the way.
[Composable]
[Authorize(IsShopStaff)]
public component DeskTransfers(Action onChange) {
  live var open = StockTransfer.Include(t => t.Variant.Product).Include(t => t.From).Include(t => t.To)
    .Where(t => t.Status == TransferStatus.InTransit).OrderBy(t => t.SentAt).ToList();
  string problem = "";
  action Receive(StockTransfer t) { problem = ""; try { ReceiveTransfer(t); onChange(); } catch (Exception ex) { problem = ex.Message; } }
  action CallOff(StockTransfer t) { problem = ""; try { CancelTransfer(t); onChange(); } catch (Exception ex) { problem = ex.Message; } }
  render {
    if (open.Count > 0) {
      Stack(gap: 2, label: "On the way") {
        SectionLabel("On the way");
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        foreach (var t in open) {
          Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, wrap: Wrapping.Wrap) {
            Stack(gap: 0, minW: "0") {
              Text($"{t.Quantity} × {VariantName(t.Variant)}");
              Text($"{t.From.Name} to {t.To.Name}, sent {t.SentAt.ToString("d MMM")}{(t.Note == null ? "" : ". " + t.Note)}",
                   color: Colors.TextMuted, fontSize: FontSize.Label);
            }
            Row(gap: 2) {
              Button("Call off", onPress: () => CallOff(t), size: Size.Sm);
              Button("Received", onPress: () => Receive(t), tone: Tone.Primary, size: Size.Sm);
            }
          }
        }
      }
    }
  }
}

/// The shop's locations — what each does (sends parcels, hands orders over), where it is, and the order a parcel is
/// picked in — and a new one. A shop with none sees one line saying what adding one does.
[Composable]
[Authorize(IsShopStaff)]
public component DeskLocations(Action onChange) {
  live var locations = StockLocation.OrderBy(l => l.Rank).ToList();
  live var packers = RoleGrant.Include(g => g.Member).Where(g => g.Role == ShopRole.Packer).ToList();
  live var clerks = RoleGrant.Include(g => g.Member).Where(g => g.Role == ShopRole.Counter).ToList();
  live var limits = ShopRoleLimit.Include(l => l.Location).ToList();
  StockLocation? editing = null;
  bool adding = false;
  string name = "";
  string code = "";
  string street = "";
  string postCode = "";
  string city = "";
  string hours = "";
  bool ships = true;
  bool collects = false;
  bool active = true;
  string problem = "";

  action New() { adding = true; editing = null; name = ""; code = ""; street = ""; postCode = ""; city = ""; hours = ""; ships = true; collects = false; active = true; problem = ""; }
  action Edit(StockLocation l) {
    editing = l; adding = false; name = l.Name; code = l.Code; street = l.Street ?? ""; postCode = l.PostCode ?? ""; city = l.City ?? "";
    hours = l.Hours ?? ""; ships = l.Ships; collects = l.Collects; active = l.Active; problem = "";
  }
  action Close() { editing = null; adding = false; }
  action Save() {
    problem = "";
    try {
      if (adding) { AddLocation(name, code, street, postCode, city, "", ships, collects); }
      else { UpdateLocation(editing!, name, street, postCode, city, hours, ships, collects, active); }
      editing = null; adding = false;
      onChange();
    }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Up(StockLocation l) { MoveLocation(l, -1); onChange(); }
  action Down(StockLocation l) { MoveLocation(l, 1); onChange(); }
  action Limit(RoleGrant g, StockLocation? l) {
    problem = "";
    try { LimitPacker(g.Member, l); } catch (Exception ex) { problem = ex.Message; }
  }
  action LimitClerk(RoleGrant g, StockLocation? l) {
    problem = "";
    try { LimitCounter(g.Member, l); } catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 2, label: "Locations") {
      Row(justify: Justify.Between, align: Align.Center, gap: 3) {
        SectionLabel("Locations");
        Button("Add a location…", onPress: New, size: Size.Sm);
      }
      if (locations.Count == 0) {
        Text("All the stock is in one place. Add a warehouse, a second counter or a pop-up to keep stock at each, send parcels from one and hand orders over at another.",
             color: Colors.TextMuted);
      }
      foreach (var l in locations) {
        Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, wrap: Wrapping.Wrap, label: l.Name) {
          Stack(gap: 0, minW: "0") {
            Row(gap: 2, align: Align.Center) {
              Text(l.Name, fontWeight: FontWeight.Semibold);
              if (l.IsDefault) { Badge("Default"); }
              if (!l.Active) { Badge("Not in use"); }
            }
            Text(LocationDoes(l) + " · " + LocationLine(l), color: Colors.TextMuted, fontSize: FontSize.Label);
          }
          Row(gap: 2) {
            Button("Up", onPress: () => Up(l), size: Size.Sm);
            Button("Down", onPress: () => Down(l), size: Size.Sm);
            Button("Edit…", onPress: () => Edit(l), size: Size.Sm);
          }
        }
      }
      if (locations.Count > 1) {
        Text("A parcel is picked at the first location in this list that sends parcels and holds all of it.", color: Colors.TextMuted, fontSize: FontSize.Label);
      }
      // Who sells at which counter (Counter.osy): a clerk limited to one sells there alone, and reads only what it hands over.
      if (locations.Count > 0 && clerks.Count > 0) {
        Stack(gap: 2, pt: 3, label: "Counter staff") {
          SectionLabel("Counter staff");
          foreach (var g in clerks) {
            var at = limits.FirstOrDefault(x => x.Member.Id == g.Member.Id && x.Role == ShopRole.Counter);
            Row(justify: Justify.Between, align: Align.Center, gap: 3, wrap: Wrapping.Wrap) {
              Text(g.Member.DisplayName != "" ? g.Member.DisplayName : g.Member.Email);
              Row(gap: 2, wrap: Wrapping.Wrap) {
                Button("Every counter", onPress: () => LimitClerk(g, null), size: Size.Sm, tone: at == null ? Tone.Primary : Tone.Default);
                foreach (var l in locations) {
                  Button(l.Name, onPress: () => LimitClerk(g, l), size: Size.Sm, tone: at != null && at!.Location.Id == l.Id ? Tone.Primary : Tone.Default);
                }
              }
            }
          }
        }
      }
      if (locations.Count > 0 && packers.Count > 0) {
        Stack(gap: 2, pt: 3) {
          SectionLabel("Packers");
          foreach (var g in packers) {
            var at = limits.FirstOrDefault(x => x.Member.Id == g.Member.Id && x.Role == ShopRole.Packer);
            Row(justify: Justify.Between, align: Align.Center, gap: 3, wrap: Wrapping.Wrap) {
              Text(g.Member.DisplayName != "" ? g.Member.DisplayName : g.Member.Email);
              Row(gap: 2, wrap: Wrapping.Wrap) {
                Button("Every location", onPress: () => Limit(g, null), size: Size.Sm, tone: at == null ? Tone.Primary : Tone.Default);
                foreach (var l in locations) {
                  Button(l.Name, onPress: () => Limit(g, l), size: Size.Sm, tone: at != null && at!.Location.Id == l.Id ? Tone.Primary : Tone.Default);
                }
              }
            }
          }
        }
      }
      if (problem != "" && editing == null && !adding) { Alert(problem, tone: Tone.Danger); }
    }
    if (editing != null || adding) {
      Dialog(adding ? "A new location" : name, onDismiss: Close,
             subtitle: adding ? "The shop's stock stays where it is. Move some here with a transfer, or count it in." : "") {
        Stack(gap: 4) {
          Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(180px, 1fr))", gap: 3) {
            Field("Name", value: name, placeholder: "The warehouse");
            if (adding) { Field("Short code", value: code, placeholder: "warehouse", hint: "Letters and digits. It never changes."); }
            Field("Street", value: street);
            Field("Postcode", value: postCode);
            Field("City", value: city);
            if (!adding) { Field("Opening hours", value: hours, placeholder: "Weekdays 10–18"); }
          }
          Checkbox("Sends parcels from here", value: ships);
          Checkbox("Customers collect orders here", value: collects);
          if (!adding && editing != null && !editing!.IsDefault) { Checkbox("In use", value: active); }
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: Close);
            Button("Save", onPress: Save, tone: Tone.Primary);
          }
        }
      }
    }
  }
}

/// What a location does, in a few words — "Sends parcels and hands orders over".
public string LocationDoes(StockLocation l) {
  if (l.Ships && l.Collects) { return "Sends parcels and hands orders over"; }
  if (l.Ships) { return "Sends parcels"; }
  if (l.Collects) { return "Hands orders over"; }
  return "Keeps stock only";
}

/// Returns and exchanges, newest first: accept one (the carrier's return label is booked and mailed, or the customer is
/// told where to post it), receive it — its money back, as store credit, or the exchange sent out — or decline it; and
/// the ones already settled.
[Composable]
[Authorize(IsShopStaff)]
public component DeskReturns() {
  live var shop = ShopSettings.FirstOrDefault();
  live var returns = ReturnRequest.Include(r => r.Lines).Include(r => r.Order).Include(r => r.Replacement.Lines)
    .OrderByDescending(r => r.RequestedAt).ToList();
  // With locations: where goods that come back go on a shelf — none chosen, where each order was picked.
  live var locations = StockLocation.Where(l => l.Active).OrderBy(l => l.Rank).ToList();
  StockLocation? backTo = null;
  ReturnRequest declining = null;
  string reason = "";
  string problem = "";
  // What the desk last heard about one return's label — asked of the carrier when pressed, never on every render.
  string labelFor = "";
  ReturnLabelView? label = null;

  action Receive(ReturnRequest r, bool restock) {
    problem = "";
    try {
      if (backTo == null) { ReceiveReturn(r, restock); } else { ReceiveReturnAt(r, restock, backTo); }
    }
    catch (Exception ex) { problem = ex.Message; }
  }
  action ReceiveAsCredit(ReturnRequest r) {
    problem = "";
    try { ReceiveReturnAsCredit(r, true); }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Accept(ReturnRequest r) {
    problem = "";
    try { AcceptReturn(r); labelFor = r.Id.ToString(); label = ReturnLabelOf(r, false); }
    catch (Exception ex) { problem = ex.Message; }
  }
  action WhereIsIt(ReturnRequest r) { labelFor = r.Id.ToString(); label = ReturnLabelOf(r, true); }
  action AskDecline(ReturnRequest r) { declining = r; reason = ""; }
  action Close() { declining = null; }
  action ConfirmDecline() { DeclineReturn(declining, reason); declining = null; }

  render {
    Stack(gap: 4) {
      if (problem != "") { Alert(problem, tone: Tone.Danger); }
      if (returns.Count == 0) { EmptyState("No returns", body: "When a customer sends something back, or asks for an exchange, it waits here for the parcel."); }
      if (locations.Count > 1 && returns.Count > 0) {
        Box(maxW: "320px") {
          Dropdown("Back in stock at", value: backTo, options: locations, placeholder: "Where each order was picked") { l => Text(l.Name); }
        }
      }
      foreach (var r in returns) {
        Card($"{r.Order.Reference} · {ReturnStatusText(r)}", subtitle: $"{r.RequestedAt.ToString("d MMM yyyy")} · {ReturnKindText(r)}") {
          Stack(gap: 2) {
            foreach (var l in r.Lines) {
              Text($"{l.Quantity} × {l.Line.ProductName}{(l.Line.VariantLabel == null ? "" : " (" + l.Line.VariantLabel + ")")}{(l.Reason == null ? "" : ": " + l.Reason)}");
            }
            if (r.Replacement != null) {
              Text($"Instead: {string.Join(", ", r.Replacement!.Lines.ToList().Select(x => $"{x.Quantity} × {x.ProductName}{(x.VariantLabel == null ? "" : " (" + x.VariantLabel + ")")}"))}, order {r.Replacement!.Reference} ({StatusText(r.Replacement!).ToLower()})",
                   color: Colors.TextSecondary);
            }
            if (r.Status == ReturnStatus.Requested) { Text(ReturnLabelLine(r), color: Colors.TextMuted, fontSize: FontSize.Label); }
            if (labelFor == r.Id.ToString() && label != null) {
              Row(gap: 3, wrap: Wrapping.Wrap, align: Align.Center) {
                if (label!.Where != "") { Badge(label!.Where); }
                if (label!.LabelLink != "") { TextLink("The return label (PDF)", to: label!.LabelLink); }
                if (label!.TrackingUrl != "") { TextLink("Follow it", to: label!.TrackingUrl); }
              }
            }
            if (r.Status == ReturnStatus.Refunded) { Text(DeskReturnOutcome(r, shop), color: Colors.TextMuted); }
            if (r.Problem != null) { Text(r.Problem, color: Colors.TextMuted); }
            if (r.Status == ReturnStatus.Requested) {
              Row(gap: 2, justify: Justify.End, wrap: Wrapping.Wrap) {
                Button("Decline…", onPress: () => AskDecline(r), size: Size.Sm);
                if (r.ParcelNumber == null && r.DropOffCode == null && r.Order.Fulfilment != Fulfilment.Collect) {
                  Button(r.AcceptedAt == null ? "Accept and send a label" : "Try the label again", onPress: () => Accept(r), size: Size.Sm);
                }
                if (r.ParcelNumber != null) { Button("Where is it?", onPress: () => WhereIsIt(r), size: Size.Sm); }
                Button("Received — not resellable", onPress: () => Receive(r, false), size: Size.Sm);
                if (r.Replacement == null && r.Order.Account != null && !r.AsCredit) {
                  Button("Received — as store credit", onPress: () => ReceiveAsCredit(r), size: Size.Sm);
                }
                Button(r.Replacement != null ? "Received — send the exchange" : "Received — back in stock", onPress: () => Receive(r, true),
                       tone: Tone.Primary, size: Size.Sm);
              }
            }
          }
        }
      }
    }
    if (declining != null) {
      Dialog($"Decline the return for {declining.Order.Reference}", onDismiss: Close,
             subtitle: "The customer is mailed this reason. An exchange's new order is called off with it.") {
        Stack(gap: 4) {
          Field("Reason", value: reason, placeholder: "It has been worn.");
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: Close);
            Button("Decline", onPress: ConfirmDecline, tone: Tone.Danger);
          }
        }
      }
    }
  }
}

/// Where a return stands, as the desk heads it — a settled exchange or credit is not "Refunded".
public string ReturnStatusText(ReturnRequest r) {
  if (r.Status != ReturnStatus.Refunded) { return r.Status.Label; }
  if (r.Replacement != null && r.Replacement!.ExchangeCredit > 0) { return "Exchanged"; }
  if (r.CreditAmount > 0 && r.CreditAmount >= r.Amount) { return "Given as store credit"; }
  return r.Status.Label;
}

/// What a return is, in a word or two: for the money, for store credit, or an exchange.
public string ReturnKindText(ReturnRequest r) {
  if (r.NotSent) { return "Not sent"; }
  if (r.Replacement != null) { return "Exchange"; }
  return r.AsCredit ? "For store credit" : "For the money";
}

/// Where a waiting return's label stands, in one line — from what the return records, without asking the carrier.
public string ReturnLabelLine(ReturnRequest r) {
  if (r.ParcelNumber != null || r.DropOffCode != null) {
    return "Label sent" + (r.ParcelNumber == null ? "" : $", tracking {r.ParcelNumber}") + (r.DropOffCode == null ? "" : $", code {r.DropOffCode}");
  }
  if (r.NoLabel != null) { return $"No label: {r.NoLabel} The customer was mailed where to post it."; }
  if (r.Order.Fulfilment == Fulfilment.Collect) { return "Collected at the shop, so it comes back over the counter."; }
  return r.AcceptedAt == null ? "Not accepted yet. Accepting books the return label." : "Accepted.";
}

/// What came of a settled return, for the desk.
public string DeskReturnOutcome(ReturnRequest r, ShopSettings? shop) {
  var credit = r.CreditAmount > 0 ? $"{MoneyIn(r.CreditAmount, r.Order.Currency, shop)} to store credit" : "";
  if (r.Replacement != null && r.Replacement!.ExchangeCredit > 0) {
    var due = AmountDue(r.Replacement!);
    return $"{MoneyIn(r.Replacement!.ExchangeCredit, r.Order.Currency, shop)} set against {r.Replacement!.Reference}"
      + (due > 0 ? $", {MoneyIn(due, r.Order.Currency, shop)} to pay" : "") + (credit == "" ? "" : $", {credit}");
  }
  if (r.CreditAmount >= r.Amount && r.Amount > 0) { return $"Given as {credit}"; }
  return $"Refunded {MoneyIn(r.Amount - r.CreditAmount, r.Order.Currency, shop)}" + (credit == "" ? "" : $", {credit}");
}

/// The shop's customers — who they are and what they have bought — and one customer's orders.
[Composable]
[Authorize(IsShopStaff)]
public component DeskCustomers() {
  live var shop = ShopSettings.FirstOrDefault();
  string search = "";
  List<CustomerRow> rows = [];
  ShopAccount showing = null;
  List<Order> orders = [];

  on mount { Find(); }
  action Find() { rows = Customers(search); }
  action Show(ShopAccount a) {
    showing = a; orders = OrdersOf(a); dataLink = ""; problem = ""; confirming = false;
    credit = CreditOf(a); granting = false; grantAmount = 0; grantReason = "";
  }
  // Their store credit, and giving them some — with the reason they are mailed.
  StoreCreditView credit = new StoreCreditView();
  bool granting = false;
  decimal grantAmount = 0;
  string grantReason = "";
  action AskGrant() { granting = true; problem = ""; }
  action Grant() {
    problem = "";
    try { GrantCredit(showing, grantAmount, grantReason); credit = CreditOf(showing); granting = false; }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Close() { showing = null; }
  string dataLink = "";
  string problem = "";
  bool confirming = false;
  action Copy() { dataLink = CustomerDataLink(showing); }
  action AskErase() { confirming = true; problem = ""; }
  action Erase() {
    try { EraseCustomer(showing); confirming = false; showing = null; Find(); }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    Stack(gap: 3) {
      Row(gap: 2, align: Align.End) {
        Box(grow: 1) { Field("Search by name or email", value: search, onEnter: Find); }
        Button("Search", onPress: Find);
      }
      if (rows.Count == 0) { Text("No customers yet.", color: Colors.TextMuted); }
      foreach (var c in rows) {
        Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, label: c.Account.Email) {
          Stack(gap: 0, minW: "0") {
            Text(ShopNameOf(c.Account));
            Text($"{c.Account.Email} · {c.Orders} orders · {Money(c.Spent, shop)}", color: Colors.TextMuted, fontSize: FontSize.Label);
          }
          Button("Orders", onPress: () => Show(c.Account), size: Size.Sm);
        }
      }
    }
    if (showing != null) {
      Dialog(ShopNameOf(showing), onDismiss: Close,
             subtitle: $"{showing.Email}{(showing.City == null ? "" : " · " + showing.City)}") {
        Stack(gap: 2) {
          if (orders.Count == 0) { Text("No orders.", color: Colors.TextMuted); }
          foreach (var o in orders) {
            Row(justify: Justify.Between, gap: 3) {
              Text($"{o.Reference} · {o.PlacedAt.ToString("d MMM yyyy")} · {o.Status.Label}");
              Text(MoneyIn(o.Total, o.Currency, shop), color: Colors.TextMuted);
            }
          }
          Row(justify: Justify.Between, align: Align.Center, gap: 3, pt: 3, borderTW: 1, border: Colors.Border, label: "Store credit") {
            Text($"Store credit: {Money(credit.Balance, shop)}", fontWeight: FontWeight.Semibold);
            if (!granting) { Button("Give store credit…", onPress: AskGrant, size: Size.Sm); }
          }
          foreach (var l in credit.Lines.Take(5)) {
            Text($"{l.At.ToString("d MMM yyyy")} · {l.What} {(l.Amount > 0 ? "+" : "−")}{Money(Math.Abs(l.Amount), shop)}{(l.Note == "" ? "" : " · " + l.Note)}",
                 color: Colors.TextMuted, fontSize: FontSize.Label);
          }
          if (granting) {
            Stack(gap: 3) {
              DecimalField(label: "Amount", value: grantAmount);
              Field("Reason — they are mailed it", value: grantReason, placeholder: "Your parcel came a week late.");
              Row(gap: 3, justify: Justify.End) {
                Button("Give it", onPress: Grant, tone: Tone.Primary, size: Size.Sm);
              }
            }
          }
          // A customer's rights over their data, when they ask the shop rather than doing it themselves.
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End, pt: 3, wrap: Wrapping.Wrap) {
            if (dataLink == "") { Button("Copy of their data", onPress: Copy, size: Size.Sm); }
            else { TextLink("Open their data (JSON)", to: dataLink); }
            if (!confirming) { Button("Erase…", onPress: AskErase, tone: Tone.Danger, size: Size.Sm); }
            else { Button("Erase them for good", onPress: Erase, tone: Tone.Danger, size: Size.Sm); }
          }
        }
      }
    }
  }
}

/// Everything the shop has mailed, newest first — and what is waiting, when no mail provider is set up.
[Composable]
[Authorize(IsShopStaff)]
public component DeskOutbox() {
  live var mails = ShopMail.OrderByDescending(m => m.CreatedAt).Take(100).ToList();
  ShopMail reading = null;

  action Read(ShopMail m) { reading = m; }
  action Close() { reading = null; }

  render {
    Stack(gap: 1) {
      DeskMailPreview();
      Text("Sent and waiting", fontSize: FontSize.Subhead, fontWeight: FontWeight.Semibold, pt: 4);
      if (mails.Any(m => m.Status == MailStatus.Held)) {
        Alert("Mail is not being sent: set the ResendApiKey secret and the shop's \"Mail from\" address. Until then it waits here.",
              tone: Tone.Warning);
      }
      if (mails.Count == 0) { Text("Nothing has been mailed yet.", color: Colors.TextMuted); }
      foreach (var m in mails) {
        Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, label: m.Subject) {
          Stack(gap: 0, minW: "0") {
            Text(m.Subject);
            Text($"to {m.To} · {m.CreatedAt.ToString("d MMM, HH:mm")} · {m.Status.Label}", color: Colors.TextMuted, fontSize: FontSize.Label);
          }
          Button("Read", onPress: () => Read(m), size: Size.Sm);
        }
      }
    }
    if (reading != null) {
      Dialog(reading.Subject, onDismiss: Close, subtitle: $"to {reading.To}") {
        // The mail as it was sent — the HTML the customer's mail client showed, in a frame of its own; a mail
        // written as text alone shows its text.
        if (reading.Html != null) {
          Frame(reading.Html, title: $"The mail: {reading.Subject}", h: 560);
        } else {
          Text(reading.Text, whiteSpace: WhiteSpace.PreWrap);
        }
      }
    }
  }
}

/// What the shop's mail looks like, rendered for a real recent order — the words and the design a customer gets, in
/// the store's own theme and in any template the store overrides — in any language the shop speaks.
///
/// ⚑ WHAT THE MAILS SAY AROUND THE ORDER IS ARRANGED WHERE THE PAGES ARE: the confirmation's,
///   on its way's, collected's and refunded's words — and a picture, a quote or a button staff place beside them — are
///   the region of each mail, arranged at the page desk (`Osysharp.Pages`) with a draft, a publish and a preview of the
///   mail itself. This tab shows what goes out.
[Composable]
[Authorize(IsShopStaff)]
public component DeskMailPreview() {
  live var recent = Order.OrderByDescending(o => o.PlacedAt).Take(6).ToList();
  string kind = "confirmation";
  // The language the preview is rendered in.
  string language = "";
  Guid? picked = null;
  string html = "";
  string subject = "";

  on mount { language = Session.Language; }

  action Render() {
    if (picked == null) { return; }
    var mail = ShopMailPreview(kind, picked.Value, language);
    html = mail.Html;
    subject = mail.Subject;
  }
  action Show(string which) {
    kind = which;
    Render();
  }
  action Pick(Order o) {
    picked = o.Id;
    Render();
  }
  action InLanguage(string l) {
    language = l;
    Render();
  }

  render {
    Stack(gap: 3) {
      Text("What the mail looks like", fontSize: FontSize.Subhead, fontWeight: FontWeight.Semibold);
      Text("The words each mail says around the order — and a picture, a quote or a button beside them — are arranged where the site's pages are, in each language.",
           color: Colors.TextMuted, fontSize: FontSize.Label);
      Tabs() {
        foreach (var k in ShopMailPreviewKinds()) {
          Tab(k.Label, selected: kind == k.Key, onPress: () => Show(k.Key));
        }
      }
      if (recent.Count == 0) {
        EmptyState("No orders yet", body: "A preview is rendered for a real order — once one is placed, pick it here.");
      } else {
        Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap) {
          Text("For order", color: Colors.TextMuted);
          foreach (var o in recent) {
            Button(o.Reference, onPress: () => Pick(o), size: Size.Sm);
          }
        }
      }
      if (App.Languages.Count > 1) {
        Row(gap: 2, align: Align.Center, wrap: Wrapping.Wrap, label: "Mail language") {
          Text("In", color: Colors.TextMuted);
          foreach (var l in App.Languages) {
            Button(l.ToUpper(), onPress: () => InLanguage(l), size: Size.Sm, tone: l == language ? Tone.Primary : Tone.Ghost);
          }
        }
      }
      if (html != "") {
        Text(subject, color: Colors.TextMuted);
        Frame(html, title: $"Preview: {subject}", h: 900, borderW: 1, border: Colors.Border, rounded: Radius.Md);
      }
    }
  }
}

[Composable]
[Authorize(IsShopStaff)]
public component DeskCampaigns() {
  live var campaigns = ShopCampaign.OrderByDescending(c => c.CreatedAt).ToList();
  string newSubject = "";

  action Create() {
    var id = NewShopCampaign(newSubject);
    newSubject = "";
    Write(ShopCampaign.Single(c => c.Id == id));
  }
  action Write(ShopCampaign c) { Dialog.Open(DeskCampaignEditor(campaign: c), unitOfWork: Root); }

  render {
    Stack(gap: 3) {
      Row(gap: 2, align: Align.End, wrap: Wrapping.Wrap) {
        Box(grow: 1, maxW: "28rem") { Field("Subject of a new newsletter", value: newSubject, onEnter: Create); }
        Button("New newsletter", onPress: Create, tone: Tone.Primary);
      }
      if (campaigns.Count == 0) { Text("No newsletters yet.", color: Colors.TextMuted); }
      foreach (var c in campaigns) {
        Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, label: c.Subject) {
          Stack(gap: 0, minW: "0") {
            Text(c.Subject);
            Text($"{c.State} · started {c.CreatedAt.ToString("d MMM")}", color: Colors.TextMuted, fontSize: FontSize.Label);
          }
          Button("Write", onPress: () => Write(c), size: Size.Sm);
        }
      }
    }
  }
}

/// One newsletter open for writing, over the desk. Its own unit of work: Save commits it (and a test or a send commits
/// it first, so what goes out is what is on screen); Close discards anything unsaved and closes.
[Authorize(IsShopStaff)]
public component DeskCampaignEditor(ShopCampaign campaign) {
  string testTo = "";
  string html = "";
  string refusal = "";
  string note = "";
  List<string> offered = [];
  List<ListInfo> lists = [];
  string sending = "";

  on mount { lists = DeclaredLists(); Refresh(); }

  action Refresh() {
    // The preview greets a reader with a first and a last name, so `{subscriber.firstname}` shows what it does.
    var mail = ShopCampaignPreview(campaign.Id, "Alex Reader");
    html = mail.Html;
    offered = mail.Placeholders;
    refusal = ShopCampaignRefusal(campaign);
  }
  action Saved(int updated, int created, int deleted) { Refresh(); }
  action Save() {
    UnitOfWork.Commit();
    Refresh();
    note = refusal == "" ? "Saved." : "";
  }
  action SendTest() {
    UnitOfWork.Commit();
    var why = SendShopCampaignTest(campaign.Id, testTo);
    Refresh();
    if (why != "") { refusal = why; note = ""; return; }
    note = $"A test is on its way to {testTo.Trim()} — it waits in the outbox, on the Mail tab.";
  }
  action Close() { Dialog.Discard(); }
  action AskSend(string key) { sending = key; note = ""; }
  action SendToList() {
    if (sending == "") { return; }
    UnitOfWork.Commit();
    var report = SendShopCampaign(campaign.Id, sending);
    sending = "";
    Refresh();
    if (report.Problem != "") { refusal = report.Problem; note = ""; return; }
    note = $"Sent to {report.Sent} {(report.Sent == 1 ? "reader" : "readers")} — each waits in the outbox, on the Mail tab."
      + (report.AlreadySent > 0 ? $" {report.AlreadySent} had it already." : "")
      + (report.Skipped > 0 ? $" {report.Skipped} not sent: not confirmed yet, or stopped." : "");
  }

  render {
    Box(w: "100%", h: "100%", bg: Colors.Scrim, overflowY: Overflow.Auto, p: 4) {
      Stack(role: UiRole.Dialog, label: "Newsletter", gap: 4, maxW: "1200px", mx: "auto", bg: Colors.Surface, color: Colors.OnSurface,
            rounded: Radius.Lg, shadow: Shadow.Deep, p: 5) {
        Row(gap: 4, align: Align.Start, wrap: Wrapping.Wrap) {
          Stack(gap: 2, w: "100%", maxW: "34rem") {
            Field("Subject", value: campaign.Subject);
            Field("Inbox line", value: campaign.Preview, hint: "What an inbox shows beside the subject.");
            Text("The newsletter — written in Markdown", fontWeight: FontWeight.Semibold);
            MarkdownEditor(ownerType: "ShopCampaign", ownerId: campaign.Id, property: "Body", density: compact, saved: Saved);
            Text("You can use: " + string.Join("  ", offered.Select(k => "{" + k + "}")), color: Colors.TextMuted,
                 fontSize: FontSize.Label);
            if (refusal != "") { Alert(refusal, tone: Tone.Danger); }
            if (note != "") { Alert(note, tone: Tone.Success); }
            Row(gap: 2, align: Align.End, wrap: Wrapping.Wrap) {
              Box(grow: 1) { Field("Send a test to", value: testTo, type: "email", placeholder: "you@yourshop.se", onEnter: SendTest); }
              Button("Send a test", onPress: SendTest, tone: Tone.Primary);
            }
            if (lists.Count > 0) {
              Stack(gap: 2, pt: 2, borderTW: 1, border: Colors.Border, label: "Send to a list") {
                if (sending == "") {
                  Row(gap: 2, wrap: Wrapping.Wrap) {
                    foreach (var l in lists) { Button($"Send to {l.Name}…", onPress: () => AskSend(l.Key)); }
                  }
                } else {
                  Text($"Send it to everyone confirmed on {lists.First(l => l.Key == sending).Name}? A reader it has reached already is not mailed again.");
                  Row(gap: 2) {
                    Button("Send it now", onPress: SendToList, tone: Tone.Primary);
                    Button("Not yet", onPress: () => AskSend(""), tone: Tone.Ghost);
                  }
                }
              }
            }
            Row(gap: 2) {
              Button("Save", onPress: Save);
              Button("Close", onPress: Close);
            }
          }
          Stack(gap: 2, grow: 1, minW: "20rem") {
            // The inbox row as a reader sees it — the inbox line is hidden inside the mail itself, so it shows here.
            Stack(gap: 0, p: 3, borderW: 1, border: Colors.Border, rounded: Radius.Md, label: "In the inbox") {
              Text(ShopSettings.Single().Name, fontWeight: FontWeight.Semibold);
              Row(gap: 2, minW: "0") {
                Text(campaign.Subject, fontWeight: FontWeight.Semibold, whiteSpace: "nowrap", shrink: 0);
                Text(campaign.Preview ?? "", color: Colors.TextMuted, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", minW: "0");
              }
            }
            Frame(html, title: $"Preview: {campaign.Subject}", h: 900, borderW: 1, border: Colors.Border, rounded: Radius.Md);
          }
        }
      }
    }
  }
}

/// The shop's own settings, edited in place — what a shop owner changes without a developer. A shop that has not been
/// set up yet has no settings row, and only staff may make one: here it is made, from the shop's name.
[Composable]
[Authorize(IsShopStaff)]
public component DeskSettings() {
  live var isSetUp = ShopSettings.Any();
  render {
    if (isSetUp) { DeskShopSettings(); } else { DeskFirstSettings(); }
  }
}

/// The first settings row — the shop's name; everything else is the settings' defaults until the desk changes it.
[Composable]
[Authorize(IsShopStaff)]
component DeskFirstSettings() {
  string name = "";
  string note = "";
  action SetUp() {
    if (name.Trim() == "") { note = "Give the shop a name."; return; }
    SetUpTheShop(name.Trim());
  }
  render {
    Stack(gap: 3, maxW: "640px") {
      Text("This shop has not been set up yet. Give it a name — everything else is set here once it has one.");
      Field("Shop name", value: name);
      Button("Set up the shop", onPress: SetUp, tone: Tone.Primary);
      if (note != "") { Text(note, color: Colors.TextMuted); }
    }
  }
}

[Composable]
[Authorize(IsShopStaff)]
component DeskShopSettings() {
  var shop = ShopSettings.Single();
  live var countries = VatCountry.OrderBy(v => v.Country).ToList();
  string note = "";
  List<string> cardWarnings = [];

  on mount { cardWarnings = GiftCardKindWarnings(); }
  action Save() { UnitOfWork.Commit(); note = "Saved."; cardWarnings = GiftCardKindWarnings(); }
  List<ProviderRow> providers = [];
  on mount { providers = Providers(); }
  action Offer(ProviderRow r) { OfferProvider(r.Kind, r.Key, !r.Offered); providers = Providers(); }
  action Move(ProviderRow r, int by) { MoveProvider(r.Kind, r.Key, by); providers = Providers(); }
  action LoadEuRates() { var added = SeedEuVatRates(); note = $"Added {added} countries' rates — check them against your tax authority's."; }

  render {
    Stack(gap: 4, maxW: "640px") {
      Field("Shop name", value: shop.Name);
      Field("Mail from", value: shop.MailFrom, placeholder: "Your Shop <orders@yourshop.se>",
            hint: "Mail goes out through Resend once this and the ResendApiKey secret are set.");
      Field("Contact email", value: shop.ContactEmail);
      Field("New orders to", value: shop.OrderAlertEmail, placeholder: "orders@yourshop.se", hint: "Mailed when an order is placed and when it is paid.");
      Field("Web address", value: shop.SiteUrl, placeholder: "https://yourshop.se", hint: "So mails can link back to the shop.");
      // What the checkout offers, and in what order — the providers are the app's; which of them run is the desk's.
      foreach (var kind in new List<string> { "payment", "delivery" }) {
        Stack(gap: 1) {
          SectionLabel(kind == "payment" ? "Ways to pay" : "Ways to deliver");
          foreach (var r in providers.Where(p => p.Kind == kind)) {
            Row(justify: Justify.Between, align: Align.Center, gap: 2, py: 1, borderTW: 1, border: Colors.Border, label: $"{kind} {r.Key}") {
              Stack(gap: 0) {
                Text(r.Label);
                if (!r.Ready) {
                  Text(r.NotReady != "" ? r.NotReady + " It is not offered." : "Not set up — its keys are missing, so it is not offered.",
                       color: Colors.TextMuted, fontSize: FontSize.Label);
                }
              }
              Row(gap: 1, align: Align.Center) {
                Button("↑", onPress: () => Move(r, -1), size: Size.Sm, tone: Tone.Ghost);
                Button("↓", onPress: () => Move(r, 1), size: Size.Sm, tone: Tone.Ghost);
                Button(r.Offered ? "Offered" : "Not offered", onPress: () => Offer(r), size: Size.Sm, tone: r.Offered ? Tone.Primary : Tone.Default);
              }
            }
          }
        }
      }
      DeskExchangeRates();
      SectionLabel("Money");
      DecimalField("VAT included in prices", value: shop.VatPercent, unit: "%", hint: "The standard rate.");
      DecimalField("Reduced VAT rate", value: shop.VatReducedPercent, unit: "%", hint: "For products classed Reduced — 12 in Sweden.");
      DecimalField("Lower VAT rate", value: shop.VatLowerPercent, unit: "%", hint: "For products classed Lower — 6 in Sweden."); 
      Field("Home country", value: shop.HomeCountry, placeholder: "SE", hint: "Where the shop is registered for VAT — two letters.");
      Checkbox("Show prices without VAT — for a shop whose customers are businesses", value: shop.PricesExcludeVat);
      Checkbox("Registered for the EU One-Stop Shop — charge each EU country's own VAT", value: shop.OssRegistered);
      if (shop.OssRegistered) {
        Stack(gap: 2) {
          SectionLabel("VAT by country");
          if (countries.Count == 0) { Text("No rates yet.", color: Colors.TextMuted); }
          foreach (var c in countries) {
            Row(gap: 2, align: Align.End, label: $"VAT {c.Country}") {
              Box(w: "48px") { Text(c.Country, fontWeight: FontWeight.Bold); }
              Box(w: "110px") { DecimalField("Standard", value: c.Standard, unit: "%"); }
              Box(w: "110px") { DecimalField("Reduced", value: c.Reduced, unit: "%"); }
              Box(w: "110px") { DecimalField("Lower", value: c.Lower, unit: "%"); }
            }
          }
          Row() { Button("Load the EU rates (January 2026)", onPress: LoadEuRates, size: Size.Sm); }
        }
      }
      Stack(gap: 1) {
        Checkbox("Gift cards are single-purpose vouchers — their VAT is paid when a card is sold, and none when it is spent", value: shop.GiftCardsAreSinglePurpose);
        Text("Only for a shop whose goods all carry one VAT rate and which sells in one country (VAT Directive, article 30a). Off: no VAT when a card is sold — what it pays for carries its own. A card keeps the kind it was sold as.",
             color: Colors.TextMuted, fontSize: FontSize.Label);
        foreach (var w in cardWarnings) { Alert(w, tone: Tone.Warning); }
      }
      DecimalField("Delivery fee", value: shop.DeliveryFee);
      DecimalField("Free delivery from", value: shop.FreeDeliveryFrom, hint: "Zero: never free.");
      TextAreaField("Bank details", value: shop.BankDetails, rows: 3);
      SectionLabel("On invoices");
      Field("Company number", value: shop.CompanyNumber, placeholder: "556677-8899");
      Field("EORI number", value: shop.Eori, placeholder: "SE5566778899", hint: "Needed to send parcels out of the EU.");
      Field("VAT number", value: shop.VatNumber, placeholder: "SE556677889901");
      TextAreaField("Registered address", value: shop.CompanyAddress, rows: 2);
      SectionLabel("Orders");
      NumberField("Days an unpaid order holds its goods", value: shop.HoldDays, min: 1, max: 30);
      NumberField("Days to return after sending", value: shop.ReturnDays, min: 14, max: 365, hint: "The EU floor is 14 days from delivery.");
      TextAreaField("Collection address", value: shop.CollectionAddress, rows: 2);
      SectionLabel("Your policies");
      TextAreaField("Terms of sale", value: shop.Terms, rows: 6, hint: "Paragraphs are separated by a blank line.");
      TextAreaField("Privacy notice", value: shop.Privacy, rows: 6);
      TextAreaField("Returns policy", value: shop.ReturnsPolicy, rows: 4, hint: "Empty: the shop says the return window from above.");
      Row(gap: 3, align: Align.Center) {
        Button("Save settings", onPress: Save, tone: Tone.Primary);
        if (note != "") { Text(note, color: Colors.TextMuted); }
      }
    }
  }
}

/// Prices in other currencies, on the desk's settings: which the app offers, the rates the job last wrote and their
/// date, what went wrong last time — and the way to start, fetch now, or stop. Nothing when the app lists no provider.
[Composable]
[Authorize(IsShopStaff)]
public component DeskExchangeRates() {
  RatesOnTheDesk? view = null;
  List<SoldOnTheDesk> sold = [];
  string note = "";
  // The sold currency being set up: its rounding, its free-delivery threshold, and a delivery option's own price.
  SoldOnTheDesk? editing = null;
  PriceRounding rounding = PriceRounding.To95;
  decimal freeFrom = 0;
  List<string> deliveryPrices = [];
  string problem = "";
  on mount { view = ExchangeRatesOnTheDesk(); sold = SoldCurrenciesOnTheDesk(); }
  action Sell(string code, bool yes) {
    problem = "";
    try {
      SellInCurrency(code, yes);
      sold = SoldCurrenciesOnTheDesk(); view = ExchangeRatesOnTheDesk();
      // Stopping a sale moves what was agreed in it: say where it went.
      note = yes ? "" : $"{code} is only shown now. Anything agreed in {code} moves to {view!.Own}: a subscription at today's rate, its subscriber told first; a gift card in {code} can be reissued in {view!.Own} on the Gift cards tab.";
    }
    catch (Exception ex) { problem = ex.Message; }
  }
  action Edit(SoldOnTheDesk s) {
    editing = s; rounding = s.Rounding; freeFrom = s.FreeDeliveryFrom; problem = "";
    deliveryPrices = s.Delivery.Select(d => d.Set).ToList();
  }
  action CloseEdit() { editing = null; }
  action SaveEdit() {
    problem = "";
    try {
      SetCurrencySale(editing!.Currency, rounding, freeFrom);
      for (var i = 0; i < editing!.Delivery.Count; i = i + 1) { SetSoldDeliveryPrice(editing!.Currency, editing!.Delivery[i].Id, deliveryPrices[i]); }
      editing = null; sold = SoldCurrenciesOnTheDesk();
    }
    catch (Exception ex) { problem = ex.Message; }
  }
  // Starts the job AND asks now: staff pressed a button and read the rates on the next line, while the job's own
  // first fetch runs on a clock after its commit (ExchangeRateRefresh).
  action Start() { note = FetchExchangeRatesNow(); view = ExchangeRatesOnTheDesk(); }
  action Fetch() { note = FetchExchangeRatesNow(); view = ExchangeRatesOnTheDesk(); if (note == "") { note = "Fetched."; } }
  action Stop() { StopExchangeRates(); view = ExchangeRatesOnTheDesk(); note = "Prices are shown in the shop's own currency only."; }

  render {
    if (view != null && view!.Listed) {
      Stack(gap: 2, label: "Prices in other currencies") {
        SectionLabel("Prices in other currencies");
        Text($"Visitors may see prices in {string.Join(", ", view!.Offered)} at the {view!.Source}'s rate. A currency the shop only SHOWS is an estimate, and the order is charged in {view!.Own}. One it SELLS in has real prices, and the order is placed, invoiced and charged in it; the books stay in {view!.Own}.",
             color: Colors.TextMuted, fontSize: FontSize.Label);
        foreach (var r in view!.Rates) {
          Row(justify: Justify.Between, align: Align.Center, gap: 2, py: 1, borderTW: 1, border: Colors.Border, label: $"rate {r.Currency}", wrap: Wrapping.Wrap) {
            Stack(gap: 0) {
              Text($"1 {view!.Own} = {r.PerUnit:0.####} {r.Currency}" + (r.Sold ? " · sold" : " · shown"));
              Text(r.Usable ? $"rate of {r.Date}" : (r.Date == "" ? "no rate yet" : $"stale, rate of {r.Date}"), color: r.Usable ? Colors.TextMuted : Colors.Danger,
                   fontSize: FontSize.Label);
            }
            Row(gap: 2) {
              if (!r.Sold) { Button($"Sell in {r.Currency}", onPress: () => Sell(r.Currency, true), size: Size.Sm); }
              if (r.Sold) {
                foreach (var s in sold.Where(x => x.Currency == r.Currency)) { Button("Prices and delivery…", onPress: () => Edit(s), size: Size.Sm); }
                Button("Only show it", onPress: () => Sell(r.Currency, false), size: Size.Sm, tone: Tone.Ghost);
              }
            }
          }
          foreach (var s in sold.Where(x => x.Currency == r.Currency)) {
            foreach (var n in s.NotOffered) { Text($"Not offered in {r.Currency} — {n}", color: Colors.TextMuted, fontSize: FontSize.Label); }
          }
        }
        if (problem != "") { Alert(problem, tone: Tone.Danger); }
        if (view!.Problem != "") { Text(view!.Problem, color: Colors.Danger, fontSize: FontSize.Label); }
        Row(gap: 2, align: Align.Center) {
          if (!view!.Running) { Button("Show prices in other currencies", onPress: Start, size: Size.Sm, tone: Tone.Primary); }
          if (view!.Running) {
            Button("Fetch the rates now", onPress: Fetch, size: Size.Sm);
            Button("Stop", onPress: Stop, size: Size.Sm, tone: Tone.Ghost);
          }
          if (note != "") { Text(note, color: Colors.TextMuted, fontSize: FontSize.Label); }
        }
      }
    }
    if (editing != null) {
      Dialog($"Selling in {editing!.Currency}", onDismiss: CloseEdit,
             subtitle: "A size with no price of its own in it is sold at its own price converted at the day's rate, rounded like this.") {
        Stack(gap: 4) {
          Dropdown("Rounding", value: rounding);
          DecimalField($"Free delivery from, in {editing!.Currency}", value: freeFrom,
                       hint: editing!.FreeDeliveryConverted > 0 ? $"0: from {editing!.FreeDeliveryConverted:0.##} {editing!.Currency}, the shop's own converted." : "0: never free.");
          SectionLabel($"Delivery in {editing!.Currency}");
          foreach (var at in Enumerable.Range(0, editing!.Delivery.Count)) {
            var line = editing!.Delivery[at];
            Field(line.Label, value: deliveryPrices[at], placeholder: $"{line.Converted:0.00}", hint: "Empty: its own price converted and rounded.");
          }
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: CloseEdit);
            Button("Save", onPress: SaveEdit, tone: Tone.Primary);
          }
        }
      }
    }
  }
}

/// The catalogue: every product with where it stands, a search, and the way in to a new one or an existing one.
[Composable]
[Authorize(IsShopStaff)]
public component DeskProducts() {
  live var shop = ShopSettings.FirstOrDefault();
  live var products = Product.OrderBy(p => p.Status).ThenBy(p => p.Name).ToList();
  live var allVariants = Variant.ToList();
  live var categories = Category.OrderBy(c => c.Name).ToList();
  string search = "";
  Product editing = null;
  bool creating = false;
  string newName = "";
  decimal newPrice = 0;
  Category newCategory = null;
  string problem = "";
  string exportLink = "";
  bool importing = false;
  string importPath = "";
  ProductImport? report = null;
  string importProblem = "";

  action Edit(Product p) { editing = p; }
  action Export() { exportLink = ProductsCsvLink(); }
  action AskImport() { importing = true; importPath = ""; report = null; importProblem = ""; }
  action CloseImport() { importing = false; }
  action Uploaded(UploadedFile f) {
    importPath = f.Path;
    try { report = ImportProductsFile(f.Path, false); importProblem = ""; }
    catch (Exception ex) { report = null; importProblem = ex.Message; }
  }
  action ApplyImport() {
    try { report = ImportProductsFile(importPath, true); importProblem = ""; }
    catch (Exception ex) { importProblem = ex.Message; }
  }
  action Back() { editing = null; }
  action AskNew() { creating = true; newName = ""; newPrice = 0; newCategory = null; problem = ""; }
  action Close() { creating = false; }
  action Create() {
    try { editing = CreateProduct(newName, newCategory, newPrice); creating = false; }
    catch (Exception ex) { problem = ex.Message; }
  }

  render {
    if (editing != null) {
      Stack(gap: 4) {
        Row() { Button("← All products", onPress: Back, size: Size.Sm); }
        DeskProductEditor(editing);
      }
    }
    if (editing == null) {
      Stack(gap: 1) {
        Row(gap: 2, align: Align.End, pb: 3) {
          Box(grow: 1) { Field("Search products", value: search); }
          Button("Export CSV", onPress: Export);
          Button("Import CSV…", onPress: AskImport);
          Button("New product…", onPress: AskNew, tone: Tone.Primary);
        }
        if (exportLink != "") {
          Row(gap: 2, pb: 2) { Link(href: exportLink, label: "Download the products as CSV") { Text("Download products.csv — every size, one row each", color: Colors.Primary); } }
        }
        foreach (var p in products.Where(x => search == "" || x.Name.ToLower().Contains(search.ToLower())).ToList()) {
          Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 2, borderTW: 1, border: Colors.Border, label: p.Name) {
            Stack(gap: 0, minW: "0") {
              Text(p.Name);
              Text($"{p.Status.Label} · {Money(p.Price, shop)} · {allVariants.Where(v => v.Product == p).Sum(v => v.Stock)} in stock",
                   color: Colors.TextMuted, fontSize: FontSize.Label);
            }
            Button("Edit", onPress: () => Edit(p), size: Size.Sm);
          }
        }
      }
    }
    if (importing) {
      Dialog("Import products", onDismiss: CloseImport,
             subtitle: "One row per size. A known SKU updates that size; an empty cell changes nothing; new products arrive as drafts.") {
        Stack(gap: 4) {
          Upload(accept: ".csv,text/csv", onUploaded: Uploaded) {
            Text(importPath == "" ? "Choose a CSV file…" : "Choose another file…", px: 4, py: 2, borderW: 1, border: Colors.Border,
                 rounded: Radius.Md, color: Colors.Primary);
          }
          if (importProblem != "") { Alert(importProblem, tone: Tone.Danger); }
          if (report != null) {
            Stack(gap: 1, label: "What the file changes") {
              Text(report!.Applied ? "Imported." : "Checked — nothing is written yet.", fontWeight: FontWeight.Semibold);
              Text($"{report!.NewProducts} new products · {report!.NewSizes} new sizes · {report!.Changed} changed · {report!.Unchanged} unchanged",
                   color: Colors.TextSecondary);
            }
            if (report!.Problems.Count > 0) {
              Alert($"{report!.Problems.Count} lines are refused, so nothing will be imported until they are fixed.", tone: Tone.Danger);
              Stack(gap: 1, label: "Refused lines") {
                foreach (var pr in report!.Problems.Take(20).ToList()) {
                  Text($"Line {pr.Line}: {pr.Message}", fontSize: FontSize.Label);
                }
              }
            }
          }
          Row(gap: 3, justify: Justify.End) {
            Button(report != null && report!.Applied ? "Close" : "Cancel", onPress: CloseImport);
            if (report != null && !report!.Applied && report!.Problems.Count == 0) {
              Button("Import", onPress: ApplyImport, tone: Tone.Primary);
            }
          }
        }
      }
    }
    if (creating) {
      Dialog("New product", onDismiss: Close, subtitle: "It starts as a draft — nobody sees it until you list it.") {
        Stack(gap: 4) {
          Field("Name", value: newName);
          Dropdown("Category", value: newCategory, options: categories, placeholder: "None") { c => Text(c.Name); }
          DecimalField("Price", value: newPrice);
          if (problem != "") { Alert(problem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: Close);
            Button("Create", onPress: Create, tone: Tone.Primary);
          }
        }
      }
    }
  }
}

/// One product: its words, its price and where it stands; its sizes and their stock; its photographs.
[Composable]
[Authorize(IsShopStaff)]
public component DeskProductEditor(Product product) {
  live var categories = Category.OrderBy(c => c.Name).ToList();
  live var variants = Variant.Where(v => v.Product == product).OrderBy(v => v.Rank).ToList();
  live var images = ProductImage.Where(i => i.Product == product).OrderBy(i => i.Rank).ToList();
  string name = product.Name;
  string slug = product.Slug;
  string brand = product.Brand ?? "";
  string summary = product.Summary ?? "";
  string description = product.Description ?? "";
  decimal price = product.Price;
  ProductStatus status = product.Status;
  VatClass vat = product.Vat;
  bool giftCard = product.IsGiftCard;
  Category category = product.Category;
  string hsCode = product.HsCode ?? "";
  string customsName = product.CustomsDescription ?? "";
  string origin = product.OriginCountry ?? "";
  string size = "";
  string colour = "";
  int stock = 1;
  int weight = 0;
  string note = "";
  bool failed = false;
  Variant? detailing = null;
  string vSku = "";
  string vBarcode = "";
  string vCost = "";
  string vProblem = "";
  // Its own price in each currency the shop sells in — "" is none: converted and rounded.
  live var soldIn = ExchangeRate.Where(r => r.Sold).OrderBy(r => r.Currency).ToList();
  live var listed = VariantPrice.Where(p => p.Variant.Product == product).ToList();
  List<string> vPrices = [];

  action Detail(Variant v) {
    detailing = v; vSku = v.Sku ?? ""; vBarcode = v.Barcode ?? ""; vCost = v.CostPrice == null ? "" : v.CostPrice!.Value.ToString("0.00"); vProblem = "";
    vPrices = soldIn.Select(r => listed.Where(p => p.Variant.Id == v.Id && p.Currency == r.Currency).Select(p => p.Price.ToString("0.00")).FirstOrDefault() ?? "").ToList();
  }
  action CloseDetail() { detailing = null; }
  action SaveDetail() {
    try {
      SetVariantDetails(detailing!, vSku, vBarcode, vCost);
      for (var i = 0; i < soldIn.Count; i = i + 1) { SetVariantPrice(detailing!, soldIn[i].Currency, vPrices[i]); }
      detailing = null;
    }
    catch (Exception ex) { vProblem = ex.Message; }
  }
  action Save() {
    try {
      UpdateProduct(product, name, brand, summary, description, price, status, category);
      SetProductSlug(product, slug);
      SetProductVat(product, vat);
      SetProductGiftCard(product, giftCard);
      SetProductCustoms(product, hsCode, customsName, origin);
      failed = false; note = "Saved.";
    }
    catch (Exception ex) { failed = true; note = ex.Message; }
  }
  action AddSize() {
    try { AddVariant(product, size, colour, stock, weight); size = ""; colour = ""; stock = 1; failed = false; note = ""; }
    catch (Exception ex) { failed = true; note = ex.Message; }
  }
  action AddPhoto(UploadedFile f) { AddProductPhoto(product, f.Path, ""); }
  action Earlier(ProductImage i) { MovePhoto(i, -1); }
  action Later(ProductImage i) { MovePhoto(i, 1); }
  action Remove(ProductImage i) { RemovePhoto(i); }

  render {
    Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(320px, 1fr))", gap: 8) {
      Stack(gap: 4) {
        SectionLabel("The product");
        Field("Name", value: name);
        Field("Web address", value: slug, hint: "Change it and the old address is sent on to the new one.");
        Field("Brand", value: brand);
        Dropdown("Category", value: category, options: categories, placeholder: "None") { c => Text(c.Name); }
        DecimalField("Price", value: price);
        Dropdown("VAT", value: vat);
        Checkbox("A gift card — each size is an amount, sold without VAT", value: giftCard);
        Dropdown("Status", value: status);
        Field("Summary", value: summary, hint: "One line, shown on the product's card.");
        TextAreaField("Description", value: description, rows: 6);
        // Only needed for a parcel leaving the EU — the carrier declares it with the booking.
        SectionLabel("For customs, outside the EU");
        Box(display: Display.Grid, cols: "repeat(auto-fit, minmax(140px, 1fr))", gap: 3) {
          Field("Tariff number (HS)", value: hsCode, placeholder: "640399");
          Field("What customs calls it", value: customsName, placeholder: "Leather shoes");
          Field("Made in", value: origin, placeholder: "IT");
        }
        if (note != "") { Alert(note, tone: failed ? Tone.Danger : Tone.Success); }
        Row() { Button("Save product", onPress: Save, tone: Tone.Primary); }
      }
      Stack(gap: 6) {
        Stack(gap: 2) {
          SectionLabel("Sizes and stock");
          if (variants.Count == 0) { Text("No sizes yet — add one before listing it.", color: Colors.TextMuted); }
          foreach (var v in variants) {
            Row(justify: Justify.Between, align: Align.Center, gap: 3, py: 1, borderTW: 1, border: Colors.Border) {
              Stack(gap: 0, minW: "0") {
                Text(VariantLabel(v) == "" ? "One size" : VariantLabel(v));
                Text(string.Join(" · ", new List<string> { v.Sku ?? "", v.Barcode ?? "", v.CostPrice == null ? "" : "cost " + Money(v.CostPrice!.Value, null) }
                       .Where(x => x != "").ToList()), color: Colors.TextMuted, fontSize: FontSize.Label);
              }
              Row(gap: 2, align: Align.Center) {
                Text(v.IsDownload || v.Unlimited ? "Never runs out" : v.WeightGrams > 0 ? $"{v.Stock} in stock · {v.WeightGrams} g" : $"{v.Stock} in stock",
                     color: Colors.TextMuted);
                Button("Details", onPress: () => Detail(v), size: Size.Sm);
              }
            }
            if (!giftCard) { DeskDownloadFile(v); }
          }
          Row(gap: 2, align: Align.End, wrap: Wrapping.Wrap, pt: 2) {
            Box(w: "90px") { Field("Size", value: size); }
            Box(w: "120px") { Field("Colour", value: colour); }
            Box(w: "90px") { NumberField("Stock", value: stock, min: 0); }
            Box(w: "110px") { NumberField("Weight (g)", value: weight, min: 0); }
            Button("Add size", onPress: AddSize);
          }
        }
        Stack(gap: 2) {
          SectionLabel("Photographs");
          Box(display: Display.Grid, cols: "repeat(auto-fill, minmax(120px, 1fr))", gap: 3) {
            foreach (var i in images) {
              Stack(gap: 1) {
                Image(src: File.Url(i.Path), alt: i.Alt ?? product.Name, aspectRatio: "3 / 4", objectFit: ObjectFit.Cover);
                Row(gap: 1, justify: Justify.Between) {
                  Button("←", onPress: () => Earlier(i), size: Size.Sm);
                  Button("Remove", onPress: () => Remove(i), size: Size.Sm);
                  Button("→", onPress: () => Later(i), size: Size.Sm);
                }
              }
            }
          }
          Upload(accept: "image/*", onUploaded: AddPhoto) {
            Text("Add a photograph…", px: 4, py: 2, borderW: 1, border: Colors.Border, rounded: Radius.Md, color: Colors.Primary);
          }
        }
      }
    }
    if (detailing != null) {
      Dialog(VariantLabel(detailing!) == "" ? "One size" : VariantLabel(detailing!), onDismiss: CloseDetail,
             subtitle: "The cost is the desk's alone — it gives the figures their margin.") {
        Stack(gap: 4) {
          Field("SKU", value: vSku);
          Field("Barcode (EAN / UPC)", value: vBarcode, hint: "The number under the bars — 8, 12 or 13 digits.");
          Field("Cost price, without VAT", value: vCost, hint: "Empty: no cost recorded.");
          foreach (var at in Enumerable.Range(0, soldIn.Count)) {
            var r = soldIn[at];
            Field($"Price in {r.Currency}", value: vPrices[at],
                  placeholder: $"{NicePrice((detailing!.Price ?? product.Price) * r.PerUnit, r.Rounding):0.00}",
                  hint: "Empty: its price converted at the day's rate and rounded.");
          }
          if (vProblem != "") { Alert(vProblem, tone: Tone.Danger); }
          Row(gap: 3, justify: Justify.End) {
            Button("Cancel", onPress: CloseDetail);
            Button("Save", onPress: SaveDetail, tone: Tone.Primary);
          }
        }
      }
    }
  }
}
