  // ── GiftCardKindWarnings ──
  /// GiftCardKindWarnings · message
  /// placeholders: {rates.Count} = rates.Count (int), {Join} = string.Join(…) (string) — {rates.Count} is a count: give one text per plural form
  /// shown through GiftCardKindWarnings()
  message "The goods on sale carry {rates.Count} VAT rates ({Join}). A card that may pay for any of them does not know its VAT when it is sold, so it is a multi-purpose voucher (VAT Directive, article 30a(3)): charging the standard rate on the sale over-pays the VAT on what is sold at a lower rate. Turn this off, or sell only goods at one rate." => { one: "Varorna till salu har {rates.Count} momssats ({Join}). Ett kort som kan betala för vilken som helst av dem vet inte sin moms när det säljs, så det är en flerfunktionsvoucher (mervärdesskattedirektivet, artikel 30a.3): att ta ut normalsatsen vid försäljningen betalar för mycket moms på det som säljs till en lägre sats. Stäng av det här, eller sälj bara varor med en momssats.", other: "Varorna till salu har {rates.Count} momssatser ({Join}). Ett kort som kan betala för vilken som helst av dem vet inte sin moms när det säljs, så det är en flerfunktionsvoucher (mervärdesskattedirektivet, artikel 30a.3): att ta ut normalsatsen vid försäljningen betalar för mycket moms på det som säljs till en lägre sats. Stäng av det här, eller sälj bara varor med en momssats." };
  /// GiftCardKindWarnings · message
  /// placeholders: {Join} = string.Join(…) (string)
  /// shown through GiftCardKindWarnings()
  message "The shop sells to other countries — {Join}. A card that may be spent by a customer abroad does not know whose VAT is due when it is sold, so it is a multi-purpose voucher (VAT Directive, article 30a(3)). Turn this off, or sell only at home." => "Butiken säljer till andra länder: {Join}. Ett kort som kan användas av en kund utomlands vet inte vems moms som ska betalas när det säljs, så det är en flerfunktionsvoucher (mervärdesskattedirektivet, artikel 30a.3). Stäng av det här, eller sälj bara inom landet.";
  /// GiftCardKindWarnings · message
  /// shown through GiftCardKindWarnings()
  message "it is registered for the One-Stop Shop, charging other EU countries' VAT" => "den är registrerad för en lokal kontaktpunkt (OSS) och tar ut andra EU-länders moms";
  /// GiftCardKindWarnings · message
  /// shown through GiftCardKindWarnings()
  message "it sells VAT-free to businesses in other EU countries" => "den säljer momsfritt till företag i andra EU-länder";
  /// GiftCardKindWarnings · message
  /// placeholders: {Join} = string.Join(…) (string)
  /// shown through GiftCardKindWarnings()
  message "it sent orders to {Join} this past year" => "den har skickat order till {Join} det senaste året";

