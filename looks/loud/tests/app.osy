// The producer's test project for Osysharp.Shop.Looks.Loud — a record shop — pressings bought and sold, wearing the look.
//
// ⭐ IT READS THE WORKING TREE: the repository's `osy.workspace` lists `kits/*`, so `use Osysharp.Shop.Looks.Loud`
//    resolves from the directory beside this one. ⛔ It does not ship — `tests` in ../package.osy is a setting, not a role.
app LoudLookTests {
  model "model/**/*.osy";
  tests "*.test.osy";
  use Osysharp.Shop@1 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Identity@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Payments@0;
  use Osysharp.Shipping@0;
  use Osysharp.Seo@0;
  use Osysharp.Blocks;
  use Osysharp.PageBuilder@0;
  use Osysharp.Site.Looks@0;
  use Osysharp.Shop.Looks.Loud@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
  use Osysharp.Storage;
}
