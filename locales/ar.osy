  // ── AdjustGiftCard ──
  /// AdjustGiftCard · an error message
  /// shown through Exception
  error "Say how much to add, or (below nothing) to take." => "حدّد المبلغ الذي يُضاف، أو (بقيمة سالبة) الذي يُخصم.";
  /// AdjustGiftCard · an error message
  /// shown through Exception
  /// also in VoidGiftCard
  /// also in ReplaceGiftCardCode
  error "Say why. It is kept with the card." => "اذكر السبب. سيُحفظ مع البطاقة.";
  /// AdjustGiftCard · an error message
  /// shown through Exception
  error "That card is a single-purpose voucher: its VAT was paid on what it was sold for, so nothing can be added to it. Issue a new card, or give store credit." => "هذه البطاقة قسيمة أحادية الغرض: دُفعت ضريبة القيمة المضافة عليها عند بيعها، فلا يمكن إضافة شيء إليها. أصدر بطاقة جديدة، أو امنح رصيدًا في المتجر.";
  /// AdjustGiftCard · an error message
  /// placeholders: {card.Status.Label} = card.Status.Label (string)
  /// shown through Exception
  error "That card is {card.Status.Label}." => "حالة هذه البطاقة: {card.Status.Label}.";
  /// AdjustGiftCard · an error message
  /// placeholders: {MoneyIn} = MoneyIn(…) (string)
  /// shown through Exception
  error "The card holds {MoneyIn} . Take no more than that." => "رصيد البطاقة {MoneyIn}. لا تخصم أكثر من ذلك.";

