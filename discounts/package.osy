// Osysharp.Shop.Discounts — discount codes for Osysharp.Shop, as an add-on: percent or amount off, or free delivery; a
// minimum spend, a start and an end, a limit in all and per customer. The shop finds it: an app's `use` line is all.
package Osysharp.Shop.Discounts {
  version     "0.4.0";
  minPlatform "0.9.0";
  summary     "discount codes for the shop — percent, amount or free delivery, with limits and dates.";
  model "model/**/*.osy";
  use Osysharp.Shop@0;
  use Osysharp.Ui;
  tests "tests";
}
