// The producer's test project for Osysharp.Shop.Agents — a small shop with the description writer listed, as a store
// lists it. No model is ever called: its one model is scripted by the tests.
app ShopAgentsKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.Shop.Agents@2;
  use Osysharp.Shop@1 { egress "api.resend.com"; secret "ResendApiKey"; }
  use Osysharp.Resend@0 { egress "api.resend.com"; }
  use Osysharp.Agents@2;
  use Osysharp.Agents.Testing@2;
  use Osysharp.Llm@2;
  use Osysharp.Identity@0;
  use Osysharp.UserAccounts@1;
  use Osysharp.Payments@0;
  use Osysharp.Shipping@0;
  use Osysharp.Seo@0;
  use Osysharp.Workflow;
  use Osysharp.Ui;
}
