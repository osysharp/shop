// Finding things: a search with a sort and a size filter, and the sale shelf. Written once, dressed by each store's
// theme; a store only says where its product pages live.

namespace Osysharp.Shop;

using Osysharp.Ui;
using Osysharp.Storage;
using Osysharp.Blocks;

/// One product as a listing shows it, with everything a card says already worked out — what `ShopSearchPage` hands a
/// store's own card (`slot card { c => … }`).
public class ShopCard {
  public Product Product;
  public string Name = "";
  /// Where its page is.
  public string Href = "";
  /// Its cover photograph's address — `Image(src: c.Photo, alt: c.PhotoAlt)` — or "" when it has none.
  public string Photo = "";
  /// What the photograph shows: the words staff gave it, or the product's name.
  public string PhotoAlt = "";
  /// What it costs now, as the shop writes money ("€120").
  public string Price = "";
  /// What it cost before its sale, or "" when it is not marked down.
  public string WasPrice = "";
  /// "excl. VAT" in a shop that shows prices so, else "".
  public string PriceNote = "";
  /// How many can be bought now; null when it never runs out.
  public int? Left;
  public bool SoldOut;
  /// "Sold out", "Only one left", "3 left" — or "" when there is plenty.
  public string Stock = "";
}

/// Search the listed products by name, brand or summary; narrow by size; order them. `productPrefix` is where a
/// store's product pages live ("/p/"), followed by the product's slug — or its id, when `linkById` says so.
/// `onlySale` makes it the sale shelf: only what is marked down. Each product is a card with its photograph, its
/// price and — when `showStockUnder` or fewer are left — how many ("3 left", "Only one left"); "Sold out" always
/// (`showStockUnder: 0` says nothing else).
///
/// ⚑ A STORE DRAWS ITS OWN CARD AND KEEPS THE REST — the search, the sizes, the sorting and the grid stay the kit's:
///
///     ShopSearchPage() {
///       slot card { c =>
///         Link(href: c.Href, label: c.Name) {
///           Stack(gap: 2) {
///             if (c.Photo != "") { Image(src: c.Photo, alt: c.PhotoAlt, aspectRatio: "1 / 1", objectFit: ObjectFit.Cover); }
///             Text(c.Name, fontWeight: FontWeight.Bold);
///             Text(c.Price);
///             if (c.Stock != "") { Badge(c.Stock); }
///           }
///         }
///       }
///     }
[Composable]
[AllowAnonymous]
public component ShopSearchPage(string productPrefix = "/p/", bool linkById = false, bool onlySale = false, int showStockUnder = 5) {
  live var shop = ShopSettings.FirstOrDefault();
  // The sales the reader may read that have not ended, and the date the site is looked at: a customer's is today and
  // they read only the sales that have started; a member of staff previewing the site as of a date sees that date's
  // sales and prices. An ended sale prices nothing, so it is not read.
  live var allSales = Sale.Where(s => s.State != SaleState.Ended).Take(1000).ToList();
  DateTime at = DateTime.UtcNow;
  on mount { at = SiteDate(); }
  string query = "";
  string size = "";
  ProductSort sort = ProductSort.Newest;
  live var onSale = allSales.Where(s => SaleOn(s, at)).Select(s => s.Product.Id).ToList();

  // THE SEARCH IS THE DATABASE'S: what was typed, the size and the sale shelf narrow the read itself, so a shop of ten
  // thousand pieces sends the two hundred newest that match — never the catalogue for the browser to sift.
  live var products = Product.Where(p => p.Status == ProductStatus.Listed
      && (!onlySale || onSale.Contains(p.Id))
      && (query == "" || p.Name.ToLower().Contains(query.ToLower())
          || (p.Brand != null && p.Brand.ToLower().Contains(query.ToLower()))
          || (p.Summary != null && p.Summary.ToLower().Contains(query.ToLower())))
      && (size == "" || p.Variants.Any(v => v.Size == size && v.Stock > 0)))
    .OrderByDescending(p => p.CreatedAt).Take(200).ToList();
  live var shownIds = products.Select(p => p.Id).ToList();
  live var variants = Variant.Where(v => shownIds.Contains(v.Product.Id)).ToList();
  live var covers = ProductImage.Where(i => i.Rank == 0 && shownIds.Contains(i.Product.Id)).ToList();

  // The sizes there is something in — none at all (a shop of one-offs) and the filter is not shown.
  live var sizes = Variant.Where(v => v.Product.Status == ProductStatus.Listed && v.Size != null && v.Stock > 0)
    .Select(v => v.Size!).Distinct().OrderBy(x => x).Take(100).ToList();

  action Clear() { query = ""; size = ""; sort = ProductSort.Newest; }
  action PickSize(string s) { size = size == s ? "" : s; }

  render {
    var sales = allSales.Where(s => SaleOn(s, at)).ToList();
    Stack(gap: 6, w: "100%") {
      if (!onlySale) {
        Field("Search", value: query, placeholder: "A name, a brand, a colour", type: "search");
      }
      if (!onlySale || sales.Count > 0) {
      Row(gap: 4, align: Align.End, wrap: Wrapping.Wrap) {
        Box(minW: "200px") { Dropdown("Sort by", value: sort); }
        if (sizes.Count > 0) {
          Stack(gap: 2) {
            Text("Size", fontSize: FontSize.Label, color: Colors.TextMuted);
            Row(gap: 2, wrap: Wrapping.Wrap, role: UiRole.Group, label: "Size") {
              foreach (var s in sizes) {
                Button(s, onPress: () => PickSize(s), size: Size.Sm, tone: size == s ? Tone.Primary : Tone.Default);
              }
            }
          }
        }
        if (query != "" || size != "" || sort != ProductSort.Newest) { Button("Clear", onPress: Clear, size: Size.Sm); }
      }
      }
      if (onlySale && sales.Count == 0) {
        EmptyState("Nothing is on sale right now", body: "Marked-down pieces appear here while their sale runs.");
      }
      // Two cards across on a phone, more as there is room.
      Box(display: Display.Grid, cols: "repeat(auto-fill, minmax(min(100%, 160px), 1fr))", gap: 5) {
        foreach (var p in products
            .OrderBy(p => sort == ProductSort.PriceLow ? PriceAt(p, allSales, at).Price : sort == ProductSort.PriceHigh ? -PriceAt(p, allSales, at).Price : 0)
            .ThenBy(p => sort == ProductSort.Name ? p.Name : "")
            .ToList()) {
          var price = PriceAt(p, allSales, at);
          var cover = covers.FirstOrDefault(c => c.Product == p);
          var mine = variants.Where(v => v.Product == p).ToArray();
          var card = new ShopCard {
            Product = p, Name = p.Name, Href = linkById ? productPrefix + p.Id.ToString() : productPrefix + p.Slug,
            Photo = cover == null ? "" : File.Url(cover.Path), PhotoAlt = cover == null || (cover.Alt ?? "") == "" ? p.Name : cover.Alt!,
            Price = Money(ShownPrice(price.Price, p.Vat, shop), shop),
            WasPrice = price.WasPrice == null ? "" : Money(ShownPrice(price.WasPrice.Value, p.Vat, shop), shop),
            PriceNote = PriceNote(shop), Left = LeftOf(mine), SoldOut = SoldOut(mine), Stock = StockNote(mine, showStockUnder),
          };
          // The store's own card when it gave one; otherwise this one.
          Slot("card", card) {
            Link(href: card.Href, label: card.Name) {
              Stack(gap: 2) {
                if (card.Photo != "") {
                  Image(src: card.Photo, alt: card.PhotoAlt, w: "100%", aspectRatio: "3 / 4", objectFit: ObjectFit.Cover, rounded: Radius.Md,
                        opacity: card.SoldOut ? "0.6" : "1");
                } else {
                  // No photograph yet: the same space, so the names and prices of a row stay in line.
                  Box(w: "100%", aspectRatio: "3 / 4", bg: Colors.Surface, rounded: Radius.Md);
                }
                Text(card.Name, fontWeight: FontWeight.Medium);
                Row(gap: 2, wrap: Wrapping.Wrap) {
                  Text(card.Price, color: card.WasPrice == "" ? Colors.TextMuted : Colors.Danger);
                  if (card.WasPrice != "") { Text(card.WasPrice, color: Colors.TextMuted, textDecoration: TextDecoration.LineThrough); }
                  if (card.PriceNote != "") { Text(card.PriceNote, color: Colors.TextMuted, fontSize: FontSize.Label); }
                }
                if (card.Stock != "") {
                  Text(card.Stock, fontSize: FontSize.Label, color: card.SoldOut ? Colors.TextMuted : Colors.Warning);
                }
              }
            }
          }
        }
      }
    }
  }
}

/// One of the shop's policies — "terms", "privacy" or "returns" — in the shop's own words, from its settings.
[Composable]
[AllowAnonymous]
public component ShopPolicy(string which) {
  live var shop = ShopSettings.FirstOrDefault();

  render {
    Stack(gap: 4, maxW: "720px") {
      PageTitle(which == "terms" ? "Terms of sale" : which == "privacy" ? "Privacy" : "Returns");
      if (shop != null) {
        foreach (var para in ((which == "terms" ? shop.Terms : which == "privacy" ? shop.Privacy : shop.ReturnsPolicy) ?? "")
            .Split("\n\n").Where(x => x.Trim() != "").ToList()) {
          Text(para.Trim(), whiteSpace: WhiteSpace.PreWrap, lineHeight: "1.6");
        }
        if (((which == "terms" ? shop.Terms : which == "privacy" ? shop.Privacy : shop.ReturnsPolicy) ?? "").Trim() == "") {
          Text(which == "returns"
            ? $"You may send back anything you bought within {shop.ReturnDays} days of it being sent. Sign in and return it from your orders."
            : "This shop has not written this page yet.", color: Colors.TextMuted);
        }
      }
    }
  }
}

/// The small print a store puts in its footer or under its checkout: links to its three policies.
[Composable]
[AllowAnonymous]
public component ShopPolicyLinks() {
  render {
    Row(gap: 5, wrap: Wrapping.Wrap) {
      TextLink("Search", to: "/search");
      TextLink("Terms", to: "/terms");
      TextLink("Privacy", to: "/privacy");
      TextLink("Returns", to: "/returns-policy");
    }
  }
}
