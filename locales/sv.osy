  message "A price, a cost, a stock count or a weight cannot be negative." => "Ett pris, en kostnad, ett lagersaldo eller en vikt kan inte vara negativ.";
  /// ImportRow · message
  /// shown through ImportRow()
  message "A product with no sizes cannot be listed." => "En produkt utan storlekar kan inte listas.";
  /// ImportRow · message
  /// placeholders: {barcode} = barcode (string)
  /// shown through ImportRow()
  message "Barcode {barcode} is already on another size." => "Streckkoden {barcode} finns redan på en annan storlek.";
  /// ImportRow · message
  /// placeholders: {barcode} = barcode (string)
  /// shown through ImportRow()
  message "Barcode {barcode} is not a valid EAN or UPC — a digit is wrong or missing." => "Streckkoden {barcode} är inte en giltig EAN eller UPC — en siffra är fel eller saknas.";
  /// ImportRow · message
  /// placeholders: {code} = code (string), {cell} = cell (string)
  /// shown through ImportRow()
  message "Price {code} \"{cell}\" is not a price — write one, or \"-\" to take it off." => "Pris {code} \"{cell}\" är inget pris. Skriv ett, eller \"-\" för att ta bort det.";
  /// ImportRow · message
  /// placeholders: {sku} = sku (string)
  /// shown through ImportRow()
  message "SKU {sku} is on an earlier line too." => "SKU {sku} finns på en tidigare rad också.";
  /// ImportRow · message
  /// placeholders: {statusText} = statusText (string)
  /// shown through ImportRow()
  message "Status \"{statusText}\" is not Draft, Listed or Archived." => "Statusen \"{statusText}\" är inte Draft, Listed eller Archived.";
  /// ImportRow · message
  /// placeholders: {Get} = t.Get(…) (string)
  /// shown through ImportRow()
  message "Stock \"{Get}\" is not a whole number." => "Lagersaldot \"{Get}\" är inte ett heltal.";
  /// ImportRow · message
  /// placeholders: {value} = … (int) — {value} is a count: give one text per plural form
  /// shown through ImportRow()
  message "Stock {value} is less than the other locations hold. Move it with a transfer, or count it at each location on the desk." => { one: "Lagret {value} är mindre än de andra platserna har. Flytta det, eller räkna det på varje plats i disken.", other: "Lagret {value} är mindre än de andra platserna har. Flytta det, eller räkna det på varje plats i disken." };
  /// ImportRow · message
  /// placeholders: {categoryName} = categoryName (string)
  /// shown through ImportRow()
  message "There is no category \"{categoryName}\" — make it on the desk first, or leave the cell empty." => "Det finns ingen kategori \"{categoryName}\" — skapa den på disken först, eller lämna cellen tom.";
  /// ImportRow · message
  /// placeholders: {sku} = sku (string)
  /// shown through ImportRow()
  message "There is no size with SKU {sku}, and no Product name to make one." => "Det finns ingen storlek med SKU {sku}, och inget produktnamn att skapa en med.";
  /// ImportRow · message
  /// placeholders: {col} = col (string), {Get} = t.Get(…) (string)
  /// shown through ImportRow()
  message "{col} \"{Get}\" is not a number." => "{col} \"{Get}\" är inte ett tal.";

  // ── IssueGiftCard ──
  /// IssueGiftCard · an error message
  /// shown through Exception
  /// also in GrantCredit
  error "Give an amount above nothing." => "Ange ett belopp större än noll.";
  /// IssueGiftCard · an error message
  /// shown through Exception
  error "Say who it goes to: an email address." => "Säg vem det ska till: en e-postadress.";
  /// IssueGiftCard · an error message
  /// shown through Exception
  error "Say why. It is kept with the card, for whoever reads it next." => "Säg varför. Det sparas med kortet, för den som läser det nästa gång.";
  /// IssueGiftCard · an error message
  /// shown through Exception
  error "That is more than the desk issues in one go." => "Det är mer än disken utfärdar på en gång.";

  // ── LimitCounter ──
  /// LimitCounter · an error message
  /// placeholders: {value} = … (string)
  /// shown through Exception
  error "{value} does not sell at the counter." => "{value} säljer inte i kassan.";

  // ── LimitPacker ──
  /// LimitPacker · an error message
  /// placeholders: {value} = … (string)
  /// shown through Exception
  error "{value} is not a packer." => "{value} är inte packare.";

  // ── LineProblem ──
  /// LineProblem · text on the page
  /// shown through LineProblem()
  text "No longer for sale." => "Säljs inte längre.";
  /// LineProblem · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {MoneyIn2} = MoneyIn(…) (string)
  /// shown through LineProblem()
  text "Now {MoneyIn} — down from {MoneyIn2}." => "Nu {MoneyIn}, sänkt från {MoneyIn2}.";
  /// LineProblem · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {MoneyIn2} = MoneyIn(…) (string)
  /// shown through LineProblem()
  text "Now {MoneyIn} — it was {MoneyIn2} when you added it." => "Nu {MoneyIn}. Det var {MoneyIn2} när du lade den i kassen.";
  /// LineProblem · text on the page
  /// placeholders: {MoneyIn} = MoneyIn(…) (string), {wasIn} = wasIn (string), {nowIn} = nowIn (string)
  /// shown through LineProblem()
  text "Now {MoneyIn} — the rate for {wasIn} is out of date, so the shop prices it in {nowIn} until it is fresh." => "Nu {MoneyIn}. Kursen för {wasIn} är inte aktuell, så butiken sätter pris i {nowIn} tills den är det.";
  /// LineProblem · text on the page
  /// shown through LineProblem()
  text "Only one is left." => "Bara en finns kvar.";
  /// LineProblem · text on the page
  /// placeholders: {have} = have (int) — {have} is a count: give one text per plural form
  /// shown through LineProblem()
  text "Only {have} are left." => { one: "Bara {have} finns kvar.", other: "Bara {have} finns kvar." };
  /// LineProblem · text on the page
  /// shown through LineProblem()
  text "Sold out since you added it." => "Slutsåld sedan du lade den i kassen.";

  // ── ListConfirmationMail ──
  /// ListConfirmationMail · a button's label · at most ~33 characters
  /// shown through EmailButton.label
  /// beside: "Please confirm your address", "The link works for seven days. If you did not ask, ignore this mail — you will not hear from us again."
  /// also in ShopListConfirmation
  button "Confirm my subscription" => "Bekräfta min prenumeration";
  /// ListConfirmationMail · an email's subject line
  /// placeholders: {list.Name} = list.Name (string)
  /// also in ShopListConfirmation
  mailSubject "Confirm your subscription to {list.Name}" => "Bekräfta din prenumeration på {list.Name}";
  /// ListConfirmationMail · text on the page
  /// shown through EmailHeading.text
  /// beside: "Confirm my subscription", "The link works for seven days. If you did not ask, ignore this mail — you will not hear from us again."
  /// also in ShopListConfirmation
  text "Please confirm your address" => "Bekräfta din adress";

  // ── LocationDoes ──
  /// LocationDoes · text on the page
  /// shown through LocationDoes()
  text "Hands orders over" => "Lämnar ut beställningar";
  /// LocationDoes · text on the page
  /// shown through LocationDoes()
  text "Keeps stock only" => "Bara lager";
  /// LocationDoes · text on the page
  /// shown through LocationDoes()
  text "Sends parcels" => "Skickar paket";
  /// LocationDoes · text on the page
  /// shown through LocationDoes()
  text "Sends parcels and hands orders over" => "Skickar paket och lämnar ut beställningar";

  // ── Mail ──
  /// Mail · an error message
  /// shown through Exception
  error "A picture in this mail is not one you can open, so the mail was not sent." => "En bild i det här mejlet går inte att öppna, så mejlet skickades inte.";
  /// Mail · an error message
  /// shown through ValidationException
  error "You are previewing the site, so no mail is sent — a mail now would say what the preview shows. Stop previewing, then try again." => "Du förhandsgranskar webbplatsen, så inget mejl skickas – ett mejl nu skulle säga det förhandsgranskningen visar. Sluta förhandsgranska och försök sedan igen.";

  // ── MailCounterReceipt ──
  /// MailCounterReceipt · text on the page
  /// placeholders: {order.Reference} = order.Reference (string)
  /// shown through MailFile.FileName
  text "receipt-{order.Reference}.pdf" => "kvitto-{order.Reference}.pdf";

  // ── MakeExchange ──
  /// MakeExchange · an error message
  /// shown through Exception
  error "That is what you have — choose another size, colour or product." => "Det är den du redan har. Välj en annan storlek, färg eller produkt.";
  /// MakeExchange · an error message
  /// shown through Exception
  error "The shop cannot send an exchange to you just now — write to us." => "Butiken kan inte skicka ett byte till dig just nu. Skriv till oss.";
  /// MakeExchange · an error message
  /// placeholders: {order.Currency} = order.Currency (string)
  /// shown through Exception
  error "The shop does not sell in {order.Currency} just now, so it cannot price an exchange for this order — return it for your money back." => "Butiken säljer inte i {order.Currency} just nu och kan inte prissätta ett byte för den här ordern. Returnera den och få pengarna tillbaka.";
  /// MakeExchange · an error message
  /// shown through Exception
  error "The shop takes no payment just now, so it cannot hold an exchange — write to us." => "Butiken tar inte emot betalningar just nu och kan därför inte hålla ett byte. Skriv till oss.";
  /// MakeExchange · an error message
  /// placeholders: {Buyable} = Buyable(…) (int), {VariantName} = VariantName(…) (string) — {Buyable} is a count: give one text per plural form
  /// shown through Exception
  error "There are only {Buyable} of {VariantName}." => { one: "Det finns bara {Buyable} av {VariantName}.", other: "Det finns bara {Buyable} av {VariantName}." };
  /// MakeExchange · an error message
  /// shown through Exception
  error "This order has no address to send an exchange to — write to the shop." => "Den här ordern har ingen adress att skicka ett byte till. Skriv till butiken.";
  /// MakeExchange · an error message
  /// placeholders: {VariantName} = VariantName(…) (string)
  /// shown through Exception
  error "{VariantName} has sold out — choose another." => "{VariantName} är slutsåld. Välj en annan.";
  /// MakeExchange · an error message
  /// placeholders: {VariantName} = VariantName(…) (string)
  /// shown through Exception
  error "{VariantName} went a moment before you — choose another, or return it for your money back." => "{VariantName} tog slut precis innan du hann. Välj en annan, eller returnera den och få pengarna tillbaka.";
  /// MakeExchange · an error message
  /// placeholders: {wanted.Product.Name} = wanted.Product.Name (string)
  /// shown through Exception
  error "{wanted.Product.Name} is not for sale." => "{wanted.Product.Name} säljs inte.";

  // ── MakeWholesale ──
  /// MakeWholesale · an error message
  /// shown through Exception
  error "The VAT register cannot be reached just now — try again shortly." => "Momsregistret går inte att nå just nu. Försök igen strax.";
  /// MakeWholesale · an error message
  /// shown through Exception
  error "The shop has no VAT register to check a number against (ShopSetup.VatNumbers)." => "Butiken har inget momsregister att kontrollera numret mot (ShopSetup.VatNumbers).";
  /// MakeWholesale · an error message
  /// shown through Exception
  error "Write the VAT number with its country prefix — SE556677889901." => "Skriv momsnumret med landsprefix, till exempel SE556677889901.";
  /// MakeWholesale · an error message
  /// placeholders: {cleaned} = cleaned (string)
  /// shown through Exception
  error "{cleaned} is not a valid VAT number in the register." => "{cleaned} är inte ett giltigt momsnummer i registret.";

  // ── MarkDelivered ──
