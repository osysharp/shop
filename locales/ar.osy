  placeholder "Six letters and digits" => "ستة حروف وأرقام";
  /// ShopCounter · text on the page
  /// placeholders: {ask.PriceList} = ask.PriceList (string)
  text "Buys on {ask.PriceList}" => "يشتري وفق {ask.PriceList}";
  /// ShopCounter · text on the page
  /// beside: "Slip number", "Paid"
  text "Charge it on the card terminal. When the terminal says approved, press Paid." => "حصّل المبلغ على جهاز الدفع بالبطاقة. وعندما يعرض الجهاز الموافقة، اضغط مدفوع.";
  /// ShopCounter · text on the page
  /// shown through SectionLabel.text
  text "Customer" => "العميل";
  /// ShopCounter · text on the page
  /// shown through EmptyState.body
  text "Each sale shows here as soon as it is paid or called off." => "تظهر كل عملية بيع هنا فور دفعها أو إلغائها.";
  /// ShopCounter · text on the page
  /// shown through Hint.text
  /// beside: "Their account's email"
  text "For their store credit or their trade prices. Without it, it is a sale like any other." => "لاستخدام رصيده في المتجر أو أسعار التجار الخاصة به. ومن دونه تكون عملية بيع كأي عملية أخرى.";
  /// ShopCounter · text on the page
  /// placeholders: {g.Last4} = g.Last4 (string), {Money} = Money(…) (string)
  /// beside: "Remove"
  text "Gift card …{g.Last4}, {Money}" => "بطاقة هدية …{g.Last4}، {Money}";
  /// ShopCounter · text on the page
  text "Gift cards" => "بطاقات الهدية";
  /// ShopCounter · text on the page
  /// shown through SectionLabel.text
  /// also in DeskNewOrder
  text "How they pay" => "طريقة الدفع";
  /// ShopCounter · text on the page
  /// placeholders: {ToUpper} = ….ToUpper(…) (string)
  /// shown through problem
  text "No sale here has the number {ToUpper}. A parcel goes back by post." => "لا توجد عملية بيع هنا بالرقم {ToUpper}. الطرد يُرجع بالبريد.";
  /// ShopCounter · text on the page
  text "Nothing more can come back" => "لا يمكن إرجاع المزيد";
  /// ShopCounter · text on the page
  /// placeholders: {s} = s (string)
  /// shown through problem
  text "Nothing on sale is called “{s}”." => "لا يوجد منتج معروض للبيع باسم “{s}”.";
  /// ShopCounter · text on the page
  /// placeholders: {Money} = Money(…) (string)
  text "Of which VAT {Money}" => "منها ضريبة القيمة المضافة {Money}";
  /// ShopCounter · text on the page
  /// beside: "Next sale"
  text "Paid. Hand it over." => "تم الدفع. سلّمه للعميل.";
  /// ShopCounter · text on the page
  text "Print the receipt" => "اطبع الإيصال";
  /// ShopCounter · text on the page
  /// placeholders: {placed.Reference} = placed.Reference (string)
  /// beside: "To pay"
  text "Sale {placed.Reference}" => "عملية البيع {placed.Reference}";
  /// ShopCounter · text on the page
  /// placeholders: {placed.Reference} = placed.Reference (string), {Money} = Money(…) (string)
  /// beside: "Paid. Hand it over.", "Next sale"
  text "Sale {placed.Reference} · {Money}" => "عملية البيع {placed.Reference} · {Money}";
  /// ShopCounter · text on the page
  /// shown through EmptyState.body
  text "Scan a barcode, or search by name." => "امسح باركودًا، أو ابحث بالاسم.";
  /// ShopCounter · text on the page
  /// also in ShopPayByLink
  text "Store credit" => "رصيد المتجر";
  /// ShopCounter · text on the page
  /// placeholders: {Money} = Money(…) (string)
  text "Store credit {Money}" => "رصيد المتجر {Money}";
  /// ShopCounter · text on the page
  /// placeholders: {sentTo} = sentTo (string)
  text "The receipt is on its way to {sentTo}." => "الإيصال في طريقه إلى {sentTo}.";
  /// ShopCounter · text on the page
  /// shown through notice
  text "The sale is called off, and its goods are back on the shelf." => "أُلغيت عملية البيع، وعادت سلعها إلى الرف.";
  /// ShopCounter · text on the page
  text "This moves on by itself once it is paid." => "ينتقل تلقائيًا إلى الخطوة التالية بعد الدفع.";
  /// ShopCounter · text on the page
  /// also in ShopPayByLink
  text "To pay" => "المستحق";
  /// ShopCounter · text on the page
  /// beside: "Call the sale off"
  text "Waiting for the payment." => "بانتظار الدفع.";
  /// ShopCounter · text on the page
  /// placeholders: {customerEmail} = customerEmail (string)
  /// beside: "Their code", "Sell without an account"
  text "We mailed a code to {customerEmail}. Ask them to read it out." => "أرسلنا رمزًا إلى {customerEmail}. اطلب منه قراءته.";
  /// ShopCounter · text on the page
  /// shown through SectionLabel.text
  text "Which counter are you at?" => "في أي نقطة بيع أنت؟";
  /// ShopCounter · text on the page
  /// placeholders: {Money} = Money(…) (string), {p.HereStock} = p.HereStock (int) — {p.HereStock} is a count: give one text per plural form
  text "{Money} · {p.HereStock} on the shelf" => { zero: "{Money} · {p.HereStock} قطعة على الرف", one: "{Money} · {p.HereStock} قطعة على الرف", two: "{Money} · {p.HereStock} قطعة على الرف", few: "{Money} · {p.HereStock} قطع على الرف", many: "{Money} · {p.HereStock} قطعة على الرف", other: "{Money} · {p.HereStock} قطعة على الرف" };
  /// ShopCounter · text on the page
  /// placeholders: {ScanIntoCounterSale} = ScanIntoCounterSale(…) (string)
  /// shown through notice
  text "{ScanIntoCounterSale} is in." => "تمت إضافة {ScanIntoCounterSale}.";
  /// ShopCounter · text on the page
  /// placeholders: {l.CanReturn} = l.CanReturn (int), {l.Bought} = l.Bought (int) — {l.CanReturn} is a count: give one text per plural form
  text "{l.CanReturn} of {l.Bought} can come back" => { zero: "يمكن إرجاع {l.CanReturn} من {l.Bought}", one: "يمكن إرجاع {l.CanReturn} من {l.Bought}", two: "يمكن إرجاع {l.CanReturn} من {l.Bought}", few: "يمكن إرجاع {l.CanReturn} من {l.Bought}", many: "يمكن إرجاع {l.CanReturn} من {l.Bought}", other: "يمكن إرجاع {l.CanReturn} من {l.Bought}" };
  /// ShopCounter · a title
  /// shown through EmptyState.title
  title "No sales yet today" => "لا مبيعات اليوم بعد";
  /// ShopCounter · a title
  /// shown through EmptyState.title
  title "Nothing rung up yet" => "لم يُسجَّل شيء بعد";

