  text "You may send back anything you bought within {shop.ReturnDays} days of it being sent. Sign in and return it from your orders." => { zero: "يمكنك إرجاع أي شيء اشتريته خلال {shop.ReturnDays} يوم من إرساله. سجّل الدخول وأرجعه من طلباتك.", one: "يمكنك إرجاع أي شيء اشتريته خلال {shop.ReturnDays} يوم من إرساله. سجّل الدخول وأرجعه من طلباتك.", two: "يمكنك إرجاع أي شيء اشتريته خلال {shop.ReturnDays} يوم من إرساله. سجّل الدخول وأرجعه من طلباتك.", few: "يمكنك إرجاع أي شيء اشتريته خلال {shop.ReturnDays} أيام من إرساله. سجّل الدخول وأرجعه من طلباتك.", many: "يمكنك إرجاع أي شيء اشتريته خلال {shop.ReturnDays} يومًا من إرساله. سجّل الدخول وأرجعه من طلباتك.", other: "يمكنك إرجاع أي شيء اشتريته خلال {shop.ReturnDays} يوم من إرساله. سجّل الدخول وأرجعه من طلباتك." };

