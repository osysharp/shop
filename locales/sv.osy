  // ── AdjustGiftCard ──
  /// AdjustGiftCard · an error message
  /// shown through Exception
  error "Say how much to add, or (below nothing) to take." => "Säg hur mycket som ska läggas till, eller (under noll) dras av.";
  /// AdjustGiftCard · an error message
  /// shown through Exception
  /// also in VoidGiftCard
  /// also in ReplaceGiftCardCode
  error "Say why. It is kept with the card." => "Säg varför. Det sparas med kortet.";
  /// AdjustGiftCard · an error message
  /// shown through Exception
  error "That card is a single-purpose voucher: its VAT was paid on what it was sold for, so nothing can be added to it. Issue a new card, or give store credit." => "Det kortet är en enfunktionsvoucher: momsen betalades på det belopp det såldes för, så inget kan läggas till. Utfärda ett nytt kort, eller ge tillgodohavande.";
  /// AdjustGiftCard · an error message
  /// placeholders: {card.Status.Label} = card.Status.Label (string)
  /// shown through Exception
  error "That card is {card.Status.Label}." => "Det kortet är {card.Status.Label}.";
  /// AdjustGiftCard · an error message
  /// placeholders: {MoneyIn} = MoneyIn(…) (string)
  /// shown through Exception
  error "The card holds {MoneyIn} . Take no more than that." => "Kortet har {MoneyIn} . Dra inte av mer än så.";

  // ── AdjustStockAt ──
  /// AdjustStockAt · an error message
  /// placeholders: {have} = have (int), {value} = … (int) — {have} is a count: give one text per plural form
