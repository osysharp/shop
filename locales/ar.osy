  text "{r.StatusText} · started {r.Started}" => "{r.StatusText} · بدأ {r.Started}";
  /// ShopOrderByLink · a title
  /// placeholders: {returning.Name} = returning.Name (string)
  /// shown through Dialog.title
  title "Return {returning.Name}" => "إرجاع {returning.Name}";

