  /// DeskLabels · text on the page
  /// placeholders: {packed.Count} = packed.Count (int) — {packed.Count} is a count: give one text per plural form
  /// shown through SectionLabel.text
  text "Packed, not yet sent — {packed.Count}" => { zero: "مغلّفة، لم تُرسل بعد: {packed.Count}", one: "مغلّفة، لم تُرسل بعد: {packed.Count}", two: "مغلّفة، لم تُرسل بعد: {packed.Count}", few: "مغلّفة، لم تُرسل بعد: {packed.Count}", many: "مغلّفة، لم تُرسل بعد: {packed.Count}", other: "مغلّفة، لم تُرسل بعد: {packed.Count}" };
