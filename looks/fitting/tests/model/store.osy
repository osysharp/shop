// The store: it wears the Fitting look, and serves the bag page the look takes a customer to (`appPage "/bag"`).
using Osysharp.Shop;
using Osysharp.Shop.Looks;
using Osysharp.Payments;
using Osysharp.Delivery;

app.Look = Fitting;

app.Auth = new PasswordAuth { LoginField = Email, PasswordField = PasswordHash };
app.AuthBootstrap = new AuthBootstrap {
  Role = ShopRole.Authenticator,
  Login = ShopLogin, Signup = ShopSignup,
  PasswordResetRequest = ShopRequestPasswordReset, PasswordReset = ShopResetPassword,
  PasswordChange = ShopChangePassword, EmailChange = ShopChangeEmail,
  EmailVerify = ShopConfirmEmail, EmailVerifyCode = ShopConfirmEmailCode,
};

app.Shop = new ShopSetup {
  Payments = [ new ManualPayment { Key = "banktransfer", Label = "Bank transfer", Instructions = "IBAN SE00" } ],
  Delivery = [ new CollectInStore { Address = "the workshop" } ],
};

/// Every page in the look's frame.
[Layout]
[AllowAnonymous]
component Store() {
  render { ShopFrame { Outlet; } }
}

[Route("/")]
[Layout(Store)]
[AllowAnonymous]
component Home() {
  render { Text("Suits, cut and altered"); }
}

/// The customer's account — the shop kit's panel, on the store's own page (the shop's `appPage "/account"`).
[Route("/account")]
[Layout(Store)]
component Account() {
  render { ShopAccountPanel(); }
}

/// The store's own bag page — the look sends a customer here, and the store decides what it is.
[Route("/bag")]
[Layout(Store)]
[AllowAnonymous]
component BagPage() {
  render { Text("Your bag — suits, cut and altered"); }
}
